 294          @parm uint32 | *green | Green feature function usage 1:enable 0:disable.
 295          @rvalue RT_ERR_OK | Success.
 296          @rvalue RT_ERR_SMI | SMI access error.
 297          @comm
 298              The API can set Green Ethernet function to reduce power consumption. While green feature is enabled, A
             -SIC will automatic
 299           detect the cable length and then select different power mode for best performance with minimums power con
             -sumption. Link down
 300           ports will enter power savining mode in 10 seconds after the cable disconnected if power saving function 
             -is enabled.
 301          */
 302          ret_t rtl8367c_getAsicGreenEthernet(uint32 port,uint32* green)
 303          {
 304   1          ret_t retVal;
 305   1          uint32 regData;
 306   1      
 307   1          /* 0xa436 = 0x8011 */
 308   1          if((retVal = rtl8367c_setAsicPHYOCPReg(port, 0xA436, 0x8011)) != RT_ERR_OK)
 309   1              return retVal;
 310   1      
 311   1          /* wr 0xa438[15] = 0: disable, 1: enable */
 312   1          if((retVal = rtl8367c_getAsicPHYOCPReg(port, 0xA438, &regData)) != RT_ERR_OK)
 313   1              return retVal;
 314   1      
 315   1          if(regData & 0x8000)
 316   1              *green = ENABLED;
 317   1          else
 318   1              *green = DISABLED;
 319   1      
 320   1          return RT_ERR_OK;
 321   1      }
