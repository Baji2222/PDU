 421          /*
 422          @func ret_t | rtl8367c_getAsicPowerSaving | Get power saving mode
 423          @parm uint32 | port | The port number
 424          @parm uint32* | enable | enable power saving mode.
 425          @rvalue RT_ERR_OK | Success.
 426          @rvalue RT_ERR_SMI | SMI access error. 
 427          @rvalue RT_ERR_PORT_ID | Invalid port number.
 428          @comm
 429              The API can get power saving mode per phy.
 430          */
 431          ret_t rtl8367c_getAsicPowerSaving(uint32 phy, uint32* enable)
 432          {
 433   1          rtk_api_ret_t retVal;
 434   1          uint32 phyData;
 435   1      
 436   1          if(NULL == enable)
 437   1              return RT_ERR_NULL_POINTER;
 438   1      
 439   1          if ((retVal = rtl8367c_getAsicPHYReg(phy,PHY_POWERSAVING_REG,&phyData))!=RT_ERR_OK)
 440   1              return retVal;
 441   1      
 442   1          if ((phyData & 0x0004) > 0)
 443   1              *enable = 1;
 444   1          else
 445   1              *enable = 0;
 446   1      
 447   1          return RT_ERR_OK;
 448   1      }
