                if(gpioPin > RTL8367C_ACLGPIOPINNO)
                  return RT_ERR_OUT_OF_RANGE;
              
                  return rtl8367c_getAsicRegBit(RTL8367C_REG_ACL_GPIO, gpioPin, pGpioEn);
