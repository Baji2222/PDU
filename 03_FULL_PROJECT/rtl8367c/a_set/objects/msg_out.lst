 180          /*
 181           * Function: snmp_send_response
 182           * ----------------------------
 183           * Sends SNMP response message to request originator.
 184           * Performs two-pass encoding: pass 0 calculates lengths, pass 1 encodes.
 185           * Handles tooBig errors by retrying with empty varbind list.
 186           */
 187          err_t
 188          snmp_send_response(struct snmp_msg_pstat *m_stat)
 189          {
 190   1        struct snmp_varbind_root  emptyvb = {NULL, NULL, 0, 0, 0};
 191   1        int32  socketId;
