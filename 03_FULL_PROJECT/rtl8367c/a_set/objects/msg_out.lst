 193   1        u16_t  tot_len;
 194   1        err_t  err;
 195   1        u16_t retval;
 196   1      
 197   1        DBG_SNMP_PRINTF(("[%s][%d][m_stat->error_status=0x%04x]\n", \
 198   1            __FILE__, (uint16)__LINE__, (uint16)m_stat->error_status));
 199   1        /* pass 0, calculate length fields */
 200   1        tot_len = snmp_varbind_list_sum(&m_stat->outvb);
 201   1        tot_len = snmp_resp_header_sum(m_stat, tot_len);
 202   1       /* try allocating pbuf(s) for complete response */
 203   1        p = malloc_tx_buf(1518UL);
 204   1        
 205   1        if (p == NULL)
 206   1        {
 207   2          DBG_SNMP_PRINTF(("snmp_snd_response() tooBig\n"));
 208   2      
 209   2          /* can't construct reply, return error-status tooBig */
 210   2          m_stat->error_status = SNMP_ES_TOOBIG;
 211   2          m_stat->error_index = 0;
 212   2          /* pass 0, recalculate lengths, for empty varbind-list */
 213   2          tot_len = snmp_varbind_list_sum(&emptyvb);
 214   2          tot_len = snmp_resp_header_sum(m_stat, tot_len);
 215   2          /* retry allocation once for header and empty varbind-list */
 216   2        }
 217   1        if (p != NULL)
 218   1        {
 219   2          /* first pbuf alloc try or retry alloc success */
 220   2          u16_t ofs;
 221   2      
 222   2          /* pass 1, size error, encode packet ino the pbuf(s) */
 223   2        DBG_SNMP_PRINTF(("[%s][%d]\n", __FILE__, (uint16)__LINE__));
 224   2          ofs = snmp_resp_header_enc(m_stat, p);
 225   2          if (m_stat->error_status == SNMP_ES_TOOBIG)
 226   2          {
 227   3            snmp_varbind_list_enc(&emptyvb, p, ofs);
 228   3          }
 229   2          else
 230   2          {
 231   3            DBG_SNMP_PRINTF(("[%s][%d][m_stat->error_status=0x%04x]\n", \
 232   3            __FILE__, (uint16)__LINE__, (uint16)m_stat->error_status));
 233   3          
 234   3            retval = snmp_varbind_list_enc(&m_stat->outvb, p, ofs);
 235   3          }
 236   2        /** @todo do we need separate rx and tx pcbs for threaded case? */
 237   2          /** connect to the originating source */
