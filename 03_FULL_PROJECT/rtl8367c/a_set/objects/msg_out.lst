 334          /**
 335           * Sums varbind lengths from tail to head and
 336           * annotates lengths in varbind for second encoding pass.
 337           *
 338           * @param root points to the root of the variable binding list
 339           * @return the required lenght for encoding the variable bindings
 340           */
 341          /*
 342           * Function: snmp_varbind_list_sum
 343           * -------------------------------
 344           * Calculates total length for varbind list encoding.
 345           * Iterates through list from tail to head computing lengths.
 346           * Stores individual varbind lengths for second pass.
 347           */
 348          static u16_t
 349          snmp_varbind_list_sum(struct snmp_varbind_root *root) large
 350          {
 351   1        struct snmp_varbind *vb;
 352   1        u32_t *uint_ptr;
 353   1        s32_t *sint_ptr;
 354   1        u16_t tot_len;
 355   1      
 356   1        DBG_SNMP_PRINTF(("[%s][%d]\n", __FILE__, (uint16)__LINE__));
 357   1      
 358   1        tot_len = 0;
 359   1        vb = root->tail;
 360   1        while ( vb != NULL )
 361   1        {
C51 COMPILER V9.60.0.0   MSG_OUT                                                           11/03/2026 14:16:07 PAGE 7   

 362   2          /* encoded value lenght depends on type */
 363   2          switch (vb->value_type)
 364   2          {
 365   3            case (SNMP_ASN1_UNIV | SNMP_ASN1_PRIMIT | SNMP_ASN1_INTEG):
 366   3              sint_ptr = vb->value;
 367   3              snmp_asn1_enc_s32t_cnt(*sint_ptr, &vb->vlen);
 368   3              break;
 369   3          case (SNMP_ASN1_APPLIC | SNMP_ASN1_PRIMIT | SNMP_ASN1_COUNTER64):
 370   3            /*TODO:  counter64 decode support. Currently, we just change it to COUNT32 */
 371   3            uint_ptr = vb->value;
 372   3          snmp_asn1_enc_u64t_cnt(uint_ptr, &vb->vlen);
 373   3          break;
 374   3            case (SNMP_ASN1_APPLIC | SNMP_ASN1_PRIMIT | SNMP_ASN1_COUNTER):
 375   3            case (SNMP_ASN1_APPLIC | SNMP_ASN1_PRIMIT | SNMP_ASN1_GAUGE):
 376   3            case (SNMP_ASN1_APPLIC | SNMP_ASN1_PRIMIT | SNMP_ASN1_TIMETICKS):
 377   3              uint_ptr = vb->value;
 378   3              snmp_asn1_enc_u32t_cnt(*uint_ptr, &vb->vlen);
 379   3              break;
 380   3            case (SNMP_ASN1_UNIV | SNMP_ASN1_PRIMIT | SNMP_ASN1_OC_STR):
 381   3            case (SNMP_ASN1_UNIV | SNMP_ASN1_PRIMIT | SNMP_ASN1_NUL):
 382   3            case (SNMP_ASN1_APPLIC | SNMP_ASN1_PRIMIT | SNMP_ASN1_IPADDR):
 383   3            case (SNMP_ASN1_APPLIC | SNMP_ASN1_PRIMIT | SNMP_ASN1_OPAQUE):
 384   3              vb->vlen = vb->value_len;
 385   3              break;
 386   3            case (SNMP_ASN1_UNIV | SNMP_ASN1_PRIMIT | SNMP_ASN1_OBJ_ID):
 387   3              sint_ptr = vb->value;
 388   3              snmp_asn1_enc_oid_cnt(vb->value_len / sizeof(s32_t), sint_ptr, &vb->vlen);
 389   3              break;
 390   3            default:
 391   3              /* unsupported type */
 392   3              vb->vlen = 0;
 393   3              break;
 394   3          };
 395   2          /* encoding length of value length field */
 396   2          snmp_asn1_enc_length_cnt(vb->vlen, &vb->vlenlen);
 397   2          snmp_asn1_enc_oid_cnt(vb->ident_len, vb->ident, &vb->olen);
 398   2          snmp_asn1_enc_length_cnt(vb->olen, &vb->olenlen);
 399   2      
 400   2          vb->seqlen = 1 + vb->vlenlen + vb->vlen;
 401   2          vb->seqlen += 1 + vb->olenlen + vb->olen;
 402   2          snmp_asn1_enc_length_cnt(vb->seqlen, &vb->seqlenlen);
 403   2      
 404   2          /* varbind seq */
 405   2          tot_len += 1 + vb->seqlenlen + vb->seqlen;
 406   2      
 407   2          vb = vb->prev;
 408   2        }
 409   1      
 410   1        /* varbind-list seq */
 411   1        root->seqlen = tot_len;
 412   1        snmp_asn1_enc_length_cnt(root->seqlen, &root->seqlenlen);
 413   1        tot_len += 1 + root->seqlenlen;
 414   1      
 415   1        return tot_len;
 416   1      }
