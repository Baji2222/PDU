1231   2      #endif
1232   2          for (i = 0; i < INTERFACE_NUMBER; i++) {
1233   3            if (snmp_new_linkdown_pm & (1UL << i)) {
1234   4              snmp_get_sysuptime(&(linkChangeTime[i]));
1235   4            }
1236   3          }
