 418          /**
 419           * Encodes response header from head to tail.
 420           */
 421          /*
 422           * Function: snmp_resp_header_enc
 423           * ------------------------------
C51 COMPILER V9.60.0.0   MSG_OUT                                                           11/03/2026 14:16:07 PAGE 8   

 424           * Encodes SNMP response header into buffer.
 425           * Writes version, community, PDU type, request ID, error status/index.
 426           * Returns updated offset after header encoding.
 427           */
 428          static u16_t
 429          snmp_resp_header_enc(struct snmp_msg_pstat *m_stat, u8_t *p)
 430          {
 431   1        u16_t ofs;
 432   1      
 433   1        ofs = 0;
 434   1        snmp_asn1_enc_type(p, ofs, (SNMP_ASN1_UNIV | SNMP_ASN1_CONSTR | SNMP_ASN1_SEQ));
 435   1        ofs += 1;
 436   1        snmp_asn1_enc_length(p, ofs, m_stat->rhl.seqlen);
 437   1        ofs += m_stat->rhl.seqlenlen;
 438   1      
 439   1        snmp_asn1_enc_type(p, ofs, (SNMP_ASN1_UNIV | SNMP_ASN1_PRIMIT | SNMP_ASN1_INTEG));
 440   1        ofs += 1;
 441   1        snmp_asn1_enc_length(p, ofs, m_stat->rhl.verlen);
 442   1        ofs += m_stat->rhl.verlenlen;
 443   1        snmp_asn1_enc_s32t(p, ofs, m_stat->rhl.verlen, snmp_version);
 444   1        ofs += m_stat->rhl.verlen;
 445   1      
 446   1        snmp_asn1_enc_type(p, ofs, (SNMP_ASN1_UNIV | SNMP_ASN1_PRIMIT | SNMP_ASN1_OC_STR));
 447   1        ofs += 1;
 448   1        snmp_asn1_enc_length(p, ofs, m_stat->rhl.comlen);
