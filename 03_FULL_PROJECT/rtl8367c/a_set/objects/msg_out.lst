 280          /**
 281           * Sums response header field lengths from tail to head and
 282           * returns resp_header_lengths for second encoding pass.
 283           *
 284           * @param vb_len varbind-list length
 285           * @param rhl points to returned header lengths
 286           * @return the required lenght for encoding the response header
 287           */
 288          /*
 289           * Function: snmp_resp_header_sum
 290           * ------------------------------
 291           * Calculates total length for SNMP response header.
 292           * Sums lengths of version, community, PDU header, and varbind list.
 293           * Stores individual lengths in response header structure.
 294           */
 295          static u16_t
 296          snmp_resp_header_sum(struct snmp_msg_pstat *m_stat, u16_t vb_len)
 297          {
 298   1        u16_t tot_len;
 299   1        struct snmp_resp_header_lengths *rhl;
C51 COMPILER V9.60.0.0   MSG_OUT                                                           11/03/2026 14:16:07 PAGE 6   

 300   1      
 301   1        rhl = &m_stat->rhl;
 302   1        tot_len = vb_len;
 303   1        snmp_asn1_enc_s32t_cnt(m_stat->error_index, &rhl->erridxlen);
 304   1        snmp_asn1_enc_length_cnt(rhl->erridxlen, &rhl->erridxlenlen);
 305   1        tot_len += 1 + rhl->erridxlenlen + rhl->erridxlen;
 306   1      
 307   1        snmp_asn1_enc_s32t_cnt(m_stat->error_status, &rhl->errstatlen);
 308   1        snmp_asn1_enc_length_cnt(rhl->errstatlen, &rhl->errstatlenlen);
 309   1        tot_len += 1 + rhl->errstatlenlen + rhl->errstatlen;
 310   1      
 311   1        snmp_asn1_enc_s32t_cnt(m_stat->rid, &rhl->ridlen);
 312   1        snmp_asn1_enc_length_cnt(rhl->ridlen, &rhl->ridlenlen);
 313   1        tot_len += 1 + rhl->ridlenlen + rhl->ridlen;
 314   1      
 315   1        rhl->pdulen = tot_len;
 316   1        snmp_asn1_enc_length_cnt(rhl->pdulen, &rhl->pdulenlen);
 317   1        tot_len += 1 + rhl->pdulenlen;
 318   1      
 319   1        rhl->comlen = m_stat->com_strlen;
 320   1        snmp_asn1_enc_length_cnt(rhl->comlen, &rhl->comlenlen);
 321   1        tot_len += 1 + rhl->comlenlen + rhl->comlen;
 322   1      
 323   1        snmp_asn1_enc_s32t_cnt(snmp_version, &rhl->verlen);
 324   1        snmp_asn1_enc_length_cnt(rhl->verlen, &rhl->verlenlen);
 325   1        tot_len += 1 + rhl->verlen + rhl->verlenlen;
 326   1      
 327   1        rhl->seqlen = tot_len;
 328   1        snmp_asn1_enc_length_cnt(rhl->seqlen, &rhl->seqlenlen);
 329   1        tot_len += 1 + rhl->seqlenlen;
 330   1      
 331   1        return tot_len;
 332   1      }
