1257          /*
1258           * Function: extract_a_value
1259           * -------------------------
1260           * Extracts AC status value from JSON string.
1261           * Searches for "A": pattern and returns integer value.
1262           * Returns -1 if key not found or value invalid.
1263           */
1264          u8_t extract_a_value(const char *json_str) {
1265   1          u8_t value = 0;
1266   1          const char *key = "\"A\":";
1267   1          char *key_pos = strstr(json_str, key);
1268   1          if (key_pos == NULL) {
1269   2              return -1; // Key not found
1270   2          }
1271   1      
1272   1          key_pos += strlen(key);
1273   1          while (*key_pos == ' ' || *key_pos == '\t') {
1274   2              key_pos++;
1275   2          }
1276   1      
1277   1          if (*key_pos >= '0' && *key_pos <= '9') {
1278   2              char buffer[3] = {0}; // Buffer to store the number
1279   2              int i = 0;
1280   2              // Copy digits until a non-digit is encountered
1281   2              while (*key_pos >= '0' && *key_pos <= '9' && i < sizeof(buffer) - 1) {
1282   3                  buffer[i++] = *key_pos++;
1283   3              }
1284   2              buffer[i] = '\0'; // Null-terminate the string
1285   2              value = atoi(buffer);
1286   2      
1287   2          } else {
1288   2              return -1; // Invalid value
1289   2          }
C51 COMPILER V9.60.0.0   MSG_OUT                                                           11/03/2026 14:16:07 PAGE 22  

1290   1      
1291   1          return value;
1292   1      }
