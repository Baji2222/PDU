 130          // The fixed function from earlier
 131          /*
 132           * Function: extract_c_value
 133           * -------------------------
 134           * Extracts battery percentage value from JSON string.
 135           * Searches for "C": pattern and returns integer value.
 136           * Returns -1 if key not found or value invalid.
 137           */
 138          u8_t extract_c_value(const char *json_str) {
 139   1          u8_t value = 0;
 140   1          const char *key = "\"C\":";
 141   1          char *key_pos = strstr(json_str, key);
 142   1          if (key_pos == NULL) {
 143   2              return -1; // Key not found
 144   2          }
 145   1      
 146   1          key_pos += strlen(key);
 147   1          while (*key_pos == ' ' || *key_pos == '\t') {
 148   2              key_pos++;
 149   2          }
 150   1      
 151   1          if (*key_pos >= '0' && *key_pos <= '9') {
 152   2              
 153   2              int i = 0;
 154   2              // Copy digits until a non-digit is encountered
 155   2              while (*key_pos >= '0' && *key_pos <= '9' && i < sizeof(bufferC) - 1) {
 156   3                  bufferC[i++] = *key_pos++;
 157   3              }
 158   2              bufferC[i] = '\0'; // Null-terminate the string
 159   2              printf("battery Percentage: %s\r\n",bufferC);
 160   2              value = atoi(bufferC);
 161   2          } else {
 162   2              return -1; // Invalid value
 163   2          }
 164   1      
 165   1          return value;
 166   1      }
