 175          /* Function Name:
 176           *      rtl8367c_setAsicAcl
 177           * Description:
 178           *      Set port acl function enable/disable
 179           * Input:
 180           *      port    - Physical port number (0~10)
 181           *      enabled - 1: enabled, 0: disabled
 182           * Output:
 183           *      None
 184           * Return:
 185           *      RT_ERR_OK       - Success
 186           *      RT_ERR_SMI      - SMI access error
 187           *      RT_ERR_PORT_ID  - Invalid port number
 188           * Note:
 189           *      None
 190           */
 191          ret_t rtl8367c_setAsicAcl(uint32 port, uint32 enabled)
 192          {
 193   1          if(port > RTL8367C_PORTIDMAX)
 194   1              return RT_ERR_PORT_ID;
 195   1      
 196   1          return rtl8367c_setAsicRegBit(RTL8367C_ACL_ENABLE_REG, port, enabled);
 197   1      }
