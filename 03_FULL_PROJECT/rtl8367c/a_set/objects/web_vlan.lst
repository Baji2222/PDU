  43          /*
  44           * Function: replace_ports
  45           * -----------------------
  46           * Replaces port numbers in VLAN display strings (3->1, 4->2).
  47           * Handles port range patterns like "3-4" -> "1-2".
  48           * Used to normalize VLAN display for consistent UI.
  49           * Modifies string in-place, skips if string is "-".
  50           */
  51          void replace_ports(char *str) {
C51 COMPILER V9.60.0.0   WEB_VLAN                                                          11/02/2026 17:57:38 PAGE 2   

  52   1        
  53   1        char temp[64];
  54   1          char *src = str;
  55   1          char *dst = temp;
  56   1          if (strcmp(str, "-") == 0) {
  57   2              // leave as is
  58   2              return;
  59   2          }
  60   1      
  61   1          while (*src) {
  62   2              if (strncmp(src, "3-4", 3) == 0) {
  63   3                  strcpy(dst, "1-2");
  64   3                  dst += 3;
  65   3                  src += 3;
  66   3              } else if (strncmp(src, "1-5", 3) == 0) {
  67   3                  strcpy(dst, "1-2");
  68   3                  dst += 3;
  69   3                  src += 3;
  70   3              } else if (*src == '3') {
  71   3                  *dst++ = '1';
  72   3                  src++;
  73   3              } else if (*src == '4') {
  74   3                  *dst++ = '2';
  75   3                  src++;
  76   3              } else {
  77   3                  *dst++ = *src++;
  78   3              }
  79   2          }
  80   1      
  81   1          *dst = '\0';
  82   1          strcpy(str, temp);
  83   1      }
