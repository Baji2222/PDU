 422          /*
 423           * Function: get_image
C51 COMPILER V9.60.0.0   WEB_IMAGE                                                         11/03/2026 14:15:59 PAGE 8   

 424           * -------------------
 425           * Serves static image files (PNG/GIF) to HTTP clients.
 426           * Determines image type from image_idx and sends appropriate content.
 427           * Sets Content-Type and Content-Length headers for each image.
 428           * Supports logo, RJ45 status icons, folder icons, and navigation icons.
 429           */
 430          int8 get_image(struct http_request_s *pReq, int32 image_idx)
 431          {
 432   1          uint8 buf[32];
 433   1      
 434   1          if ((image_idx <= WEB_IMAGE_NONE) || (image_idx >= WEB_IMAGE_MAX))
 435   1              return FAILED;
 436   1      
 437   1          WEB_BEGIN(pReq);
 438   1      
 439   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
 440   1      
 441   1          switch (image_idx)
 442   1          {
 443   2          case WEB_IMAGE_LOGO_PNG:
 444   2              WEB_HEADER(pReq, "Content-Type: image/png");
 445   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(png_logo));
 446   2              WEB_HEADER(pReq, buf);
 447   2              WEB_DATA(pReq, png_logo, sizeof(png_logo));
 448   2              break;
 449   2          case WEB_IMAGE_RJ45_DOWN_0_PNG:
 450   2              WEB_HEADER(pReq, "Content-Type: image/png");
 451   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(png_rj45_down_0));
 452   2              WEB_HEADER(pReq, buf);
 453   2              WEB_DATA(pReq, png_rj45_down_0, sizeof(png_rj45_down_0));
 454   2              break;
 455   2          case WEB_IMAGE_RJ45_UP_0_PNG:
 456   2              WEB_HEADER(pReq, "Content-Type: image/png");
 457   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(png_rj45_up_0));
 458   2              WEB_HEADER(pReq, buf);
 459   2              WEB_DATA(pReq, png_rj45_up_0, sizeof(png_rj45_up_0));
 460   2              break;
 461   2          case WEB_IMAGE_RJ45_DOWN_1_PNG:
 462   2              WEB_HEADER(pReq, "Content-Type: image/png");
 463   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(png_rj45_down_1));
 464   2              WEB_HEADER(pReq, buf);
 465   2              WEB_DATA(pReq, png_rj45_down_1, sizeof(png_rj45_down_1));
 466   2              break;
 467   2          case WEB_IMAGE_RJ45_UP_1_PNG:
 468   2              WEB_HEADER(pReq, "Content-Type: image/png");
 469   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(png_rj45_up_1));
 470   2              WEB_HEADER(pReq, buf);
 471   2              WEB_DATA(pReq, png_rj45_up_1, sizeof(png_rj45_up_1));
 472   2              break;
 473   2          case WEB_IMAGE_RJ45_LOOP_RLDP_UP_PNG:
 474   2              WEB_HEADER(pReq, "Content-Type: image/png");
 475   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(png_rj45_loop_rldp_up));
 476   2              WEB_HEADER(pReq, buf);
 477   2              WEB_DATA(pReq, png_rj45_loop_rldp_up, sizeof(png_rj45_loop_rldp_up));
 478   2              break;        
 479   2          case WEB_IMAGE_RJ45_LOOP_RLPP_UP_PNG:
 480   2              WEB_HEADER(pReq, "Content-Type: image/png");
 481   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(png_rj45_loop_rlpp_up));
 482   2              WEB_HEADER(pReq, buf);
 483   2              WEB_DATA(pReq, png_rj45_loop_rlpp_up, sizeof(png_rj45_loop_rlpp_up));
 484   2              break;        
 485   2          case WEB_IMAGE_DOCUMENT_GIF:
C51 COMPILER V9.60.0.0   WEB_IMAGE                                                         11/03/2026 14:15:59 PAGE 9   

 486   2              WEB_HEADER(pReq, "Content-Type: image/gif");
 487   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(gif_document));
 488   2              WEB_HEADER(pReq, buf);
 489   2              WEB_DATA(pReq, gif_document, sizeof(gif_document));
 490   2              break;
 491   2          case WEB_IMAGE_FOLDER_OPENED_GIF:
 492   2              WEB_HEADER(pReq, "Content-Type: image/gif");
 493   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(gif_folder_opened));
 494   2              WEB_HEADER(pReq, buf);
 495   2              WEB_DATA(pReq, gif_folder_opened, sizeof(gif_folder_opened));
 496   2              break;
 497   2          case WEB_IMAGE_FOLDER_CLOSED_GIF:
 498   2              WEB_HEADER(pReq, "Content-Type: image/gif");
 499   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(gif_folder_closed));
 500   2              WEB_HEADER(pReq, buf);
 501   2              WEB_DATA(pReq, gif_folder_closed, sizeof(gif_folder_closed));
 502   2              break;
 503   2          case WEB_IMAGE_PLUS_GIF:
 504   2              WEB_HEADER(pReq, "Content-Type: image/gif");
 505   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(gif_plus));
 506   2              WEB_HEADER(pReq, buf);
 507   2              WEB_DATA(pReq, gif_plus, sizeof(gif_plus));
 508   2              break;
 509   2          case WEB_IMAGE_MINUS_GIF:
 510   2          case WEB_IMAGE_TRANSPARENT_GIF:
 511   2              WEB_HEADER(pReq, "Content-Type: image/gif");
 512   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(gif_minus));
 513   2              WEB_HEADER(pReq, buf);
 514   2              WEB_DATA(pReq, gif_minus, sizeof(gif_minus));
 515   2              break;
 516   2          default:
 517   2              printf("%s():%d Error: Web image (%d) is not exist!\n", __FILE__, __LINE__);
 518   2              break;
 519   2          }
 520   1      
 521   1          WEB_END(pReq);
 522   1      
 523   1          return SUCCESS;
 524   1      }
