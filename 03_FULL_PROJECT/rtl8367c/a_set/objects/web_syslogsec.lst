 137          /*
 138           * Function: post_syslogsec
 139           * ------------------------
 140           * Processes syslog configuration form submission.
 141           * Extracts IP, UDP port, and enable state from POST data.
 142           * Validates IP format and port range.
 143           * Saves all syslog settings to flash and updates system configuration.
 144           */
 145          int32 post_syslogsec(struct http_request_s *pReq)
 146          {
 147   1          uint8           *pValue;
 148   1          uint8           ipStr[16] = { 0 } ;
 149   1          sal_ipaddr_t    ip = 0;
 150   1        uint16 udpPort;
 151   1        sal_enable_t  syslogStatus = 0;
 152   1      
 153   1          WEB_VAR(pReq, "ip", &pValue);
 154   1          if (pValue) {
 155   2              memcpy(ipStr, pValue, sizeof(ipStr));
 156   2          }
 157   1              
 158   1          WEB_VAR(pReq, "udpPort", &pValue);
 159   1          if (pValue) {
 160   2              udpPort = atoi(pValue);
 161   2          }
 162   1      
 163   1          WEB_VAR(pReq, "state", &pValue);
 164   1          if (pValue) {
 165   2              syslogStatus = atoi(pValue);
 166   2          }
 167   1        
 168   1          if (str_to_ip(&ip, ipStr) != 0) {
 169   2              printmsg(pReq, "Invalid IP Address.");
 170   2              return SUCCESS;
