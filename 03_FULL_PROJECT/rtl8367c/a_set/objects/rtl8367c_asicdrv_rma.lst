                  retVal = rtl8367c_setAsicRegBits(RTL8367C_REG_RMA_CTRL00, RTL8367C_TRAP_PRIORITY_MASK, pRmacfg->trap_p
             -riority);
                  if(retVal != RT_ERR_OK)
                      return retVal;
              
                  return rtl8367c_setAsicReg(RTL8367C_REG_RMA_CTRL_CDP, regData);
              }
