  20          // Remove RLPP Block Port: Removes ports in RLPP block or disable state from port mask
  21          // Filters out ports that are blocked or disabled by RLPP loop protection
  22          void remove_rlpp_block_port(portmask_type *pmask)
  23          {
  24   1          uint16 port, loopStatus;
  25   1          sal_lPortmask_t         allPortMask;
  26   1      
  27   1          sal_lPortMask_addAll(&allPortMask);
  28   1      
  29   1          for (port = 0; port < SAL_PORT_ID_CPU; ++port)
  30   1          {
  31   2              if (SAL_ERR_FAILED == sal_lPortMask_chkPort(&allPortMask, port))
  32   2              {
  33   3                  continue;
  34   3              }
  35   2      
  36   2              sal_loop_port_state_get(port, &loopStatus);
  37   2              if((loopStatus == SAL_RLPP_DISABLE_STATE) || (loopStatus == SAL_RLPP_BLOCKING_STATE))
  38   2              {
  39   3                  allPortMask.bits[0] &= ~(1UL << port);
  40   3              }
  41   2          }
  42   1          *pmask = allPortMask.bits[0];
  43   1      }
