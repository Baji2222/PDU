 470          // IGMPv3 Up Handle Membership Report: Processes IGMPv3 membership report messages
 471          // Handles include/exclude modes, adds/removes group members, and forwards to query ports
 472          static int32 igmpv3_up_handle_membership_report(pktBuf_t *pBuf) large
 473          {
