 759          /* Function Name:
 760           *      sal_trunk_representPort_get
 761           * Description:
 762           *      Get a represent port of the trunk of a physical port
 763           * Input:
 764           *      port - Physical port number
 765           * Output:
 766           *      pLport - Port number of the represent port.
 767           * Return:
 768           *      SAL_ERR_SUCCESS
 769           *      SAL_ERR_PARAMETER
 770           * Note:
 771           *      None
 772           */
 773          // Sal Trunk Represent Port Get: Gets a representative port for a trunk group
 774          // Returns first linked port in trunk group, or port itself if not in trunk
 775          int32 sal_trunk_representPort_get(sal_port_t port, sal_port_t *pLport)
 776          {
 777   1          uint8  linkUp, found;
 778   1          uint16 i, trk_grp_start;
 779   1          uint32 pmsk;
 780   1      
 781   1          if(port >= SAL_PORT_ID_CPU)
 782   1              return SAL_ERR_PARAMETER;
 783   1      
 784   1          /* get trunk group) */
 785   1          rtl8367c_getAsicTrunkingGroup(port >> 2, &pmsk);
 786   1      
 787   1          if(port >= 4)
 788   1              pmsk = pmsk << 4;
 789   1      
 790   1          /* if port in trunk */
 791   1          if((1 << port) & (pmsk & 0xFFFF))
 792   1          {
 793   2              /* find the first linked port number in group */
 794   2              trk_grp_start = port & ~(0x3);
 795   2      
C51 COMPILER V9.60.0.0   SALTRUNK                                                          11/02/2026 17:57:01 PAGE 14  

 796   2              found = FALSE;
 797   2              for(i = trk_grp_start;i < trk_grp_start + 4;i++)
 798   2              {
 799   3                  if(pmsk & (1 << i))
 800   3                  {
 801   4                      /* check if port is linked up */
 802   4                      linkUp = getReg(0x1352 + i) & 0x10;
 803   4                      if(linkUp)
 804   4                      {
 805   5                          found = TRUE;
 806   5                          break;
 807   5                      }
 808   4                  }
 809   3              }
 810   2      
 811   2              /* if cannot find represent port, then the represent port is itself */
 812   2              if(TRUE == found)
 813   2                  *pLport = i;
 814   2              else
 815   2                  *pLport = port;
 816   2          }
 817   1          /* else, the represent is itself */
 818   1          else
 819   1          {    
 820   2              *pLport = port;
 821   2          }
 822   1          
 823   1          return SAL_ERR_SUCCESS;
 824   1      }


