 692   2          return SAL_ERR_SUCCESS;
 693   2        }
 694   1      #endif
 695   1      
 696   1          memset(&portMask, 0, sizeof(sal_pPortmask_t));
 697   1        trkId = logicId - SAL_MAX_PHY_N_CPU_PORT;
