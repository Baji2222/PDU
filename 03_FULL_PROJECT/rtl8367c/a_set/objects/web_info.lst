 172          /*
 173           * Function: get_cable_diag
 174           * ------------------------
 175           * Performs cable diagnostic test on selected ports.
 176           * Reads checkbox values to determine which ports to test.
 177           * Starts RTCT (Real-Time Cable Test) on selected ports.
 178           * Displays test results: Normal, Open, Short, or Mismatch.
 179           * Shows cable fault distance in meters for each pair (A, B, C, D).
 180           */
 181          int32 get_cable_diag(http_request_t *pReq)
 182          {
 183   1          int8                i;
 184   1        char                strPort[4];
 185   1          char                strCheck[48];
 186   1          char                strResult[12];
 187   1          char                strDescription[80];
