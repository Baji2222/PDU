 226   1      
 227   1          for (i = 0; i < (MAX_PORT_ONBOARD - SAL_MAX_EXT_PORT); i++)
 228   1          {
 229   2              if (selectPmsk.bits[0] & (1UL << i))
C51 COMPILER V9.60.0.0   WEB_INFO                                                          11/02/2026 17:57:33 PAGE 5   

 230   2              {
