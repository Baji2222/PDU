 191   1          int32               ret;
 192   1          uint32 j;
 193   1      
 194   1          /* get selected portmask */
 195   1          selectPmsk.bits[0] = 0;
 196   1          for (i = 0; i < (MAX_PORT_ONBOARD - SAL_MAX_EXT_PORT); i++)
 197   1          {
 198   2              sprintf(strPort, "P%d", (int16)(i+1));    
 199   2              WEB_VAR(pReq, strPort, &pValue);
 200   2              if (pValue) /* enable */
 201   2                  selectPmsk.bits[0] |= 1UL << i;
 202   2          }
 203   1      
