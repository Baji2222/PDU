                  /* Check initialization state */
                  RTK_CHK_INIT_STATE();
              
                  /* Check Valid port mask */
                  if(NULL == pPortmask)
                      return RT_ERR_NULL_POINTER;
              
                  /* Check port mask valid */
                  RTK_CHK_PORTMASK_VALID(pPortmask);
              
                  if(rtk_switch_portmask_L2P_get(pPortmask, &phyMbrPmask) != RT_ERR_OK)
