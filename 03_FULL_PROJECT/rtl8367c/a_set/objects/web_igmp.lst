 223          /*
 224           * Function: post_igmp_state
 225           * -------------------------
 226           * Processes IGMP enable/disable form submission.
 227           * Extracts checkbox state from POST data.
 228           * Calls sal_igmp_state_set() to enable/disable IGMP snooping.
 229           * Refreshes IGMP configuration page after applying.
 230           */
 231          int32 post_igmp_state (struct http_request_s *pReq)
C51 COMPILER V9.60.0.0   WEB_IGMP                                                          11/02/2026 17:57:39 PAGE 5   

 232          {
 233   1          uint8  *pValue;
 234   1          sal_enable_t enable_igmp;
 235   1      
 236   1          WEB_VAR(pReq, "enable_igmp", &pValue);
 237   1          if (pValue)
 238   1                  enable_igmp = SAL_ENABLED;
 239   1              else
 240   1                  enable_igmp = SAL_DISABLED;
 241   1          
 242   1      
 243   1          sal_igmp_state_set(enable_igmp);
 244   1      
 245   1          get_igmp_dump(pReq);
 246   1          return SUCCESS;
 247   1      }
 248          
 249          /*
 250           * Function: post_igmp_static_router
 251           * ---------------------------------
 252           * Processes static router port configuration form submission.
 253           * Scans all ports for checkbox named "lPort_X".
 254           * Builds port mask from checked checkboxes.
 255           * Calls sal_igmp_staticRouter_set() to apply static router ports.
 256           */
 257          int32 post_igmp_static_router (struct http_request_s *pReq)
 258          {
 259   1          uint16   portId = 0;
 260   1          sal_lPortmask_t lPortMask;
 261   1          uint8   *pValue;
 262   1          uint8   strPort[16];    /* `lPort_xxxxxxx` */
 263   1      
 264   1          sal_lPortMask_delAll(&lPortMask);
 265   1          for (portId = 0; portId < SAL_PORT_ID_CPU; ++portId)
 266   1          {
 267   2              sprintf(strPort, "lPort_%u", portId);
 268   2              WEB_VAR(pReq, strPort, &pValue);
 269   2              if (pValue)
 270   2              {
 271   3                  sal_lPortMask_addPort(&lPortMask, portId);
 272   3              }
 273   2          }
 274   1          sal_igmp_staticRouter_set(lPortMask);
 275   1      
 276   1          get_igmp_dump(pReq);
 277   1          return SUCCESS;
 278   1      
 279   1      }
