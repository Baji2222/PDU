              /* Function Name:
               *      rtl8367c_setAsicMacAddress
               * Description:
               *      Set switch MAC address
               * Input:
               *      mac     - switch mac
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
               * Note:
               *      None
               */
              ret_t rtl8367c_setAsicMacAddress(ether_addr_t mac)
              {
                  ret_t retVal;
                  uint32 regData;
                  uint8 *accessPtr;
                  uint32 i;
              
                  accessPtr =  (uint8*)&mac;
              
                  regData = *accessPtr;
                  accessPtr ++;
                  regData = (regData << 8) | *accessPtr;
                  accessPtr ++;
                  for(i = 0; i <=2; i++)
                  {
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_MISC                                             11/03/2026 14:15:47 PAGE 2   

                      retVal = rtl8367c_setAsicReg(RTL8367C_REG_SWITCH_MAC2 - i, regData);
                      if(retVal != RT_ERR_OK)
                          return retVal;
              
                      regData = *accessPtr;
                      accessPtr ++;
                      regData = (regData << 8) | *accessPtr;
                      accessPtr ++;
                  }
              
                  return retVal;
              }
              /* Function Name:
               *      rtl8367c_getAsicMacAddress
               * Description:
               *      Get switch MAC address
               * Input:
               *      pMac    - switch mac
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
               * Note:
               *      None
               */
              ret_t rtl8367c_getAsicMacAddress(ether_addr_t *pMac)
              {
                  ret_t retVal;
                  uint32 regData;
                  uint8 *accessPtr;
                  uint32 i;
              
              
                  accessPtr = (uint8*)pMac;
              
                  for(i = 0; i <= 2; i++)
                  {
                      retVal = rtl8367c_getAsicReg(RTL8367C_REG_SWITCH_MAC2 - i, &regData);
                      if(retVal != RT_ERR_OK)
                          return retVal;
              
                      *accessPtr = (regData & 0xFF00) >> 8;
                      accessPtr ++;
                      *accessPtr = regData & 0xFF;
                      accessPtr ++;
                  }
              
                  return retVal;
              }
              /* Function Name:
               *      rtl8367c_getAsicDebugInfo
               * Description:
               *      Get per-port packet forward debugging information
               * Input:
               *      port        - Physical port number (0~7)
               *      pDebugifo   - per-port packet trap/drop/forward reason
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_MISC                                             11/03/2026 14:15:47 PAGE 3   

               *      RT_ERR_PORT_ID  - Invalid port number
               * Note:
               *      None
               */
              ret_t rtl8367c_getAsicDebugInfo(uint32 port, uint32 *pDebugifo)
              {
                  if(port > RTL8367C_PORTIDMAX)
                      return RT_ERR_PORT_ID;
              
                  return rtl8367c_getAsicRegBits(RTL8367C_DEBUG_INFO_REG(port), RTL8367C_DEBUG_INFO_MASK(port), pDebugif
             -o);
              }
              /* Function Name:
               *      rtl8367c_setAsicPortJamMode
               * Description:
               *      Set half duplex flow control setting
               * Input:
               *      mode  - 0: Back-Pressure 1: DEFER
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
               * Note:
               *      None
               */
              ret_t rtl8367c_setAsicPortJamMode(uint32 mode)
              {
                  return rtl8367c_setAsicRegBit(RTL8367C_REG_CFG_BACKPRESSURE, RTL8367C_LONGTXE_OFFSET,mode);
              }
              /* Function Name:
               *      rtl8367c_getAsicPortJamMode
               * Description:
               *      Get half duplex flow control setting
               * Input:
               *      pMode   - 0: Back-Pressure 1: DEFER
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
               * Note:
               *      None
               */
              ret_t rtl8367c_getAsicPortJamMode(uint32* pMode)
              {
                  return rtl8367c_getAsicRegBit(RTL8367C_REG_CFG_BACKPRESSURE, RTL8367C_LONGTXE_OFFSET, pMode);
              }
