 447          /**
 448           * Encodes object identifier into a pbuf chained ASN1 msg.
 449           *
 450           * @param p points to output pbuf to encode oid into
 451           * @param ofs points to the offset within the pbuf chain
 452           * @param ident_len object identifier array length
 453           * @param ident points to object identifier array
 454           * @return ERR_OK if successfull, ERR_ARG if we can't (or won't) encode
 455           */
 456          err_t
 457          snmp_asn1_enc_oid(u8_t *p, u16_t ofs, u8_t ident_len, s32_t *ident)
 458          {
 459   1        u8_t *msg_ptr;
 460   1      
 461   1        if (p != NULL)
 462   1        {
 463   2          msg_ptr = p + ofs;
 464   2      
 465   2          if (ident_len > 1)
 466   2          {
 467   3            if ((ident[0] == 1) && (ident[1] == 3))
 468   3            {
 469   4              /* compressed (most common) prefix .iso.org */
 470   4              *msg_ptr = 0x2b;
 471   4            }
 472   3            else
 473   3            {
 474   4              /* calculate prefix */
 475   4              *msg_ptr = (ident[0] * 40) + ident[1];
 476   4            }
 477   3            ofs += 1;
 478   3            msg_ptr++;
 479   3            ident_len -= 2;
 480   3            ident += 2;
 481   3          }
 482   2          else
 483   2          {
 484   3      /* @g:  allow empty varbinds for symmetry (we must decode them for getnext), allow partial compression??  
             -*/
C51 COMPILER V9.60.0.0   ASN1_ENC                                                          11/02/2026 17:57:40 PAGE 9   

 485   3            /* ident_len <= 1, at least we need zeroDotZero (0.0) (ident_len == 2) */
