 487   3          }
 488   2          while (ident_len > 0)
 489   2          {
 490   3            s32_t sub_id;
 491   3            u8_t shift, tail;
 492   3      
 493   3            ident_len--;
 494   3            sub_id = *ident;
 495   3            tail = 0;
 496   3            shift = 28;
 497   3            while(shift > 0)
 498   3            {
 499   4              u8_t _code_;
 500   4      
 501   4              _code_ = sub_id >> shift;
 502   4              if ((_code_ != 0) || (tail != 0))
 503   4              {
 504   5                tail = 1;
 505   5                *msg_ptr = _code_ | 0x80;
