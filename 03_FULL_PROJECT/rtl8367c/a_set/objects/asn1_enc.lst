 260   1        u8_t *msg_ptr;
 261   1      
 262   1        if (p != NULL)
 263   1        {
 264   2          msg_ptr = p + ofs;
 265   2          *msg_ptr = type;
 266   2          return ERR_OK;
 267   2        }
 268   1        /* p == NULL, ofs >= plen */
 269   1        return ERR_ARG;
 270   1      }
