 235           */
 236          static int parse_json_field(const char *json, const char *field, s32_t *value) {
 237   1          char pattern[32];
 238   1          const char *start;
 239   1      
 240   1          // Create pattern like "\"A\":"
 241   1          sprintf(pattern,"\"%s\":", field);
 242   1          // Find the pattern in the JSON string
 243   1          start = strstr(json, pattern);
 244   1          if (!start) return -1;
 245   1      
 246   1          // Move pointer to the value (after ":")
 247   1          start += strlen(pattern);
 248   1      
 249   1          // Skip any optional spaces
 250   1          while (*start == ' ' || *start == '\t') start++;
 251   1      
 252   1          // Extract the integer value
 253   1          *value = atoi(start);
 254   1          return 1;
 255   1      }
