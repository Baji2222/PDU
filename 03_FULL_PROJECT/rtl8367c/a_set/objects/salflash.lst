2480   1          
2481   1          memset(&buf[0], 0, sizeof(buf));
2482   1          memcpy(&buf[0], "NEW ", 4);
2483   1          
2484   1          FLASH_ERASE_SECTOR(FLSH_CONFIG_DUMMY_START);
2485   1          FLASH_WRITE((uint32)FLSH_CONFIG_DUMMY_START, buf, 4);
2486   1        
2487   1        //===================================================================
2488   1          SalFlshInit_except_Mac();
2489   1          /*a default cache is created, copy cache to flash*/
2490   1          sal_flash_cfg_save();
2491   1      
2492   1          return SAL_ERR_SUCCESS;
2493   1      }
