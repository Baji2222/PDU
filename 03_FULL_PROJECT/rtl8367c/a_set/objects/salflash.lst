3791          /* Function Name:
3792           *      sal_flash_serial_number_set
3793           * Description:
3794           *      Set Serial to flash.
3795           * Input:
3796           *      serial - pointer to serial number
3797           *      length - serial number length
3798           * Output:
3799           *      None
3800           * Return:
3801           *      SAL_ERR_SUCCESS
3802           * Note:
3803           *      None
3804           */
3805          int32 sal_flash_serial_number_set(char *serial, uint8 length)
3806          {
3807   1          uint8 xdata buf[100];
3808   1          if(length > 16)
3809   1              return SAL_ERR_FAILED;
3810   1          /* read MAC and serial number */    
3811   1          FLASH_READ((uint32)(FLSH_NVDATA_START), buf, sizeof(buf));
3812   1          /* keep MAC part and replace serial number*/
3813   1          memcpy(&buf[sizeof(sal_mac_t)],serial,length);
3814   1          buf[sizeof(sal_mac_t) + length] = 0;
3815   1      
3816   1          FLASH_ERASE_SECTOR(FLSH_NVDATA_START);
3817   1          FLASH_WRITE((uint32)FLSH_NVDATA_START, buf, sizeof(buf));
3818   1      
3819   1          return SAL_ERR_SUCCESS;
C51 COMPILER V9.60.0.0   SALFLASH                                                          11/03/2026 14:15:37 PAGE 63  

3820   1      }
