 437          // Sal Flash Sys MAC Set: Saves MAC address to flash in non-volatile area
 438          // Writes MAC address while preserving serial number in same sector
 439          int32
 440          sal_flash_sysMac_set (
 441              sal_mac_t *pMac
 442              )
 443          {
 444   1          uint8 xdata buf[100];
 445   1      
 446   1          if (NULL == pMac)
 447   1              return SAL_ERR_NULL_POINTER;
 448   1      
 449   1          /* read MAC and serial number */    
 450   1          FLASH_READ((uint32)(FLSH_NVDATA_START), buf, sizeof(buf));
 451   1          /* keep serial number and replace MAC part */
 452   1          memcpy(&buf[0],pMac->octet,ETHER_ADDR_LEN);
 453   1          
 454   1          FLASH_ERASE_SECTOR(FLSH_NVDATA_START);
 455   1          FLASH_WRITE((uint32)FLSH_NVDATA_START, buf, sizeof(buf));
 456   1      
 457   1          return SAL_ERR_SUCCESS;
 458   1      }
 459          
 460          // Sal Flash Sys MAC Get: Retrieves MAC address from flash
 461          // Reads MAC address from non-volatile storage area
 462          int32
 463          sal_flash_sysMac_get (
 464              sal_mac_t *pMac
 465              )
 466          {
 467   1      
 468   1          uint8 xdata buf[6];
 469   1          memset(buf,0,sizeof(buf));
 470   1          FLASH_READ((uint32)(FLSH_NVDATA_MAC), buf, sizeof(buf));
 471   1          memcpy(pMac->octet, &buf[0], sizeof(buf));
 472   1      
 473   1          return SAL_ERR_SUCCESS;
 474   1      }
