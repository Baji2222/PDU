2468          int32 sal_flash_cfg_reset()
2469          {
2470   1          //SalFlshInit();
2471   1          uint8 xdata buf[4];
2472   1          char devDesc[32] = "OPL SMART PDU RACK";
2473   1          printf("\nResetting device type to default\n");
2474   1          sal_flash_device_type_set(devDesc);
2475   1          memset(&configCache, 0x00, sizeof(ConfigCache));
