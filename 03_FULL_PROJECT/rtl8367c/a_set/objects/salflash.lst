               *      SAL_ERR_NULL_POINTER
               * Note:
               *      None
               */
              int32 sal_flash_lldp_get (sal_enable_t *pEnable)
              {
                  sal_flash_lldp_t lldp;
              
                  if(NULL == pEnable)
                      return SAL_ERR_NULL_POINTER;
              
                  _SalFlshRead(&lldp, FLSH_ADDR_LLDP_BEGIN, sal_flash_lldp_t);
                  
                  *pEnable = lldp.enable;
              
                  return SAL_ERR_SUCCESS;
