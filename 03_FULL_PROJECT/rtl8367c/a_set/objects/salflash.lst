 559          
 560          // Sal Flash Rate Init: Initializes default rate control settings
 561          // Sets storm control, bandwidth control, and frame size defaults
 562          void
 563          sal_flash_rate_init ()
 564          {
 565   1          sal_lPortmask_t portMask;
 566   1          sal_port_t      port;
 567   1      
 568   1          sal_flash_rate_igrIncludeIFG_set(DFLT_FWD_INGRS_PREABMLE);
 569   1          sal_flash_rate_egrIncludeIFG_set(DFLT_FWD_EGRS_PREAMBLE);
 570   1      
 571   1          sal_trunk_logicPort_setAll(&portMask);
 572   1      
 573   1          for (port = 0; port < SAL_PORT_ID_CPU; ++port)
 574   1          {
 575   2              if (SAL_ERR_FAILED == sal_lPortMask_chkPort(&portMask, port))
 576   2              {
 577   3                  continue;
