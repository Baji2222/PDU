1057          int32 set_rtc_time_handler(struct http_request_s *pReq)
1058          {
1059   1          int H = -1, M = -1, S = -1, D = -1, MO = -1, Y = -1;
1060   1          int ok = 0;
1061   1      
1062   1          if (parse_query_uint(pReq, "H",  &H)  != 0) H  = -1;
1063   1          if (parse_query_uint(pReq, "M",  &M)  != 0) M  = -1;
1064   1          if (parse_query_uint(pReq, "S",  &S)  != 0) S  = -1;
1065   1          if (parse_query_uint(pReq, "D",  &D)  != 0) D  = -1;
1066   1          if (parse_query_uint(pReq, "MO", &MO) != 0) MO = -1;
1067   1          if (parse_query_uint(pReq, "Y",  &Y)  != 0) Y  = -1;
1068   1      
1069   1          printf("RTC set: %02d:%02d:%02d  %02d-%02d-%04d\r\n", H, M, S, D, MO, Y);
1070   1      
1071   1          if (H  >= 0   && H  <= 23 &&
1072   1              M  >= 0   && M  <= 59 &&
1073   1              S  >= 0   && S  <= 59 &&
1074   1              D  >= 1   && D  <= 31 &&
1075   1              MO >= 1   && MO <= 12 &&
1076   1              Y  >= 2000 && Y <= 2099)
1077   1          {
1078   2              /* TODO: rtc_set_time(H, M, S); rtc_set_date(D, MO, Y); */
1079   2              ok = 1;
1080   2          }
1081   1      
1082   1          WEB_BEGIN(pReq);
1083   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
1084   1          WEB_HEADER(pReq, "Content-Type: application/json");
1085   1          WEB_HEADER(pReq, "Cache-Control: no-cache");
1086   1      
1087   1          if (ok)
1088   1              WEB_PRINTF(pReq, "{\"STATUS\":\"OK\"}");
1089   1          else
1090   1              WEB_PRINTF(pReq, "{\"STATUS\":\"ERR\"}");
1091   1      
1092   1          WEB_END(pReq);
1093   1          return SUCCESS;
1094   1      }
