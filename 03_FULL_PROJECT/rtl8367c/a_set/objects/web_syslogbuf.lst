 221          /*
 222           * Function: post_syslogbufsec
 223           * ---------------------------
 224           * Processes syslog buffer clear form submission.
 225           * Extracts clear state (Yes/No) from POST data.
 226           * If Yes, resets head/tail indices and clears buffer.
 227           * Saves configuration to flash and shows confirmation message.
 228           */
 229          int32 post_syslogbufsec(struct http_request_s *pReq)
 230          {
 231   1          uint8           *pValue;
 232   1        sal_enable_t  syslogBufClear = 0;
C51 COMPILER V9.60.0.0   WEB_SYSLOGBUF                                                     11/03/2026 14:16:04 PAGE 5   

 233   1      
 234   1          WEB_VAR(pReq, "state", &pValue);
 235   1          if (pValue) {
 236   2              syslogBufClear = atoi(pValue);
 237   2          }
 238   1        
 239   1          if (syslogBufClear == 1)
 240   1          {
 241   2          sal_sys_syslog_headIdx_set(DFLT_SYSLOG_BUF_HEAD_IDX, 1);
 242   2          sal_sys_syslog_tailIdx_set(DFLT_SYSLOG_BUF_TAIL_IDX, 1);
 243   2      
 244   2          //Clear buffer
 245   2          sal_syslog_buf_head_idx_set(DFLT_SYSLOG_BUF_HEAD_IDX);  
 246   2          sal_syslog_buf_tail_idx_set(DFLT_SYSLOG_BUF_TAIL_IDX);
 247   2          
 248   2          sal_flash_cfg_save();
 249   2      
 250   2          printmsg(pReq, "Syslog Messages Cleared..");
 251   2          }
 252   1            
 253   1          get_syslogbufsec(pReq);
 254   1      
 255   1          return SUCCESS;
 256   1      }
 257          #endif
