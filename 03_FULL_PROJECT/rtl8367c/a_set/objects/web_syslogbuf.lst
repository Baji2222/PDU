 955          /* ================================================================== *
 956           *  parse_query_uint
 957           *
 958           *  Extract an integer query parameter from the raw request buffer.
 959           *
 960           *  The firmware stores the full HTTP request in pReq->pPath, e.g.:
 961           *
 962           *    "GET /set_rtc_time?H=12&M=12&S=12&D=12&MO=12&Y=2012 HTTP/1.1\r\n"
 963           *    "Host: 192.168.1.1\r\n"
 964           *    "Referer: http://192.168.1.1/vlan.cgi?page=set_rtc_data_alarm\r\n"
 965           *    ...
 966           *
 967           *  So we must:
 968           *    - start scanning right after the '?' in the request line
 969           *    - stop at the first ' ', '\r' or '\n' (end of request line)
 970           *    - never scan the headers (a '?' in Referer must not confuse us)
 971           *
 972           *  Exact-length key match, so "M" never matches "MO".
 973           *  Returns 0 on success, -1 if not found or malformed.
 974           * ================================================================== */
 975          static int parse_query_uint(struct http_request_s *pReq,
 976                                      const char *name,
 977                                      int        *out)
 978          {
 979   1          const char *p;
 980   1          const char *qs_end;
 981   1          size_t      nlen;
 982   1      
 983   1          if (!pReq || !pReq->pPath || !name || !out) return -1;
 984   1      
 985   1          nlen = strlen(name);
 986   1          if (nlen == 0) return -1;
 987   1      
 988   1          p = (const char *)pReq->pPath;
 989   1      
 990   1          /* advance to the first '?' — start of the query string */
C51 COMPILER V9.60.0.0   WEB_SYSLOGBUF                                                     11/03/2026 14:16:04 PAGE 19  

 991   1          while (*p && *p != '?' && *p != ' ' && *p != '\r' && *p != '\n')
 992   1              p++;
 993   1          if (*p != '?') return -1;
 994   1          p++;                                   /* skip '?' */
 995   1      
 996   1          /* end of the request line — anything past this is headers */
 997   1          qs_end = p;
 998   1          while (*qs_end && *qs_end != ' ' && *qs_end != '\r' && *qs_end != '\n')
 999   1              qs_end++;
1000   1      
1001   1          /* scan "key=value&key=value..." inside [p, qs_end) */
1002   1          while (p < qs_end) {
1003   2              const char *kstart = p;
1004   2              const char *kend;
1005   2              size_t      klen;
1006   2              long        val    = 0;
1007   2              int         sign   = 1;
1008   2              int         digits = 0;
1009   2      
1010   2              /* key runs until '=' or '&' or end of query string */
1011   2              while (p < qs_end && *p != '=' && *p != '&')
1012   2                  p++;
1013   2              kend = p;
1014   2              klen = (size_t)(kend - kstart);
1015   2      
1016   2              if (p >= qs_end || *p != '=') {
1017   3                  /* key with no '=': skip to next '&' */
1018   3                  while (p < qs_end && *p != '&') p++;
1019   3                  if (p < qs_end && *p == '&') p++;
1020   3                  continue;
1021   3              }
1022   2              p++;                               /* skip '=' */
1023   2      
1024   2              if (klen == nlen && memcmp(kstart, name, nlen) == 0) {
1025   3                  /* matched — parse the value */
1026   3                  if (p < qs_end && *p == '-')      { sign = -1; p++; }
1027   3                  else if (p < qs_end && *p == '+') { p++; }
1028   3      
1029   3                  while (p < qs_end && *p >= '0' && *p <= '9') {
1030   4                      val = val * 10 + (*p - '0');
1031   4                      p++;
1032   4                      digits++;
1033   4                  }
1034   3      
1035   3                  /* value must end at '&' or end of query string */
1036   3                  if (p != qs_end && *p != '&')
1037   3                      return -1;
1038   3                  if (digits == 0)
1039   3                      return -1;
1040   3      
1041   3                  *out = (int)(sign * val);
1042   3                  return 0;
1043   3              }
1044   2      
1045   2              /* wrong key: skip to next '&' */
1046   2              while (p < qs_end && *p != '&') p++;
1047   2              if (p < qs_end && *p == '&') p++;
1048   2          }
1049   1      
1050   1          return -1;
1051   1      }
1052          
