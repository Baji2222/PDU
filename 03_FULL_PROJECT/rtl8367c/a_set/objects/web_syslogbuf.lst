  46          /*
  47           * Function: int_to_str_syslog_severity
  48           * ------------------------------------
  49           * Converts syslog severity numeric value to display string.
  50           * Maps severity codes (Emergency, Alert, Error, etc.) to readable text.
  51           * Prints formatted table cell with severity name.
C51 COMPILER V9.60.0.0   WEB_SYSLOGBUF                                                     11/03/2026 14:16:04 PAGE 2   

  52           * Used for syslog buffer display formatting.
  53           */
  54          static void int_to_str_syslog_severity(uint8 severity, struct http_request_s *pReq)
  55          {
  56   1        switch(severity)
  57   1        {
  58   2          case SYSLOG_SEV_EMERG:
  59   2             WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Emergency");
  60   2            break;
  61   2          case SYSLOG_SEV_ALERT:
  62   2            WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Alert");
  63   2            break;
  64   2          case SYSLOG_SEV_ERR:
  65   2            WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Error");
  66   2            break;
  67   2          case SYSLOG_SEV_CRIT:
  68   2            WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Critical");
  69   2            break;
  70   2          case SYSLOG_SEV_WARNING:
  71   2            WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Warning");
  72   2            break;
  73   2          case SYSLOG_SEV_NOTICE:
  74   2            WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Notice");
  75   2            break;
  76   2          case SYSLOG_SEV_INFO:
  77   2            WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Info");
  78   2            break;
  79   2          case SYSLOG_SEV_DEBUG:
  80   2            WEB_PRINTF(pReq, "    <td width=\"15\">%s</td>\n", "Debug");
  81   2            break;
  82   2          default:
  83   2            break;
  84   2        }
  85   1        return;
  86   1      }
