 301          /**
 302           * Decodes object identifier from incoming message into array of s32_t.
 303           *
 304           * @param p points to a pbuf holding an ASN1 coded object identifier
 305           * @param ofs points to the offset within the pbuf chain of the ASN1 coded object identifier
 306           * @param len length of the coded object identifier
 307           * @param oid return object identifier struct
 308           * @return ERR_OK if successfull, ERR_ARG if we can't (or won't) decode
 309           */
 310          err_t
 311          snmp_asn1_dec_oid(u8_t *p, u16_t ofs, u16_t len, struct snmp_obj_id *oid)
 312          {
 313   1        u8_t *msg_ptr;
 314   1        s32_t *oid_ptr;
 315   1      
 316   1        if (p != NULL)
 317   1        {
 318   2          msg_ptr = p + ofs;
 319   2      
 320   2          oid->len = 0;
 321   2          oid_ptr = &oid->id[0];
 322   2          if (len > 0)
 323   2          {
 324   3            /* first compressed octet */
 325   3            if (*msg_ptr == 0x2B)
 326   3            {
 327   4              /* (most) common case 1.3 (iso.org) */
 328   4              *oid_ptr = 1;
 329   4              oid_ptr++;
 330   4              *oid_ptr = 3;
 331   4              oid_ptr++;
 332   4            }
 333   3            else if (*msg_ptr < 40)
 334   3            {
 335   4              *oid_ptr = 0;
 336   4              oid_ptr++;
 337   4              *oid_ptr = *msg_ptr;
 338   4              oid_ptr++;
 339   4            }
 340   3            else if (*msg_ptr < 80)
 341   3            {
 342   4              *oid_ptr = 1;
 343   4              oid_ptr++;
 344   4              *oid_ptr = (*msg_ptr) - 40;
 345   4              oid_ptr++;
 346   4            }
 347   3            else
 348   3            {
 349   4              *oid_ptr = 2;
 350   4              oid_ptr++;
 351   4              *oid_ptr = (*msg_ptr) - 80;
 352   4              oid_ptr++;
 353   4            }
 354   3            oid->len = 2;
 355   3          }
 356   2          else
 357   2          {
 358   3            /* accepting zero length identifiers e.g. for
 359   3               getnext operation. uncommon but valid */
 360   3            return ERR_OK;
 361   3          }
C51 COMPILER V9.60.0.0   ASN1_DEC                                                          11/03/2026 14:16:05 PAGE 7   

 362   2          len--;
 363   2          if (len > 0)
 364   2          {
 365   3            ofs += 1;
 366   3            msg_ptr++;
 367   3          }
 368   2          while ((len > 0) && (oid->len < LWIP_SNMP_OBJ_ID_LEN))
 369   2          {
 370   3            /* sub-identifier uses multiple octets */
 371   3            if (*msg_ptr & 0x80)
 372   3            {
 373   4              s32_t sub_id = 0;
 374   4      
 375   4              while ((*msg_ptr & 0x80) && (len > 1))
 376   4              {
 377   5                len--;
 378   5                sub_id = (sub_id << 7) + (*msg_ptr & ~0x80);
 379   5                ofs += 1;
 380   5                msg_ptr++;
 381   5              }
 382   4              if (!(*msg_ptr & 0x80) && (len > 0))
 383   4              {
 384   5                /* last octet sub-identifier */
 385   5                len--;
 386   5                sub_id = (sub_id << 7) + *msg_ptr;
 387   5                *oid_ptr = sub_id;
 388   5              }
 389   4            }
 390   3            else
 391   3            {
 392   4              /* !(*msg_ptr & 0x80) sub-identifier uses single octet */
 393   4              len--;
 394   4              *oid_ptr = *msg_ptr;
 395   4            }
 396   3            if (len > 0)
 397   3            {
 398   4              /* remaining oid bytes available ... */
 399   4              ofs += 1;
 400   4              msg_ptr++;
 401   4            }
 402   3            oid_ptr++;
 403   3            oid->len++;
 404   3          }
 405   2          if (len == 0)
 406   2          {
 407   3            /* len == 0, end of oid */
 408   3            return ERR_OK;
 409   3          }
 410   2          else
 411   2          {
 412   3            /* len > 0, oid->len == LWIP_SNMP_OBJ_ID_LEN or malformed encoding */
 413   3            return ERR_ARG;
 414   3          }
 415   2        }
 416   1        /* p == NULL, ofs >= plen */
 417   1        return ERR_ARG;
 418   1      }
