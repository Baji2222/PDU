  60          /**
  61           * Decodes length field from incoming pbuf chain into host length.
  62           *
  63           * @param p points to a pbuf holding an ASN1 coded length
  64           * @param ofs points to the offset within the pbuf chain of the ASN1 coded length
  65           * @param octets_used returns number of octets used by the length code
  66           * @param length return host order length, upto 64k
  67           * @return ERR_OK if successfull, ERR_ARG if we can't (or won't) decode
  68           */
  69          err_t
  70          snmp_asn1_dec_length(u8_t *p, u16_t ofs, u8_t *octets_used, u16_t *length)
  71          {
  72   1        u8_t *msg_ptr;
  73   1      
  74   1        if (p != NULL)
  75   1        {
  76   2          msg_ptr = (p+ofs);
  77   2      
  78   2          if (*msg_ptr < 0x80)
  79   2          {
  80   3            /* primitive definite length format */
  81   3            *octets_used = 1;
  82   3            *length = *msg_ptr;
  83   3            return ERR_OK;
  84   3          }
  85   2          else if (*msg_ptr == 0x80)
  86   2          {
  87   3            /* constructed indefinite length format, termination with two zero octets */
  88   3            u8_t zeros;
  89   3            u8_t i;
  90   3      
  91   3            *length = 0;
  92   3            zeros = 0;
  93   3            while (zeros != 2)
  94   3            {
  95   4              i = 2;
  96   4              while (i > 0)
  97   4              {
  98   5                i--;
  99   5                (*length) += 1;
 100   5                ofs += 1;
 101   5                msg_ptr++;
 102   5                if (*msg_ptr == 0)
 103   5                {
 104   6                  zeros++;
 105   6                  if (zeros == 2)
 106   6                  {
 107   7                    /* stop while (i > 0) */
 108   7                    i = 0;
 109   7                  }
 110   6                }
 111   5                else
 112   5                {
 113   6                  zeros = 0;
C51 COMPILER V9.60.0.0   ASN1_DEC                                                          11/03/2026 14:16:05 PAGE 3   

 114   6                }
 115   5              }
 116   4            }
 117   3            *octets_used = 1;
 118   3            return ERR_OK;
 119   3          }
 120   2          else if (*msg_ptr == 0x81)
 121   2          {
 122   3            /* constructed definite length format, one octet */
 123   3            ofs += 1;
 124   3            msg_ptr++;
 125   3            *length = *msg_ptr;
 126   3            *octets_used = 2;
 127   3            return ERR_OK;
 128   3          }
 129   2          else if (*msg_ptr == 0x82)
 130   2          {
 131   3            u8_t i;
 132   3      
 133   3            /* constructed definite length format, two octets */
 134   3            i = 2;
 135   3            while (i > 0)
 136   3            {
 137   4              i--;
 138   4              ofs += 1;
 139   4              msg_ptr++;
 140   4              if (i == 0)
 141   4              {
 142   5                /* least significant length octet */
 143   5                *length |= *msg_ptr;
 144   5              }
 145   4              else
 146   4              {
 147   5                /* most significant length octet */
 148   5                *length = (*msg_ptr) << 8;
 149   5              }
 150   4            }
 151   3            *octets_used = 3;
 152   3            return ERR_OK;
 153   3          }
 154   2          else
 155   2          {
 156   3            /* constructed definite length format 3..127 octets, this is too big (>64k) */
 157   3            /**  @todo: do we need to accept inefficient codings with many leading zero's? */
 158   3            *octets_used = 1 + ((*msg_ptr) & 0x7f);
 159   3            return ERR_ARG;
 160   3          }
 161   2        }
 162   1      
 163   1        /* p == NULL, ofs >= plen */
 164   1        return ERR_ARG;
 165   1      }
