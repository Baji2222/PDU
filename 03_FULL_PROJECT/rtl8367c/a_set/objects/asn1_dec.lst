 229          /**
 230           * Decodes integer into s32_t.
 231           *
 232           * @param p points to a pbuf holding an ASN1 coded integer
 233           * @param ofs points to the offset within the pbuf chain of the ASN1 coded integer
 234           * @param len length of the coded integer field
 235           * @param value return host order integer
 236           * @return ERR_OK if successfull, ERR_ARG if we can't (or won't) decode
 237           *
C51 COMPILER V9.60.0.0   ASN1_DEC                                                          11/03/2026 14:16:05 PAGE 5   

 238           * @note ASN coded integers are _always_ signed!
 239           */
 240          err_t
 241          snmp_asn1_dec_s32t(u8_t *p, u16_t ofs, u16_t len, s32_t *value)
 242          {
 243   1        u8_t *msg_ptr;
 244   1        u8_t *lsb_ptr = (u8_t*)value + sizeof(s32_t) - 1;
 245   1        u8_t sign;
 246   1      
 247   1        if (p != NULL)
 248   1        {
 249   2          msg_ptr = p + ofs;
 250   2          if ((len > 0) && (len < 5))
 251   2          {
 252   3            if (*msg_ptr & 0x80)
 253   3            {
 254   4              /* negative, start from -1 */
 255   4              *value = -1;
 256   4              sign = 1;
 257   4            }
 258   3            else
 259   3            {
 260   4              /* positive, start from 0 */
 261   4              *value = 0;
 262   4              sign = 0;
 263   4            }
 264   3            /* OR/AND octets with value */
 265   3            while (len > 1)
 266   3            {
 267   4              len--;
 268   4              if (sign)
 269   4              {
 270   5                *lsb_ptr &= *msg_ptr;
 271   5                *value <<= 8;
 272   5                *lsb_ptr |= 255;
 273   5              }
 274   4              else
 275   4              {
 276   5                *lsb_ptr |= *msg_ptr;
 277   5                *value <<= 8;
 278   5              }
 279   4              ofs += 1;
 280   4              msg_ptr++;
 281   4            }
 282   3            if (sign)
 283   3            {
 284   4              *lsb_ptr &= *msg_ptr;
 285   4            }
 286   3            else
 287   3            {
 288   4              *lsb_ptr |= *msg_ptr;
 289   4            }
 290   3            return ERR_OK;
 291   3          }
 292   2          else
 293   2          {
 294   3            return ERR_ARG;
 295   3          }
 296   2        }
 297   1        /* p == NULL, ofs >= plen */
 298   1        return ERR_ARG;
 299   1      }
