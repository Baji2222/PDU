 167          /**
 168           * Decodes positive integer (counter, gauge, timeticks) into u32_t.
 169           *
 170           * @param p points to a pbuf holding an ASN1 coded integer
 171           * @param ofs points to the offset within the pbuf chain of the ASN1 coded integer
 172           * @param len length of the coded integer field
 173           * @param value return host order integer
 174           * @return ERR_OK if successfull, ERR_ARG if we can't (or won't) decode
 175           *
C51 COMPILER V9.60.0.0   ASN1_DEC                                                          11/03/2026 14:16:05 PAGE 4   

 176           * @note ASN coded integers are _always_ signed. E.g. +0xFFFF is coded
 177           * as 0x00,0xFF,0xFF. Note the leading sign octet. A positive value
 178           * of 0xFFFFFFFF is preceded with 0x00 and the length is 5 octets!!
 179           */
 180          err_t
 181          snmp_asn1_dec_u32t(u8_t *p, u16_t ofs, u16_t len, u32_t *value)
 182          {
 183   1        u8_t *msg_ptr;
 184   1      
 185   1        if (p != NULL)
 186   1        {
 187   2          msg_ptr = p + ofs;
 188   2          if ((len > 0) && (len < 6))
 189   2          {
 190   3            /* start from zero */
 191   3            *value = 0;
 192   3            if (*msg_ptr & 0x80)
 193   3            {
 194   4              /* negative, expecting zero sign bit! */
 195   4              return ERR_ARG;
 196   4            }
 197   3            else
 198   3            {
 199   4              /* positive */
 200   4              if ((len > 1) && (*msg_ptr == 0))
 201   4              {
 202   5                /* skip leading "sign byte" octet 0x00 */
 203   5                len--;
 204   5                ofs += 1;
 205   5                msg_ptr++;
 206   5              }
 207   4            }
 208   3            /* OR octets with value */
 209   3            while (len > 1)
 210   3            {
 211   4              len--;
 212   4              *value |= *msg_ptr;
 213   4              *value <<= 8;
 214   4              ofs += 1;
 215   4              msg_ptr++;
 216   4            }
 217   3            *value |= *msg_ptr;
 218   3            return ERR_OK;
 219   3          }
 220   2          else
 221   2          {
 222   3            return ERR_ARG;
 223   3          }
 224   2        }
 225   1        /* p == NULL, ofs >= plen */
 226   1        return ERR_ARG;
 227   1      }
