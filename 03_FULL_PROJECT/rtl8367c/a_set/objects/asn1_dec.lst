 420          /**
 421           * Decodes (copies) raw data (ip-addresses, octet strings, opaque encoding)
 422           * from incoming message into array.
 423           *
C51 COMPILER V9.60.0.0   ASN1_DEC                                                          11/03/2026 14:16:05 PAGE 8   

 424           * @param p points to a pbuf holding an ASN1 coded raw data
 425           * @param ofs points to the offset within the pbuf chain of the ASN1 coded raw data
 426           * @param len length of the coded raw data (zero is valid, e.g. empty string!)
 427           * @param raw_len length of the raw return value
 428           * @param raw return raw bytes
 429           * @return ERR_OK if successfull, ERR_ARG if we can't (or won't) decode
 430           */
 431          err_t
 432          snmp_asn1_dec_raw(u8_t *p, u16_t ofs, u16_t len, u16_t raw_len, u8_t *raw)
 433          {
 434   1        u8_t *msg_ptr;
 435   1      
 436   1        if (len > 0)
 437   1        {
 438   2          if (p != NULL)
 439   2          {
 440   3            msg_ptr = p + ofs;
 441   3            if (raw_len >= len)
 442   3            {
 443   4              while (len > 1)
 444   4              {
 445   5                /* copy len - 1 octets */
 446   5                len--;
 447   5                *raw = *msg_ptr;
 448   5                raw++;
 449   5                ofs += 1;
 450   5                msg_ptr++;
 451   5              }
 452   4              /* copy last octet */
 453   4              *raw = *msg_ptr;
 454   4              return ERR_OK;
 455   4            }
 456   3            else
 457   3            {
 458   4              /* raw_len < len, not enough dst space */
 459   4              return ERR_ARG;
 460   4            }
 461   3          }
 462   2          /* p == NULL, ofs >= plen */
 463   2          return ERR_ARG;
 464   2        }
 465   1        else
 466   1        {
 467   2          /* len == 0, empty string */
 468   2          return ERR_OK;
 469   2        }
 470   1      }
