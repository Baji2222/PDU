  23          /*
  24          @func ret_t | rtl8367c_setAsicEee100M | Set eee force mode function enable/disable.
  25          @parm uint32 | port | The port number.
  26          @parm uint32 | enabled | 1: enabled, 0: disabled.
  27          @rvalue RT_ERR_OK | Success.
  28          @rvalue RT_ERR_SMI | SMI access error.
  29          @rvalue RT_ERR_INPUT | Invalid input parameter.
  30          @comm
  31              This API set the 100M EEE enable function.
  32          
  33          */
  34          ret_t rtl8367c_setAsicEee100M(uint32 port, uint32 enable)
  35          {
  36   1          rtk_api_ret_t   retVal;
  37   1          uint32      regData;
  38   1      
  39   1          if(port >= RTL8367C_PORTNO)
  40   1              return RT_ERR_PORT_ID;
  41   1      
  42   1          if (enable > 1UL)
  43   1              return RT_ERR_INPUT;
  44   1      
  45   1          if((retVal = rtl8367c_getAsicPHYOCPReg(port, EEE_OCP_PHY_ADDR, &regData)) != RT_ERR_OK)
