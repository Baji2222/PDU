 246   3                  char *name = var_buffer + pReq->Var[i].name_offset;
 247   3                  char *value = var_buffer + pReq->Var[i].value_offset;
 248   3                  int value_len = pReq->Var[i].value_length;
 249   3      
 250   3                  if (strcmp(name, "state") == 0) {
 251   4                      int len = (value_len < 7) ? value_len : 7;
 252   4                      strncpy(state_str, value, len);
 253   4                      state_str[len] = '\0';
 254   4                      state = atoi(state_str);
 255   4                      break;
 256   4                  }
 257   3              }
 258   2          }
 259   1      
 260   1          /* Method 3: POST body */
 261   1          if (state == -1 && pReq->pBody) {
 262   2              char *state_ptr = strstr((char*)pReq->pBody, "state=");
 263   2              if (state_ptr) {
 264   3                  state = atoi(state_ptr + 6);
 265   3              }
 266   2          }
 267   1      
 268   1          if (state != 0 && state != 1) {
 269   2              WEB_BEGIN(pReq);
 270   2              WEB_STATUS(pReq, HTTP_STATUS_BAD_REQUEST);
 271   2              WEB_HEADER(pReq, "Content-Type: application/json");
