 200          /*
 201           * set_port_handler: one handler for all ports (1-8),
 202           * port number is taken from the URL path /set_portX
 203           */
 204          int32 set_port_handler(struct http_request_s *pReq)
 205          {
 206   1          int state = -1, i = 0;
 207   1          int port_num = -1;
 208   1          char *path = NULL;
 209   1          char state_str[8] = {0};
