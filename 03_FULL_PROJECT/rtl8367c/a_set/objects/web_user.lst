 130          /*
 131           * Function: post_user
 132           * -------------------
 133           * Processes user account form submission.
 134           * Extracts username and password from POST data.
 135           * Calls sal_flash_sysAccount_set() to save credentials.
 136           * Logs password change event to syslog.
 137           */
 138          int32 post_user(struct http_request_s *pReq)
 139          {
 140   1          uint8  *pValue;
 141   1          uint8  username[SAL_FLSH_USR_USERNAME_LEN + 1];
 142   1          uint8  password[SAL_FLSH_USR_PASSWORD_LEN + 1];
 143   1      
 144   1          /* get variables */
 145   1          WEB_VAR(pReq, "mname", &pValue);
 146   1          if (pValue) {
 147   2              //memcpy(username, pValue, SAL_FLSH_USR_USERNAME_LEN);
 148   2              strcpy(username, pValue);
 149   2          }
 150   1          
 151   1          WEB_VAR(pReq, "mpass", &pValue);
 152   1          if (pValue) {
 153   2              //memcpy(password, pValue, SAL_FLSH_USR_PASSWORD_LEN);
 154   2              strcpy(password, pValue);
 155   2          }
 156   1      
 157   1          /* Save user account */
 158   1          sal_flash_sysAccount_set(username, password);
 159   1      
 160   1        syslog_add_new_buf_entry(SYSLOG_MSG_PASSWORD_CHANGED, 0);
 161   1          
 162   1          get_user(pReq);
 163   1      
 164   1          return SUCCESS;
 165   1      }
