 230   2          }
 231   1      
 232   1          /* Method 1: query string in path */
 233   1          qmark = strchr(path, '?');
 234   1          if (qmark) {
 235   2              char *state_ptr = strstr(qmark, "state=");
 236   2              if (state_ptr) {
 237   3                  state = atoi(state_ptr + 6);
 238   3              }
 239   2          }
 240   1      
 241   1          /* Method 2: variables already parsed by the server */
 242   1          if (state == -1 && pReq->pVar_Temp) {
 243   2              char *var_buffer = (char*)pReq->pVar_Temp;
