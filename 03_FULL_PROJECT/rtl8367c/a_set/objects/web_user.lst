 153          /*
 154           * get_pdu_status
 155           * Returns the last good status frame (Get_Response).
 156           * FIX: sends GET_STATUS itself, but only when the previous request has
 157           * been answered (send_str_web() clears status_waiting). If no reply
 158           * comes for STATUS_RESEND_POLLS polls, the command is sent again.
 159           * This keeps MCU2's UART buffer from filling with queued polls.
 160           * It no longer clears start_rtc_data / start_alarm_data, so a status
 161           * poll cannot cancel an RTC or alarm request.
 162           */
 163          int32 get_pdu_status(struct http_request_s *pReq)
 164          {
 165   1      #if SEND_STATUS_IN_HANDLER
 166   1          if (!status_waiting || ++status_wait_polls >= STATUS_RESEND_POLLS)
 167   1          {
C51 COMPILER V9.60.0.0   WEB_USER                                                          11/03/2026 14:16:02 PAGE 4   

 168   2              printf("GET_STATUS\r\n");
 169   2              status_waiting    = 1;
 170   2              status_wait_polls = 0;
 171   2          }
 172   1      #else
                  start_pdu_status = 1;      /* old path: another function sends it */
              #endif
 175   1      
 176   1          WEB_BEGIN(pReq);
 177   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
 178   1          WEB_HEADER(pReq, "Content-Type: application/json");
 179   1          WEB_PRINTF(pReq, "%s", Get_Response);
 180   1          WEB_END(pReq);
 181   1          return SUCCESS;
 182   1      }
