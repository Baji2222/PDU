 118          /*
 119           * post_user: saves username / password.
 120           * FIX: start from the current values, so a missing field is never
 121           * saved as uninitialised memory; copies are length-limited.
 122           */
 123          int32 post_user(struct http_request_s *pReq)
 124          {
 125   1          uint8  *pValue;
 126   1          uint8  username[SAL_FLSH_USR_USERNAME_LEN + 1];
 127   1          uint8  password[SAL_FLSH_USR_PASSWORD_LEN + 1];
 128   1      
 129   1          sal_flash_sysAccount_get(username, password);
 130   1      
 131   1          WEB_VAR(pReq, "mname", &pValue);
 132   1          if (pValue) {
 133   2              strncpy((char*)username, (char*)pValue, SAL_FLSH_USR_USERNAME_LEN);
 134   2              username[SAL_FLSH_USR_USERNAME_LEN] = '\0';
 135   2          }
 136   1      
 137   1          WEB_VAR(pReq, "mpass", &pValue);
 138   1          if (pValue) {
 139   2              strncpy((char*)password, (char*)pValue, SAL_FLSH_USR_PASSWORD_LEN);
 140   2              password[SAL_FLSH_USR_PASSWORD_LEN] = '\0';
 141   2          }
 142   1      
 143   1          sal_flash_sysAccount_set(username, password);
 144   1      
 145   1          syslog_add_new_buf_entry(SYSLOG_MSG_PASSWORD_CHANGED, 0);
 146   1      
 147   1          get_user(pReq);
 148   1      
 149   1          return SUCCESS;
 150   1      }
