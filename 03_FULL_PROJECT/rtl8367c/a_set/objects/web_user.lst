 185          /*
 186           * send_str_web
 187           * Called by process_uart_string() for every VALID status frame.
 188           * Bounded copy into Get_Response, then marks the request as answered.
 189           */
 190          void send_str_web(uint8* tempData)
 191          {
 192   1          strncpy((char*)Get_Response, (char*)tempData, sizeof(Get_Response) - 1);
 193   1          Get_Response[sizeof(Get_Response) - 1] = '\0';
 194   1      
 195   1          status_waiting    = 0;
 196   1          status_wait_polls = 0;
 197   1      }
