 211   1      
 212   1          if (pReq->pPath) {
 213   2              path = (char*)pReq->pPath;
 214   2          } else if (pReq->path) {
 215   2              path = (char*)pReq->path;
 216   2          }
 217   1      
 218   1          if (!path) {
 219   2              WEB_BEGIN(pReq);
 220   2              WEB_STATUS(pReq, HTTP_STATUS_BAD_REQUEST);
 221   2              WEB_HEADER(pReq, "Content-Type: text/plain");
 222   2              WEB_PRINTF(pReq, "Error: No path");
 223   2              WEB_END(pReq);
 224   2              return FAILED;
 225   2          }
 226   1      
 227   1          /* /set_portX -> X */
 228   1          if (strncmp(path, "/set_port", 9) == 0) {
 229   2              port_num = atoi(path + 9);
