                  /* Check Port Valid */
                  RTK_CHK_PORT_IS_EXT(port);
              
                  if ((txDelay > 1) || (rxDelay > 7))
                      return RT_ERR_INPUT;
              
                  if(port == EXT_PORT0)
                      regAddr = RTL8367C_REG_EXT1_RGMXF;
                  else if(port == EXT_PORT1)
                      regAddr = RTL8367C_REG_EXT2_RGMXF;
                  else
                      return RT_ERR_INPUT;
              
                  if ((retVal = rtl8367c_getAsicReg(regAddr, &regData)) != RT_ERR_OK)
                      return retVal;
              
