             -ERR_OK)
                          return retVal;
              
                      if ((retVal = rtl8367c_setAsicRegBit(RTL8367C_REG_DW8051_RDY, RTL8367C_DW8051_READY_OFFSET, 0)) !=
             - RT_ERR_OK)
                          return retVal;
                  }
              
                  return RT_ERR_OK;
              }
              #endif
