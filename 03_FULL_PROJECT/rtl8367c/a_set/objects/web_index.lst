   3          #include <web/web_api.h>
   4          #include <web/http_debug.h>
   5          
   6          #include "web_index.h" 
   7          
   8          /*
   9           * Array: htm_index
  10           * ----------------
  11           * HTML page that auto-redirects to menu.cgi.
  12           * Uses meta refresh tag (0 second delay).
  13           * Sets charset to big5 for Chinese character support.
  14           * Displays brief "Redirecting..." message while redirecting.
  15           */
  16          uint8 const far htm_index[] = "\
  17          <html>\n\
  18          <head>\n\
  19          <meta HTTP-EQUIV=\"Content-Type\" CONTENT=\"text/html; charset=big5\">\n\
  20          <title>Original Web-Smart Switch</title>\n\
  21          <meta http-equiv=\"refresh\" content=\"0; URL=menu.cgi\">\n\
  22          </head>\n\
  23          <body>\n\
  24          <p>Redirecting to menu page...</p>\n\
  25          </body>\n\
  26          </html>\n\
  27          ";
  28          
  29          /*
  30           * Function: get_index
  31           * -------------------
  32           * Handles root path request ("/" or "/index.cgi").
  33           * Serves index page that auto-redirects to menu.
  34           * Sets proper Content-Type header for HTML.
  35           * Logs debug message when accessed.
  36           */
  37          int8 get_index(struct http_request_s *pReq)
  38          {
  39   1          DBG_LWPS_HTTP_PRINTF(("-------get_index()-------\n"));
  40   1      
  41   1          WEB_BEGIN(pReq);
  42   1          
  43   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
  44   1          WEB_HEADER(pReq, "Content-Type: text/html");
  45   1         
  46   1          WEB_DATA(pReq, htm_index, sizeof(htm_index) - 1);
  47   1          
  48   1          WEB_END(pReq);
  49   1      
  50   1          return SUCCESS;
  51   1      }
