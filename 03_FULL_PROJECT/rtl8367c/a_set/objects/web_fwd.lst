 373          /*
 374           * Function: post_fwd_jumboframe
 375           * -----------------------------
 376           * Processes Jumbo Frame configuration form submission.
 377           * Extracts selected frame size from POST data.
 378           * Calls sal_rate_maxFrameSize_set() to apply change.
 379           * Redirects back to GET handler to refresh the page.
 380           */
 381          int32 post_fwd_jumboframe(struct http_request_s *pReq)
 382          {
 383   1          int32 ret;
 384   1          uint8  *pValue;
 385   1          uint32 frameCode;
 386   1      
 387   1          frameCode = 0;
 388   1      
 389   1          WEB_VAR(pReq, "jumboframe", &pValue);
 390   1          if (pValue) {
 391   2              frameCode = atoi(pValue);
 392   2          }
 393   1      
 394   1          if ((ret =  sal_rate_maxFrameSize_set(frameCode)) != SAL_ERR_SUCCESS) 
 395   1          {
 396   2              printerr(pReq, ret);
 397   2              return SUCCESS;
 398   2          }
 399   1          
 400   1          get_fwd_jumboframe(pReq);
 401   1          return SUCCESS;
 402   1      }
