 117           /* Function Name:
 118            *      sal_gpio_input_get
 119            * Description:
 120            *      Get input value of GPIO
 121            * Input:
 122            *      gpio_index - index of GPIO
 123            * Output:
 124            *      pGpio_val  - gpio value
 125            * Return:
 126            *      SAL_ERR_SUCCESS
 127            *      SAL_ERR_PARAMETER
 128            * Note:
 129            *      None
 130            */
 131          int32 sal_gpio_input_get(sal_gpio_index_t gpio_index, uint8 *pGpio_val)
 132          {
 133   1          uint32 gpio;
 134   1          if(gpio_index >= SAL_GPIO_END)
 135   1                return SAL_ERR_PARAMETER;
 136   1      
 137   1          if(rtl8367c_getAsicGpioInput(gpio_index, &gpio) != SUCCESS)
 138   1              return SAL_ERR_NOT_SUPPORT;
 139   1      
 140   1          *pGpio_val = (uint8)gpio;
 141   1      
 142   1          return SAL_ERR_SUCCESS;
 143   1      }
