  52          /* Function Name:
  53           *      sal_gpio_dir_set
  54           * Description:
  55           *      Set direction of GPIO
  56           * Input:
  57           *      gpio_index - index of GPIO
  58           *      gpio_dir   - direction of GPIO
  59           * Output:
  60           *      None
  61           * Return:
  62           *      SAL_ERR_SUCCESS
  63           *      SAL_ERR_PARAMETER
  64           *      SAL_ERR_NOT_SUPPORT
  65           * Note:
  66           *      None
  67           */
  68          int32 sal_gpio_dir_set(sal_gpio_index_t gpio_index, sal_gpio_dir_t gpio_dir)
  69          {
  70   1          uint8  dir;
  71   1      
  72   1          if(gpio_index >= SAL_GPIO_END || gpio_dir >= SAL_GPIO_DIR_END)
  73   1              return SAL_ERR_PARAMETER;
  74   1      
  75   1          if(SAL_GPIO_DIR_INPUT == gpio_dir)
  76   1              dir = 0;
  77   1          else if(SAL_GPIO_DIR_OUTPUT == gpio_dir)
  78   1              dir = 1;
  79   1      
  80   1          if(rtl8367c_setAsicGpioMode(gpio_index, dir) != SUCCESS)
  81   1              return SAL_ERR_NOT_SUPPORT;
  82   1      
  83   1          return SAL_ERR_SUCCESS;
  84   1      }
  85           
  86           /* Function Name:
  87            *      sal_gpio_output_set
  88            * Description:
  89            *      Set output value of GPIO
  90            * Input:
  91            *      gpio_index - index of GPIO
  92            *      gpio_val   - value of output
  93            * Output:
  94            *      None
  95            * Return:
  96            *      SAL_ERR_SUCCESS
  97            *      SAL_ERR_PARAMETER
  98            *      SAL_ERR_NOT_SUPPORT
  99            * Note:
 100            *      None
 101            */
 102           int32 sal_gpio_output_set(sal_gpio_index_t gpio_index, uint8 gpio_val)
 103          {
 104   1          uint32 gpio;
 105   1          
 106   1          if(gpio_index >= SAL_GPIO_END || gpio_val > 1)
 107   1               return SAL_ERR_PARAMETER;
 108   1      
 109   1          gpio = gpio_val;
 110   1          if(rtl8367c_setAsicGpioOutput(gpio_index, gpio_val) != SUCCESS)
 111   1              return SAL_ERR_NOT_SUPPORT;
 112   1      
 113   1          return SAL_ERR_SUCCESS;
