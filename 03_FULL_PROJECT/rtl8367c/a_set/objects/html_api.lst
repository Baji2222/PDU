  78          /*
  79           * Function: set_mac
  80           * Description: Handles setting MAC address if current MAC is the default one (01:02:03:04:05:06)
  81           */
  82          // Set MAC: Handles MAC address configuration via web interface
  83          // Parses MAC string from POST data and updates system MAC if default
  84          int32 set_mac(struct http_request_s *pReq)
  85          {
  86   1          uint8 *pValue;
  87   1          sal_mac_t current_mac;
  88   1          sal_mac_t new_mac;
  89   1          uint8 mac_str[18];
  90   1          uint8 i, j, val;
  91   1          uint8 is_default_mac = TRUE;
  92   1          
  93   1          /* Get current MAC address */
  94   1          sal_sys_mac_get(&current_mac);
  95   1          
  96   1          /* Check if current MAC is the default MAC (01:02:03:04:05:06) */
  97   1          if (!(current_mac.octet[0] == 0xA4 && 
  98   1                current_mac.octet[1] == 0xDA && 
  99   1                current_mac.octet[2] == 0x22 && 
 100   1                current_mac.octet[3] == 0x52 && 
 101   1                current_mac.octet[4] == 0x00 && 
 102   1                current_mac.octet[5] == 0x00)) {
 103   2              is_default_mac = FALSE;
 104   2          }
 105   1          
 106   1          /* Handle POST request */
 107   1          WEB_VAR(pReq, "mac", &pValue);
 108   1          
 109   1          if (pValue && is_default_mac) {
 110   2              /* Convert MAC string (format: XX:XX:XX:XX:XX:XX) to bytes */
 111   2              memset(mac_str, 0, sizeof(mac_str));
 112   2              strncpy(mac_str, pValue, sizeof(mac_str) - 1);
 113   2              
C51 COMPILER V9.60.0.0   HTML_API                                                          11/03/2026 14:15:56 PAGE 3   

 114   2              /* Parse MAC address */
 115   2              for (i = 0, j = 0; i < 6; i++, j += 3) {
 116   3                  if ((mac_str[j] >= '0') && (mac_str[j] <= '9'))
 117   3                      val = (mac_str[j] - '0') << 4;
 118   3                  else if ((mac_str[j] >= 'a') && (mac_str[j] <= 'f'))
 119   3                      val = (mac_str[j] - 'a' + 10) << 4;
 120   3                  else if ((mac_str[j] >= 'A') && (mac_str[j] <= 'F'))
 121   3                      val = (mac_str[j] - 'A' + 10) << 4;
 122   3                  else
 123   3                      val = 0;
 124   3                  
 125   3                  if ((mac_str[j+1] >= '0') && (mac_str[j+1] <= '9'))
 126   3                      val |= (mac_str[j+1] - '0');
 127   3                  else if ((mac_str[j+1] >= 'a') && (mac_str[j+1] <= 'f'))
 128   3                      val |= (mac_str[j+1] - 'a' + 10);
 129   3                  else if ((mac_str[j+1] >= 'A') && (mac_str[j+1] <= 'F'))
 130   3                      val |= (mac_str[j+1] - 'A' + 10);
 131   3                  
 132   3                  new_mac.octet[i] = val;
 133   3              }
 134   2              
 135   2              /* Set the new MAC address */
 136   2              sal_sys_mac_set(&new_mac);
 137   2              sal_flash_sysMac_set(&new_mac);
 138   2              
 139   2              /* Return success response */
 140   2              WEB_BEGIN(pReq);
 141   2              WEB_STATUS(pReq, HTTP_STATUS_OK);
 142   2              WEB_HEADER(pReq, "Content-Type: text/plain");
 143   2              WEB_HEADER(pReq, "Access-Control-Allow-Origin: *");
 144   2              WEB_HEADER(pReq, "Access-Control-Allow-Methods: GET, POST, OPTIONS");
 145   2              WEB_HEADER(pReq, "Access-Control-Allow-Headers: Content-Type");
 146   2              WEB_PRINTF(pReq, "MAC_SET_SUCCESS");
 147   2              WEB_END(pReq);
 148   2              
 149   2              return SUCCESS;
 150   2          } else {
 151   2              /* Return error response */
 152   2              WEB_BEGIN(pReq);
 153   2              WEB_STATUS(pReq, HTTP_STATUS_OK);
 154   2              WEB_HEADER(pReq, "Content-Type: text/plain");
 155   2              WEB_HEADER(pReq, "Access-Control-Allow-Origin: *");
 156   2              WEB_HEADER(pReq, "Access-Control-Allow-Methods: GET, POST, OPTIONS");
 157   2              WEB_HEADER(pReq, "Access-Control-Allow-Headers: Content-Type");
 158   2              WEB_PRINTF(pReq, "MAC_SET_NOT_ALLOWED");
 159   2              WEB_END(pReq);
 160   2              
 161   2              return SUCCESS;
 162   2          }
 163   1      }
