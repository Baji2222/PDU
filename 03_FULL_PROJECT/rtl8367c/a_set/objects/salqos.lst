             -recedence field of TOS. So if values of 
 584           *      DSCP are carefully chosen then backward compatibility can be achieved.    
 585           */
 586          // Sal QoS DSCP Pri Remap Get: Retrieves DSCP to internal priority mapping
 587          // Gets the internal priority value mapped from the specified DSCP
 588          int32 sal_qos_dscpPriRemap_get(sal_dscp_t dscp, sal_pri_t *pInt_pri)
