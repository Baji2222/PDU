              int32 sal_qos_dscpRemarkingEnable_get(sal_enable_t *pEnable)
              {
                  rtk_enable_t  enable;
                  rtk_api_ret_t ret;
                  
                  ret = rtk_qos_dscpRemarkEnable_get(RTK_WHOLE_SYSTEM, &enable);
                if(ret)
                      return ret;
                  
                  *pEnable = enable & 0xFF;
                  return SAL_ERR_SUCCESS;
                  
              }
              
