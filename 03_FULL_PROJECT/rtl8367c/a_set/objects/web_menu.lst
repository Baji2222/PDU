 277          /*
 278           * Function: get_menu
 279           * ------------------
 280           * Serves the main navigation menu page to the client.
 281           * Returns complete HTML with CSS styling and dropdown menus.
 282           * Sets Content-Type header for HTML and sends menu data.
 283           * Logs debug message when accessed.
 284           */
 285          int8 get_menu(struct http_request_s *pReq)
 286          {
 287   1          DBG_LWPS_HTTP_PRINTF(("-------get_menu()-------\n"));
 288   1      
 289   1          WEB_BEGIN(pReq);
 290   1      
 291   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
 292   1          WEB_HEADER(pReq, "Content-Type: text/html");
 293   1      
 294   1          WEB_DATA(pReq, htm_menu, sizeof(htm_menu) - 1);
 295   1      
 296   1          WEB_END(pReq);
 297   1      
 298   1          return SUCCESS;
 299   1      }


