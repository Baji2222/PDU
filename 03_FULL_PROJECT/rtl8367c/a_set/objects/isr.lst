 212   1          static uint8    debounceTime;
 213   1      #endif
 214   1          event_list &= (~TIMER_100MS_EVENT);
 215   1      #if 1//LWPS_RESET
 216   1          sal_gpio_input_get(SAL_GPIO_ONCHIP_39, &current_input);    
 217   1      
 218   1          if(current_input)
 219   1              current_input = 1;
 220   1      
 221   1          switch(gpio_state)
 222   1          {
 223   2          case GPIO_INPUT_NORMAL:
 224   2              /* detect the pressed event, start to count pressed time */
 225   2              if(GPIO_PRESSED == current_input)
 226   2              {
 227   3                  gpio_state = GPIO_INPUT_PRESSED;
 228   3                  pressedTime = 0;
 229   3              }
 230   2              break;
 231   2          case GPIO_INPUT_PRESSED:
 232   2              pressedTime++;
 233   2              /* detect the release event, start to count debounce time */
 234   2              if(GPIO_RELEASED == current_input)
 235   2              {
 236   3                  gpio_state = GPIO_INPUT_RELEASED;
 237   3                  debounceTime = 0;
