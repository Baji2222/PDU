 238   3              }
 239   2              /* pressed for more than 3s */
 240   2              if(pressedTime > GPIO_RESET_TIME)
 241   2              {
 242   3                  sal_flash_cfg_reset();
 243   3                  sal_sys_system_reboot();
 244   3              }
 245   2              break;
 246   2          case GPIO_INPUT_RELEASED:
 247   2              pressedTime++;
 248   2              /* continue to count debounce time */
 249   2              if(GPIO_RELEASED == current_input)
 250   2              {
 251   3                  debounceTime++;
 252   3                  /* debounce time end, check result */
 253   3                  if(debounceTime >= GPIO_DEBOUNCE_TIME_MAX)
 254   3                  {
 255   4          gpio_state = GPIO_INPUT_NORMAL;
 256   4      
 257   4                      /* reverse pressed time to the moment that GPIO is released */
 258   4                      pressedTime -= GPIO_DEBOUNCE_TIME_MAX;
 259   4      
 260   4                      /* pressed under 1s */
