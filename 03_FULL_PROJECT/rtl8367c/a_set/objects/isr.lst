 262   4                      {
 263   5                          setReg(0x1322, 1);
 264   5                      }
 265   4                  }
 266   3              }
 267   2              else
 268   2              {
 269   3                  gpio_state = GPIO_INPUT_PRESSED;
 270   3              }
 271   2              break;
 272   2          }
 273   1      #endif
 274   1      }
