 195          // Timer 100ms DSR: Handles GPIO button debounce and factory reset detection
 196          // Monitors GPIO for press events and triggers reset or factory reset based on press duration
 197          void timer_100ms_dsr()
 198          {
 199   1      #define GPIO_DEBOUNCE_TIME_MAX  5   /* debounce time: 500ms */
 200   1      #define GPIO_REBOOT_TIME        10  /* 1s */
 201   1      #define GPIO_INPUT_NORMAL       0
 202   1      #define GPIO_INPUT_PRESSED      1
 203   1      #define GPIO_INPUT_RELEASED     2
 204   1      #define GPIO_PRESSED            0
 205   1      #define GPIO_RELEASED           1
