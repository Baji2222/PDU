  24          /*
  25           * putchar (full version):  expands '\n' into CR LF and handles
  26           *                          XON/XOFF (Ctrl+S/Ctrl+Q) protocol
  27           */
  28          char putchar (char c)  {
  29   1          if (c == '\n')  
  30   1        {
  31   2              if (RI)  
  32   2          {
  33   3                  if (SBUF0 == XOFF)  
  34   3            {
  35   4                      do  
  36   4              {
  37   5                          RI = 0;
  38   5                          while (!RI);
  39   5                      }
  40   4                      while (SBUF0 != XON);
  41   4                          RI = 0;
  42   4                  }
  43   3              }
  44   2              while (!TI);
  45   2                  TI = 0;
  46   2              SBUF0 = 0x0d;                         /* output CR  */
  47   2          }
  48   1          if (RI)  
  49   1        {
  50   2              if (SBUF0 == XOFF)  
  51   2          {
