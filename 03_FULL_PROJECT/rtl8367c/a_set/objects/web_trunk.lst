 224          /*
 225           * Function: post_trunk_remove
 226           * ---------------------------
 227           * Processes trunk group deletion from form submission.
 228           * Scans all trunk IDs for checkbox named "remove_X".
 229           * Calls sal_trunk_port_del() for each selected trunk.
 230           * Refreshes trunk page after deletion.
 231           */
C51 COMPILER V9.60.0.0   WEB_TRUNK                                                         11/02/2026 17:57:37 PAGE 5   

 232          int32 post_trunk_remove (struct http_request_s *pReq)
 233          {
 234   1          int32           ret;
 235   1          uint8           trunkId = 0;
 236   1          uint8           *pValue;
 237   1          uint8           removeStr[32];
 238   1      
 239   1          for (trunkId = 0; trunkId < SAL_MAX_STATIC_TRUNK; ++trunkId) {
 240   2              sprintf(removeStr, "remove_%bu", trunkId);
 241   2              WEB_VAR(pReq, removeStr, &pValue);
 242   2              if (pValue) {
 243   3                  if ((ret = sal_trunk_port_del(trunkId)) != SAL_ERR_SUCCESS)
 244   3                  {
 245   4                      printerr(pReq, ret);
 246   4                      return SUCCESS;
 247   4                  }
 248   3              }
 249   2          }
 250   1      
 251   1      
 252   1          get_trunk(pReq);
 253   1      
 254   1          return SUCCESS;
 255   1      }


