 177          /*
 178           * Function: post_trunk
 179           * --------------------
 180           * Processes trunk group creation/modification form submission.
 181           * Extracts trunk ID and selected ports from POST data.
 182           * Handles both Port and Trunk selections from multiple select.
 183           * Calls sal_trunk_port_set() to apply trunk configuration.
 184           */
 185          int32 post_trunk (struct http_request_s *pReq)
 186          {
 187   1          sal_pPortmask_t portmask;
 188   1          int32           ret;
 189   1          uint8           *pValue;
 190   1          uint8           trunkId = 0;
 191   1          
 192   1          sal_pPortMask_delAll(&portmask);
 193   1      
 194   1          WEB_VAR(pReq, "id", &pValue);
 195   1          if (pValue) {
 196   2              trunkId = atoi(pValue) - 1 ;
 197   2          }
 198   1      
 199   1          WEB_VAR(pReq, "ports", &pValue);
 200   1          if (pValue) {
 201   2              sal_pPortMask_addPort(&portmask, atoi(pValue));
 202   2          }
 203   1      
 204   1          while(pValue != NULL)
 205   1          {
 206   2              WEB_VAR(pReq, NULL, &pValue);
 207   2              if (pValue) {
 208   3                  sal_pPortMask_addPort(&portmask, atoi(pValue));
 209   3              }
 210   2          }
 211   1      
 212   1          if ((ret = sal_trunk_port_set(trunkId, FALSE, &portmask, &portmask)) != SAL_ERR_SUCCESS)
 213   1          {
 214   2              printerr(pReq, ret);
 215   2              return SUCCESS;
 216   2          }
 217   1      
 218   1          
 219   1          get_trunk(pReq);
 220   1      
 221   1          return SUCCESS;
 222   1      }
