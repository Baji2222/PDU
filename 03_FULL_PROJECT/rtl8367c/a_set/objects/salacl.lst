 295          /* Function Name:
 296           *      sal_filter_igrAcl_field_add
 297           * Description:
 298           *      Add comparison rule to an ACL configuration
 299           * Input:
 300           *      pFilter_cfg     - The ACL configuration that this function will add comparison rule
 301           *      pFilter_field   - The comparison rule that will be added.
 302           * Output:
 303           *      None
 304           * Return:
 305           *      RT_ERR_OK               - OK
 306           *      RT_ERR_FAILED           - Failed
 307           *      RT_ERR_SMI              - SMI access error
 308           *      RT_ERR_NULL_POINTER     - Pointer pFilter_field or pFilter_cfg point to NULL.
 309           *      RT_ERR_INPUT            - Invalid input parameters.
 310           * Note:
 311           *      This function add a comparison rule (*pFilter_field) to an ACL configuration (*pFilter_cfg).
 312           *      Pointer pFilter_cfg points to an ACL configuration structure, this structure keeps multiple ACL
 313           *      comparison rules by means of linked list. Pointer pFilter_field will be added to linked
 314           *      list keeped by structure that pFilter_cfg points to.
 315           */
 316          rtk_api_ret_t sal_filter_igrAcl_field_add(rtk_filter_cfg_t* pFilter_cfg, rtk_filter_field_t* pFilter_field
             -)
 317          {
 318   1          uint32 i;
 319   1          rtk_filter_field_t *tailPtr;
 320   1      
 321   1          /* Check initialization state */
 322   1          RTK_CHK_INIT_STATE();
 323   1      
 324   1          if(NULL == pFilter_cfg || NULL == pFilter_field)
 325   1              return RT_ERR_NULL_POINTER;
 326   1      
 327   1          if(pFilter_field->fieldType >= FILTER_FIELD_END)
 328   1              return RT_ERR_ENTRY_INDEX;
 329   1      
 330   1      
 331   1          if(0 == pFilter_field->fieldTemplateNo)
 332   1          {
 333   2              pFilter_field->fieldTemplateNo = filter_fieldSize[pFilter_field->fieldType];
 334   2      
 335   2              for(i = 0; i < pFilter_field->fieldTemplateNo; i++)
 336   2              {
 337   3                  pFilter_field->fieldTemplateIdx[i] = filter_fieldTemplateIndex[pFilter_field->fieldType][i];
 338   3              }
 339   2          }
 340   1      
 341   1          if(NULL == pFilter_cfg->fieldHead)
 342   1          {
 343   2              pFilter_cfg->fieldHead = pFilter_field;
 344   2          }
 345   1          else
 346   1          {
 347   2              if (pFilter_cfg->fieldHead->next == NULL)
 348   2              {
C51 COMPILER V9.60.0.0   SALACL                                                            11/03/2026 14:15:39 PAGE 7   

 349   3                  pFilter_cfg->fieldHead->next = pFilter_field;
 350   3              }
 351   2              else
 352   2              {
 353   3                  tailPtr = pFilter_cfg->fieldHead->next;
 354   3                  while( tailPtr->next != NULL)
 355   3                  {
 356   4                      tailPtr = tailPtr->next;
 357   4                  }
 358   3                  tailPtr->next = pFilter_field;
 359   3              }
 360   2          }
 361   1      
 362   1          return RT_ERR_OK;
 363   1      }
