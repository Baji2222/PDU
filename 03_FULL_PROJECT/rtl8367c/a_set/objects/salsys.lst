 459          // Sal Sys IP Get: Retrieves current IP address and netmask
 460          // Converts byte arrays to 32-bit IP and netmask values
 461          int32 sal_sys_ip_get(sal_ipaddr_t *pIp, sal_ipaddr_t *pNetmask)
 462          {
 463   1          if(NULL == pIp || NULL == pNetmask)
 464   1              return SAL_ERR_NULL_POINTER;
 465   1      
 466   1          *pIp = ((uint32)this_ip[0] << 24) | ((uint32)this_ip[1] << 16) | ((uint32)this_ip[2] << 8) \
 467   1              | (uint32)this_ip[3];
 468   1          *pNetmask = ((uint32)netmask[0] << 24) | ((uint32)netmask[1] << 16) | ((uint32)netmask[2] << 8) \
 469   1              | (uint32)netmask[3];
 470   1      
 471   1          return SAL_ERR_SUCCESS;    
 472   1      }
