 438          // Sal Sys IP Set: Sets IP address and netmask, writes to flash
 439          // Converts IP to byte array and persists to flash configuration
 440          int32
 441          sal_sys_ip_set (
 442              sal_ipaddr_t ip,
 443              sal_ipaddr_t net_mask
 444              )
 445          {
 446   1          this_ip[0] = (ip & 0xFF000000) >> 24;
 447   1          this_ip[1] = (ip & 0x00FF0000) >> 16;
 448   1          this_ip[2] = (ip & 0x0000FF00) >> 8;
 449   1          this_ip[3] = (ip & 0x000000FF) >> 0;
 450   1          netmask[0] = (net_mask & 0xFF000000) >> 24;
 451   1          netmask[1] = (net_mask & 0x00FF0000) >> 16;
 452   1          netmask[2] = (net_mask & 0x0000FF00) >> 8;
 453   1          netmask[3] = (net_mask & 0x000000FF) >> 0;
 454   1      
 455   1          sal_flash_sysIp_set(ip, net_mask);
 456   1          return SAL_ERR_SUCCESS;
 457   1      }
