 103          /*
 104           * Function: post_eee
 105           * ------------------
 106           * Processes EEE configuration form submission.
 107           * Extracts 'func_type' value from POST data, converts to integer.
 108           * Calls sal_eee_set() to enable/disable EEE feature.
 109           * Redirects back to GET handler to refresh the page.
 110           */
 111          int32 post_eee(struct http_request_s *pReq)
 112          {
 113   1          uint8           *pValue;
C51 COMPILER V9.60.0.0   WEB_EEE                                                           11/03/2026 14:15:57 PAGE 3   

 114   1          uint8           enable;
 115   1      
 116   1          WEB_VAR(pReq, "func_type", &pValue);
 117   1          if (pValue) {
 118   2              enable = atoi(pValue);
 119   2          }
 120   1      
 121   1          if(enable)
 122   1              sal_eee_set(SAL_ENABLED);
 123   1          else
 124   1              sal_eee_set(SAL_DISABLED);
 125   1      
 126   1          
 127   1          get_eee(pReq);
 128   1      
 129   1          return SUCCESS;
 130   1      }
