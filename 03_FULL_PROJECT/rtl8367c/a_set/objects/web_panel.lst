  46          /*
  47           * Function: get_panel
  48           * -------------------
  49           * Displays the main panel page with "OPL SMART PDU RACK" title.
  50           * Uses clean, centered design with beetroot red colored heading.
  51           * Sets up full viewport height with flexbox centering.
C51 COMPILER V9.60.0.0   WEB_PANEL                                                         11/03/2026 14:16:01 PAGE 2   

  52           * Serves as the default landing/display page for the switch.
  53           */
  54          int32 get_panel(struct http_request_s *pReq)
  55          {
  56   1          WEB_BEGIN(pReq);
  57   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
  58   1          WEB_HEADER(pReq, "Content-Type: text/html");
  59   1         WEB_PRINTF(pReq, "<html>\n");
  60   1      WEB_PRINTF(pReq, "<head>\n");
  61   1      WEB_PRINTF(pReq, "<style>\n");
  62   1      WEB_PRINTF(pReq, "body {\n");
  63   1      WEB_PRINTF(pReq, "font-family: 'Arial', sans-serif;\n");
  64   1      WEB_PRINTF(pReq, "display: flex;\n");
  65   1      WEB_PRINTF(pReq, "justify-content: center;\n");
  66   1      WEB_PRINTF(pReq, "align-items: center;\n");
  67   1      WEB_PRINTF(pReq, "height: 100vh;\n");
  68   1      WEB_PRINTF(pReq, "margin: 0;\n");
  69   1      WEB_PRINTF(pReq, "background-color: #f4f4f9;\n");
  70   1      WEB_PRINTF(pReq, "}\n");
  71   1      WEB_PRINTF(pReq, "h1 {\n");
  72   1      WEB_PRINTF(pReq, "color: #8a0303; /* Beetroot red */\n");
  73   1      WEB_PRINTF(pReq, "font-size: 3rem;\n");
  74   1      WEB_PRINTF(pReq, "text-align: center;\n");
  75   1      WEB_PRINTF(pReq, "text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);\n");
  76   1      WEB_PRINTF(pReq, "letter-spacing: 2px;\n");
  77   1      WEB_PRINTF(pReq, "font-weight: bold;\n");
  78   1      WEB_PRINTF(pReq, "}\n");
  79   1      WEB_PRINTF(pReq, "</style>\n");
  80   1      WEB_PRINTF(pReq, "</head>\n");
  81   1      WEB_PRINTF(pReq, "<body>\n");
  82   1      WEB_PRINTF(pReq, "<h1>OPL SMART PDU RACK</h1>\n");
  83   1      WEB_PRINTF(pReq, "</body>\n");
  84   1      WEB_PRINTF(pReq, "</html>\n");
  85   1      WEB_PRINTF(pReq, "\n");
  86   1          WEB_END(pReq);
  87   1          return SUCCESS;
  88   1      }


