              /* Function Name:
               *      rtl8367c_getAsicIGMPGroup
               * Description:
               *      Get IGMP group
               * Input:
               *      idx     - Group index (0~255)
               *      valid   - valid bit
               *      grp     - IGMP group
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK               - Success
               *      RT_ERR_SMI              - SMI access error
               *      RT_ERR_OUT_OF_RANGE     - Group index is out of range
               * Note:
               *      None
               */
              ret_t rtl8367c_getAsicIGMPGroup(uint32 idx, uint32 *valid, rtl8367c_igmpgroup *grp)
              {
                  ret_t   retVal;
                  uint32  regAddr, regData;
                  uint32  i;
                  uint32  groupInfo = 0;
              
                  if(idx > RTL8367C_IGMP_MAX_GOUP)
                      return RT_ERR_OUT_OF_RANGE;
              
                  /* Write ACS_ADR register for data bits */
                  regAddr = RTL8367C_TABLE_ACCESS_ADDR_REG;
                  regData = idx;
                  retVal = rtl8367c_setAsicReg(regAddr, regData);
                  if(retVal != RT_ERR_OK)
                      return retVal;
              
                  /* Write ACS_CMD register */
                  regAddr = RTL8367C_TABLE_ACCESS_CTRL_REG;
                  regData = RTL8367C_TABLE_ACCESS_REG_DATA(TB_OP_READ, TB_TARGET_IGMP_GROUP);
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_IGMP                                             11/03/2026 14:15:45 PAGE 29  

                  retVal = rtl8367c_setAsicRegBits(regAddr, RTL8367C_TABLE_TYPE_MASK | RTL8367C_COMMAND_TYPE_MASK, regDa
             -ta);
                  if(retVal != RT_ERR_OK)
                      return retVal;
              
                  /* Read Data Bits */
                  regAddr = RTL8367C_TABLE_ACCESS_RDDATA_BASE;
                  for(i = 0 ;i <= 1; i++)
                  {
                      retVal = rtl8367c_getAsicReg(regAddr, &regData);
                      if(retVal != RT_ERR_OK)
                          return retVal;
              
                      groupInfo |= ((regData & 0xFFFF) << (i * 16UL));
                      regAddr ++;
                  }
              
                  grp->p0_timer = groupInfo & 0x00000007;
                  grp->p1_timer = (groupInfo >> 3UL) & 0x00000007;
                  grp->p2_timer = (groupInfo >> 6UL) & 0x00000007;
                  grp->p3_timer = (groupInfo >> 9UL) & 0x00000007;
                  grp->p4_timer = (groupInfo >> 12UL) & 0x00000007;
                  grp->p5_timer = (groupInfo >> 15UL) & 0x00000007;
                  grp->p6_timer = (groupInfo >> 18UL) & 0x00000007;
                  grp->p7_timer = (groupInfo >> 21UL) & 0x00000007;
                  grp->report_supp_flag = (groupInfo >> 24UL) & 0x00000001;
                  grp->p8_timer = (groupInfo >> 25UL) & 0x00000007;
                  grp->p9_timer = (groupInfo >> 28UL) & 0x00000007;
                  grp->p10_timer = (groupInfo >> 31UL) & 0x00000001;
              
                  regAddr = RTL8367C_TABLE_ACCESS_RDDATA_BASE + 2;
                  retVal = rtl8367c_getAsicReg(regAddr, &regData);
                  if(retVal != RT_ERR_OK)
                      return retVal;
              
                  grp->p10_timer |= (regData & 0x00000003) << 1UL;
              
                  /* Valid bit */
                  retVal = rtl8367c_getAsicReg(RTL8367C_IGMP_GROUP_USAGE_REG(idx), &regData);
                  if(retVal != RT_ERR_OK)
                      return retVal;
              
                  *valid = ((regData & (1UL << (idx %16))) != 0UL) ? 1UL : 0UL;
              
                  return RT_ERR_OK;
              }
