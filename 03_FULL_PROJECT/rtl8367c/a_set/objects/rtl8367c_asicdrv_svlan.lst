                          case 10:
                              retVal = rtl8367c_setAsicRegBits(RTL8367C_REG_SVLAN_PORTBASED_SVIDX_CTRL5, RTL8367C_SVLAN_
             -PORTBASED_SVIDX_CTRL5_MASK,index);
                              break;
                      }
                  }
              
                  return retVal;
              }
