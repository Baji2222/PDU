              ret_t rtl8367c_setAsicSvlanMemberConfiguration(uint32 index, rtl8367c_svlan_memconf_t* pSvlanMemCfg)
              {
                  ret_t retVal;
                  uint32 regAddr, regData;
                  uint16 *accessPtr;
                  uint32 i;
                  uint16 smiSvlanMemConf[RTL8367C_SVLAN_MEMCONF_LEN];
              
                  if(index > RTL8367C_SVIDXMAX)
