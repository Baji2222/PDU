             -TxLengthMode)) != RT_ERR_OK)
                      return retVal;
              
                  if( (retVal = rtl8367c_getAsicRegBit(RTL8367C_REG_MIB_RMON_LEN_CTRL, RTL8367C_RX_LENGTH_CTRL_OFFSET, p
             -RxLengthMode)) != RT_ERR_OK)
                      return retVal;
              
                  return RT_ERR_OK;
              }
              #endif
