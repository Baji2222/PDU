  21          /* Function Name:
  22           *      rtl8367c_setAsicPortIsolationPermittedPortmask
  23           * Description:
  24           *      Set permitted port isolation portmask
  25           * Input:
  26           *      port            - Physical port number (0~10)
  27           *      permitPortmask  - port mask
  28           * Output:
  29           *      None
  30           * Return:
  31           *      RT_ERR_OK           - Success
  32           *      RT_ERR_SMI          - SMI access error
  33           *      RT_ERR_PORT_ID      - Invalid port number
  34           *      RT_ERR_PORT_MASK    - Invalid portmask
  35           * Note:
  36           *      None
  37           */
  38          ret_t rtl8367c_setAsicPortIsolationPermittedPortmask(uint32 port, uint32 permitPortmask)
  39          {
  40   1          if(port >= RTL8367C_PORTNO)
  41   1              return RT_ERR_PORT_ID;
  42   1      
  43   1          if( permitPortmask > RTL8367C_PORTMASK)
  44   1              return RT_ERR_PORT_MASK;
  45   1      
  46   1          return rtl8367c_setAsicReg(RTL8367C_PORT_ISOLATION_PORT_MASK_REG(port), permitPortmask);
  47   1      }
  48          /* Function Name:
