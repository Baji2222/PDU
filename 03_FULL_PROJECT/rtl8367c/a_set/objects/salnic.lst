 148          /* Function Name:
 149           *      sal_nic_tx
 150           * Description:
 151           *      Send packet
 152           * Input:
 153           *      pktStrPtr - pointer to the packet structure.
 154           * Output:
 155           *      None
 156           * Return:
 157           *      SAL_ERR_SUCCESS
 158           *      SAL_ERR_FAILED
 159           * Note:
 160           *      None
 161           */
 162          int32 sal_nic_tx(void *pktStrPtr)
 163          {
 164   1          uint8           i, tmpPort;
 165   1          sal_port_t      rPort;
 166   1          sal_pPortmask_t txPort;
 167   1          pktBuf_t        *pBuf;
 168   1      
 169   1          pBuf = (pktBuf_t*)pktStrPtr;
 170   1          txPort.bits[0] = 0;
 171   1      
 172   1          if(pBuf->tx_dst_pmsk == 0)
 173   1          {
 174   2              /* TX buf initial */
 175   2              pBuf->tx_dport_mode    = TX_DPORT_DEFAULT;
C51 COMPILER V9.60.0.0   SALNIC                                                            11/03/2026 14:15:34 PAGE 4   

 176   2              pBuf->tx_trunk_support = TX_TRUNK_IGNORE;
 177   2              pBuf->pkt_cputag       = NULL;
 178   2              
 179   2              return  SAL_ERR_SUCCESS;
 180   2          }
 181   1          if(TX_DPORT_ASSIGN_PMSK == pBuf->tx_dport_mode && TX_TRUNK_REPRESENT_PORT == pBuf->tx_trunk_support)
 182   1          {
 183   2              for(i = 0; i < SAL_PORT_ID_CPU;i++)
 184   2              {
 185   3                  if((1UL << i) & pBuf->tx_dst_pmsk)
 186   3                  {
 187   4      #if defined(LWS_8G_2F)
                          if (i == EXT_PORT0){
                                  tmpPort = 8;
                          }
                          else if (i == EXT_PORT1){
                                  tmpPort = 9;          
                          }
                          else{
                                  tmpPort = i;
                          }
              #elif defined(LWS_5G_1F) 
                          if (i == EXT_PORT0){
                                  tmpPort = 6;
                          }
                          else{
                                  tmpPort = i;
                          }           
              #else
 205   4                  tmpPort = i;
 206   4      #endif
 207   4                      sal_trunk_representPort_get((sal_port_t)tmpPort, &rPort);            
 208   4                      txPort.bits[0] |= (1UL << rPort);
 209   4                  }
 210   3              }
 211   2          }
 212   1      
 213   1          pBuf->tx_dst_pmsk = txPort.bits[0];
 214   1      
 215   1          /* Add inner VLAN tag,
 216   1           *  - Assume the pBuf->pkt_vlantag pointer to inner vlan start 
 217   1           *  - or pBuf->pkt_vlantag == NULL if there is no vlan tag in pBuf 
 218   1           */
 219   1          if(((pBuf->inner_tag_mode & TX_VLAN_ASSIGN_VID) == TX_VLAN_ASSIGN_VID) &&
 220   1              (pBuf->inner_tag != SAL_NIC_NULL_VID))
 221   1          {
 222   2              if(NULL == pBuf->pkt_vlantag)
 223   2              {
 224   3                  for( i = 0; i < MAC_ADDR_LEN * 2; i++)
 225   3                  {
 226   4                      *(pBuf->l2 + i - VLAN_TAG_SIZE) = *(pBuf->l2 + i);
 227   4                  }
 228   3                  pBuf->l2 -= VLAN_TAG_SIZE;
 229   3                  pBuf->size += VLAN_TAG_SIZE;
 230   3                  pBuf->pkt_vlantag = pBuf->l2 + MAC_ADDR_LEN * 2;
 231   3                  pBuf->pkt_head = pBuf->l2;
 232   3              }
 233   2      
 234   2              /* insert VLAN tag */
 235   2              *(pBuf->pkt_vlantag + 0) = 0x81;
 236   2              *(pBuf->pkt_vlantag + 1) = 0x00;
 237   2              *(pBuf->pkt_vlantag + 2) = ((pBuf->inner_tag & 0x0f00) >> 8);
C51 COMPILER V9.60.0.0   SALNIC                                                            11/03/2026 14:15:34 PAGE 5   

 238   2              *(pBuf->pkt_vlantag + 3) = pBuf->inner_tag & 0xff;
 239   2          }
