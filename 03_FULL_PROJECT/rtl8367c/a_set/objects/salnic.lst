 131           *      None
 132           */
 133          int32 sal_nic_tx_init(void *pktStrPtr)
 134          {
 135   1          pktBuf_t *pBuf;
 136   1      
 137   1          if(NULL == pktStrPtr)
 138   1              return SAL_ERR_NULL_POINTER;
 139   1      
 140   1          pBuf = pktStrPtr;
 141   1          pBuf->pkt_head = p_tx_buffer;
 142   1          pBuf->pkt_head += TAG_SIZE+FRAME_INFO_SIZE;
 143   1          pBuf->l2 = pBuf->pkt_head;
 144   1      
 145   1          return SAL_ERR_SUCCESS;
 146   1      }
