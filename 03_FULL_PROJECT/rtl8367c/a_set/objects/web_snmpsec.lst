 169          /*
 170           * Function: post_snmpsec
 171           * ----------------------
 172           * Processes SNMP security configuration form submission.
 173           * Extracts community strings, system info, and trap IP from POST.
 174           * Validates IP format using str_to_ip() function.
 175           * Saves all SNMP settings to flash and updates system configuration.
 176           */
 177          int32 post_snmpsec(struct http_request_s *pReq)
 178          {
