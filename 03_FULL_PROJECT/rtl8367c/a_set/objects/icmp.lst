                  DBG_LWPS_ICMP_PRINTF(" Identifier: 0x%04X\n", (uint16)pIcmpHdr->identifier);
                  DBG_LWPS_ICMP_PRINTF(" Seq-Number: 0x%04X (%d)\n", (uint16)pIcmpHdr->seq_number, (uint16)pIcmpHdr->seq
