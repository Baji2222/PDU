 475           * Note:
 476           *      None
 477           */
 478          ret_t rtl8367c_getAsicPortEgressRate(uint32 port, uint32 *rate)
 479          {
 480   1          ret_t retVal;
 481   1          uint32 regAddr, regData,regData2;
 482   1      
 483   1          if(port > RTL8367C_PORTIDMAX)
 484   1              return RT_ERR_PORT_ID;
 485   1      
 486   1          regAddr = RTL8367C_PORT_EGRESSBW_LSB_REG(port);
 487   1      
 488   1          retVal = rtl8367c_getAsicReg(regAddr, &regData);
 489   1          if(retVal != RT_ERR_OK)
 490   1              return retVal;
 491   1      
 492   1          regAddr = RTL8367C_PORT_EGRESSBW_MSB_REG(port);
 493   1          retVal = rtl8367c_getAsicRegBits(regAddr, RTL8367C_PORT6_EGRESSBW_CTRL1_MASK, &regData2);
 494   1          if(retVal != RT_ERR_OK)
 495   1              return retVal;
 496   1      
 497   1          *rate = regData | (regData2 << RTL8367C_QOS_GRANULARTY_MSB_OFFSET);
 498   1      
 499   1          return RT_ERR_OK;
 500   1      }
 501          #endif
