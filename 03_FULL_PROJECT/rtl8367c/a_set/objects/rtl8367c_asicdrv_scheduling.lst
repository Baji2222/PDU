 418          /* Function Name:
 419           *      rtl8367c_setAsicPortEgressRate
 420           * Description:
 421           *      Set per-port egress rate
 422           * Input:
 423           *      port        - Physical port number (0~10)
 424           *      rate        - Egress rate
 425           * Output:
 426           *      None
 427           * Return:
 428           *      RT_ERR_OK           - Success
 429           *      RT_ERR_SMI          - SMI access error
 430           *      RT_ERR_PORT_ID      - Invalid port number
 431           *      RT_ERR_QOS_EBW_RATE - Invalid bandwidth/rate
 432           * Note:
 433           *      None
 434           */
 435          ret_t rtl8367c_setAsicPortEgressRate(uint32 port, uint32 rate)
 436          {
 437   1          ret_t retVal;
 438   1          uint32 regAddr, regData;
 439   1      
 440   1          if(port > RTL8367C_PORTIDMAX)
 441   1              return RT_ERR_PORT_ID;
 442   1      
 443   1          if(rate > RTL8367C_QOS_GRANULARTY_MAX)
 444   1              return RT_ERR_QOS_EBW_RATE;
 445   1      
 446   1          regAddr = RTL8367C_PORT_EGRESSBW_LSB_REG(port);
 447   1          regData = RTL8367C_QOS_GRANULARTY_LSB_MASK & rate;
 448   1      
 449   1          retVal = rtl8367c_setAsicReg(regAddr, regData);
 450   1      
 451   1          if(retVal != RT_ERR_OK)
 452   1              return retVal;
 453   1      
 454   1          regAddr = RTL8367C_PORT_EGRESSBW_MSB_REG(port);
 455   1          regData = (RTL8367C_QOS_GRANULARTY_MSB_MASK & rate) >> RTL8367C_QOS_GRANULARTY_MSB_OFFSET;
 456   1      
 457   1          retVal = rtl8367c_setAsicRegBits(regAddr, RTL8367C_PORT6_EGRESSBW_CTRL1_MASK, regData);
 458   1      
 459   1          return retVal;
 460   1      }
