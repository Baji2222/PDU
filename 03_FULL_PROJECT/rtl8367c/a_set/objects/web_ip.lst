 153          /*
 154           * Function: post_ip
 155           * -----------------
 156           * Processes IP configuration form submission.
 157           * Extracts DHCP state, IP, netmask, gateway from POST data.
 158           * Validates IP format using str_to_ip() function.
 159           * Checks that gateway is in same subnet as IP address.
 160           * Logs IP change event to syslog and applies new settings.
 161           */
 162          int32 post_ip(struct http_request_s *pReq)
 163          {
 164   1          uint8   *pValue;
 165   1          uint32  ip = 0;
 166   1          uint32  netmask = 0;
 167   1          uint32  gateway = 0;
 168   1          uint8   ipStr[16];
 169   1          uint8   netmaskStr[16];
C51 COMPILER V9.60.0.0   WEB_IP                                                            11/02/2026 17:57:34 PAGE 4   

 170   1          uint8   gatewayStr[16];
 171   1          uint8   dhcp_state;
 172   1      
 173   1          WEB_VAR(pReq, "dhcp_state", &pValue);
 174   1          if (pValue) 
 175   1          {
 176   2              dhcp_state = atoi(pValue);
 177   2              sal_sys_dhcp_set(dhcp_state);
 178   2          }
 179   1          
 180   1          if(FALSE == dhcp_state)
 181   1          {
 182   2              memset(ipStr, 0, sizeof(ipStr));
 183   2              WEB_VAR(pReq, "ip", &pValue);
 184   2              if (pValue) {
 185   3                  memcpy(ipStr, pValue, sizeof(ipStr));
 186   3              }
 187   2              memset(netmaskStr, 0, sizeof(netmaskStr));
 188   2              WEB_VAR(pReq, "netmask", &pValue);
 189   2              if (pValue) {
 190   3                  memcpy(netmaskStr, pValue, sizeof(netmaskStr));
 191   3              }
 192   2              
 193   2              if (str_to_ip(&ip, ipStr) != 0) {
 194   3                  printmsg(pReq, "Invalid IP Address.");
 195   3                  return SUCCESS;
 196   3              }
 197   2              if (str_to_ip(&netmask, netmaskStr) != 0) {
 198   3                  printmsg(pReq, "Invalid Netmask.");
 199   3                  return SUCCESS;
 200   3              }
 201   2      
 202   2              memset(gatewayStr, 0, sizeof(gatewayStr));
 203   2              WEB_VAR(pReq, "gateway", &pValue);
 204   2              if (pValue) {
 205   3                  memcpy(gatewayStr, pValue, sizeof(gatewayStr));
 206   3                  if (str_to_ip(&gateway, gatewayStr) != 0) {
 207   4                      printmsg(pReq, "Invalid Gateway.");
 208   4                  return SUCCESS;
 209   4              }
 210   3              if(gateway != 0)
 211   3              {
 212   4              if ((gateway & netmask) != (ip & netmask)) {
 213   5                  printmsg(pReq, "IP and Gateway address must be in the same subnet.");
 214   5                  return SUCCESS;
 215   5                  }
 216   4              }
 217   3              }
 218   2          syslog_add_new_buf_entry(SYSLOG_MSG_MANAGEMENT_IP_CHANGED, 0);
 219   2      
 220   2              sal_sys_ip_set(ip, netmask);
 221   2              sal_sys_gateway_set(gateway);
 222   2        
 223   2          
 224   2          }
 225   1          get_ip(pReq);
 226   1      
 227   1          return SUCCESS;
 228   1      }


