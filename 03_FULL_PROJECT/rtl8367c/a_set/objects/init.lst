 112   1          TI = 1;
 113   1          RI = 0;
 114   1      
 115   1          /* enable flash */
 116   1          tmp = getReg(0x130c);
 117   1          tmp |= 0x1000;
 118   1          setReg(0x130c, tmp);
 119   1      }
