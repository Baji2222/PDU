 121          // Timer Initialization: Sets up timer0 for system timekeeping with configurable divisor
 122          // Initializes current time to JAN_1970 and configures timer reload values
 123          void timer_init(void) large{
 124   1        uint16 xdata tmp;
 125   1      
 126   1        current_time = JAN_1970;
 127   1        timeCount = 0;
 128   1      
 129   1          TMOD = 0x11;                //timer0 and timer1 mode1 
 130   1          tmp  = (uint16) (system_clock/(12*CONFIG_TIMER_DIVISOR));
 131   1          tmp  = 0xFFFF - tmp + 1;
 132   1        _th0 = (tmp>> 8)&0xFF;
 133   1        _tl0 = (tmp>> 0)&0xFF;
 134   1        TH0  = _th0;
 135   1        TL0  = _tl0;
 136   1      
 137   1        tmp += (0x0DU); /* magic number, for Software reload */
 138   1        _th0 = (tmp>> 8)&0xFF;
 139   1        _tl0 = (tmp>> 0)&0xFF;
 140   1      
 141   1        //OSAL_PRINTF("Divisor=0x%04x\n", tmp);
 142   1      
 143   1          TCON  = 0x10;                //enable timer0 and timer 1
 144   1        CKCON = CKCON & 0xC7;       //timer clock is system clock/12
 145   1      
 146   1          ET0   = 1;                    // enable timer0 interrupt
 147   1      }
