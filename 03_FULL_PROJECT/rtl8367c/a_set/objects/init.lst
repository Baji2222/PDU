                  setReg(0x6601,0x0004);
                  setReg(0x6600,0x0080);
                  tmp =getReg(0x6602);
                  tmp |= 1 << 1;        
                  tmp |= 1 << 2;
                  setReg(0x6602,tmp);
                  setReg(0x6601,0x0004);
                  setReg(0x6600,0x00c0);
              }
              
