  69          // UART Initialization: Configures UART with baud rate based on system clock frequency
  70          // Sets up timer2 for baud rate generation and enables UART peripheral
  71          void uart_init()
  72          {
  73   1          uint16 tmp;
  74   1          uint32 divisor;
  75   1      
  76   1          IE = 0;
  77   1          /* enable global interrupt */
  78   1          EA = 1;
  79   1          T2CON = 0x34;
  80   1          SCON0 = 0x50;
  81   1      
  82   1          setReg(0x1d32, 0x0004); //Enable 67C UART
  83   1          
  84   1          tmp = (getReg(0x1336) >> 4) & 0x7;
  85   1          switch(tmp)
  86   1          {
  87   2          case DW8051_RDY_200MHz:
  88   2              system_clock = (200000UL * 1000);
  89   2              break;
  90   2          case DW8051_RDY_125MHz:
  91   2              system_clock = (125000UL * 1000);
  92   2              break;
  93   2          case DW8051_RDY_100MHz:
  94   2              system_clock = (100000UL * 1000);
  95   2              break;
  96   2          case DW8051_RDY_625MHz:
  97   2              system_clock = (62500UL * 1000);
  98   2              break;
  99   2          case DW8051_RDY_20_8MHz:
 100   2              system_clock = (20800UL * 1000);
 101   2              break;
 102   2          default:
 103   2              system_clock = (20800UL * 1000);
 104   2          }
 105   1          divisor = 65536 - system_clock/(32UL * BAUD_RATE);
 106   1      
 107   1          RCAP2L = divisor & 0xFF;
 108   1          RCAP2H = (divisor & 0xFF00) >> 8;
 109   1      
 110   1          setReg(0x13a0, (RCAP2H << 8) | RCAP2L);
 111   1              
