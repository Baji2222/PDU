  30          // ASCII Hex to Value: Converts ASCII hex character to numeric value
  31          // Returns 0-15 for hex digits, 0 for invalid characters
  32          static char asc_hex2val(char hex)
  33          {
  34   1          if ((hex >= '0') && (hex <= '9')) {
  35   2              return (hex - '0');
  36   2          } else if ((hex >= 'A') && (hex <= 'F')) {
  37   2              return (hex + 10 - 'A');
  38   2          } else if ((hex >= 'a') && (hex <= 'f')) {
  39   2              return (hex + 10 - 'a');
  40   2          }
  41   1      
  42   1          return 0;
  43   1      }
