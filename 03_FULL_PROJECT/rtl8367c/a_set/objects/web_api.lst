  53          // Unencode: Converts URL-encoded string to plain text
  54          // Handles '+' to space and '%XX' hex decoding for HTTP form data
  55          static void
  56          unencode (
  57              char *  src,
  58              char *  last,
  59              char *  dest
  60              )
  61          {
  62   1          for(; src != last; src++, dest++) {
  63   2              if (*src == '+') {
  64   3                  *dest = ' ';
  65   3              }
  66   2              else if (*src == '%') {
  67   3      #if 1
  68   3                  *dest = (asc_hex2val(*(src+1)) * 16) + asc_hex2val(*(src+2));
  69   3      #else
                          int code;
              
                          if (sscanf(src+1, "%2x", &code) != 1) {
                              code = '?';
                          }
                          *dest = code;
              #endif
  77   3                  src += 2;
  78   3              }
  79   2              else {
  80   3                  *dest = *src;
  81   3              }
  82   2          }
  83   1          *dest = '\0';
