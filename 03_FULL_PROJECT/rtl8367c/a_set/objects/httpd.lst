              #endif
 549   1      
 550   1          DBG_LWPS_HTTP_PRINTF(("%s():%d - pBoundary = %p, pData = %p, length = %d\n", __FILE__, (uint16)__LINE_
             -_, pBoundary, pData, length));
 551   1      
 552   1          if (iContentLength == ((pData + length) - (pBoundary + 4)))
 553   1          {
 554   2              DBG_LWPS_HTTP_PRINTF(( "%s():%d - complete HTTP packet (GOOD).\n", __FILE__, (uint16)__LINE__));
 555   2              return 0;   /* complete */
 556   2          }
 557   1          else if (iContentLength > ((pData + length) - (pBoundary + 4)))
 558   1          {
 559   2              DBG_LWPS_HTTP_PRINTF(("%s():%d - incomplete HTTP packet!\n", __FILE__, (uint16)__LINE__));
 560   2              return 1;   /* incomplete */
 561   2          }
 562   1      
 563   1          DBG_LWPS_HTTP_PRINTF(("%s():%d - error packet!\n", __FILE__, (uint16)__LINE__));
 564   1          return -1;  /* error */
 565   1      }
