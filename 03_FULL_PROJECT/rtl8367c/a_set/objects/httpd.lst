 496          // HTTP Packet Check: Checks if HTTP packet is complete or incomplete
 497          // Validates packet structure and content length for proper HTTP framing
 498          static int32 http_packet_check(httpd_client_t *pClient, uint8 *pData, uint32 length)
 499          {
 500   1          uint8 *pBoundary;
 501   1          uint8 *pContentType;
 502   1          uint8 *pContentLength;
 503   1          int32 iContentLength;
 504   1          int32 i;
 505   1      
 506   1          pClient = NULL; // kill compiler warning
 507   1          iContentLength = -1;    /* not found yet */
 508   1      
 509   1          if ((pData == NULL) || (length == 0) || \
 510   1              ((pBoundary = strnstr(pData, "\r\n\r\n", length)) == NULL))
 511   1          {
 512   2              DBG_LWPS_HTTP_PRINTF(("%s():%d - incomplete HTTP packet!\n", __FILE__, (uint16)__LINE__));
 513   2              return 1;   /* incomplete */
 514   2          }
 515   1      
 516   1          /* try to find `Content-Type` */
 517   1          if ((pContentType = strnstr(pData, "Content-Type: ", pBoundary - pData)) == NULL)
 518   1          {
 519   2              DBG_LWPS_HTTP_PRINTF(("%s():%d - complete HTTP packet (GOOD).\n", __FILE__, (uint16)__LINE__));
 520   2              return 0;   /* complete */
 521   2          }
 522   1          
 523   1          /* try to find `Content-Length` */
 524   1          if ((pContentLength = strnstr(pData, "Content-Length: ", pBoundary - pData)) == NULL)
 525   1          {
 526   2              DBG_LWPS_HTTP_PRINTF(("%s():%d - error packet!\n", __FILE__, (uint16)__LINE__));
 527   2              return -1;  /* error */
 528   2          }
C51 COMPILER V9.60.0.0   HTTPD                                                             11/02/2026 17:57:29 PAGE 10  

 529   1      
 530   1          pContentLength += 16;   /* jump to digital position */
 531   1          iContentLength = 0;
 532   1          for (i=0; i<32; i++)
 533   1          {
 534   2              if (*(pContentLength + i) == '\r')
 535   2                  break;
 536   2      
 537   2              iContentLength *= 10;
 538   2              iContentLength += (*(pContentLength + i) - '0');
 539   2          }
 540   1          DBG_LWPS_HTTP_PRINTF(("%s():%d - pClient->ContentLength = %d\n", __FILE__, (uint16)__LINE__, iContentL
             -ength));
 541   1      
 542   1      #if 0
                  if (iContentLength >= length)
