 257          // Change Clock: Adjusts system clock divider for SPI flash access based on CPU frequency
 258          // Sets DW8051_RDY register to control SPI flash access timing and reinitializes UART/timer
 259          void change_clock(uint16 xdata value) large{
 260   1        volatile uint32 xdata i;
 261   1        
 262   1        for(i=0;i<0x100;i++);
 263   1        if(value < 0x04) //8051 Clock >100Mhz
 264   1        {
 265   2            //if 8051 Clock >100Mhz, SPI flash access clock is divided to half 8051 Clock
 266   2              setReg(DW8051_RDY, (DW8051_RDY_RATE(value)|(1<<8)) );
 267   2        }
 268   1        else
 269   1          {
 270   2              //if 8051 Clock < 100Mhz, SPI flash access clock is equal to 8051 Clock
 271   2        setReg(DW8051_RDY, (DW8051_RDY_RATE(value)) );
 272   2          }
 273   1        for(i=0;i<65535;i++);
 274   1        uart_init();
 275   1        timer_init();
 276   1        for(i=0;i<0x100;i++);
 277   1      }
