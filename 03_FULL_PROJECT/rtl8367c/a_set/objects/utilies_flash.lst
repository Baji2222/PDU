 319          // Process UART String:
 320          //  1. PDU status frame {"V":..,"P":[8],"I":[8]}  -> validated, then sent to
 321          //     the web page and the SNMP JSON store.
 322          //  2. GET_ALARM reply {"alarms":[...]}           -> Copy_Alarm_DATA()
 323          //  3. GET_RTC / SETRTC reply {"H":..,"MO":..}    -> Copy_RTC_DATA()
 324          //  4. Anything else (ALARM_SET, ALARM_FIRED, RTC_SET ...) is ignored.
 325          // Routing is by CONTENT, not by start_xxx flags, so a status poll can
 326          // never make an RTC or alarm reply get lost.
 327          void process_uart_string(void)
 328          {
 329   1          uint8 temp_var;
 330   1          uint8 valid = 0;
 331   1          uint8 len;
 332   1          char *s = (char *)m_u8_uart_str;
 333   1      
 334   1          m_u8_strlen = strlen(s);
 335   1      
 336   1          /* ignore trailing CR / LF */
 337   1          len = m_u8_strlen;
 338   1          while (len > 0 && (s[len - 1] == '\r' || s[len - 1] == '\n'))
 339   1              len--;
 340   1      
 341   1          if (len >= 10 && s[0] == '{' && s[len - 1] == '}')
 342   1          {
 343   2              if (json_number_ok(s, "\"V\"") &&
 344   2                  json_array_items(s, "\"P\"") != 0xFF &&
 345   2                  json_array_items(s, "\"I\"") != 0xFF)
 346   2              {
 347   3                  valid = 1;
 348   3      #if PDU_CHANNEL_COUNT
 349   3                  if (json_array_items(s, "\"P\"") != PDU_CHANNEL_COUNT ||
 350   3                      json_array_items(s, "\"I\"") != PDU_CHANNEL_COUNT)
 351   3                  {
 352   4                      valid = 0;
 353   4                  }
 354   3      #endif
 355   3              }
 356   2          }
 357   1      
 358   1          if (valid)
 359   1          {
 360   2              m_u16_json_ok++;
C51 COMPILER V9.60.0.0   UTILIES_FLASH                                                     11/03/2026 14:15:30 PAGE 7   

 361   2              send_str_web(m_u8_uart_str);
 362   2              update_json_string((char *)m_u8_uart_str);
 363   2          }
 364   1          else if (len >= 2 && s[0] == '{' && s[len - 1] == '}')
 365   1          {
 366   2              if (strstr(s, "\"alarms\""))
 367   2              {
 368   3                  m_u16_json_alm++;
 369   3                  Copy_Alarm_DATA(m_u8_uart_str);     /* GET_ALARM reply */
 370   3              }
 371   2              else if (strstr(s, "\"MO\""))
