 193   1          {
 194   2              cmd = cmd_select();
 195   2              if (cmd == 0xFF)
 196   2                  break;                      /* nothing more buffered */
 197   2      
 198   2              if (cmd == '{')                 /* FIX: resync on every '{' */
 199   2              {
 200   3                  m_u8_temp_cntr = 0;
 201   3                  in_json_line = 1;
 202   3              }
 203   2      
 204   2              if (m_u8_temp_cntr < (sizeof(m_u8_uart_str) - 1))
 205   2              {
 206   3                  m_u8_uart_str[m_u8_temp_cntr++] = cmd;
 207   3      
 208   3                  if (cmd == 0x0A)
 209   3                  {
 210   4                      m_u8_uart_str[m_u8_temp_cntr] = '\0';
 211   4                      process_uart_string();
 212   4                      m_u8_temp_cntr = 0;
 213   4                      in_json_line = 0;
 214   4                  }
 215   3              }
 216   2              else
 217   2              {
 218   3                  /* Overflow: discard incomplete message */
 219   3                  m_u8_temp_cntr = 0;
 220   3                  in_json_line = 0;
 221   3                  memset(m_u8_uart_str, 0, sizeof(m_u8_uart_str));
