 276          /* Returns number of items in the array that follows key (e.g. "\"P\""),
 277             or 0xFF if malformed. */
 278          static uint8 json_array_items(char *s, const char *key)
 279          {
 280   1          char *p;
 281   1          uint8 items = 1;
 282   1      
 283   1          p = strstr(s, key);
 284   1          if (p == NULL) return 0xFF;
 285   1          p += strlen(key);
 286   1          while (*p == ' ') p++;
 287   1          if (*p != ':') return 0xFF;
 288   1          p++;
 289   1          while (*p == ' ') p++;
 290   1          if (*p != '[') return 0xFF;
 291   1          p++;
 292   1          if (*p == ']') return 0;
 293   1      
 294   1          while (*p != ']')
 295   1          {
 296   2              if (*p == '\0') return 0xFF;
 297   2              if (*p == ',')
 298   2                  items++;
C51 COMPILER V9.60.0.0   UTILIES_FLASH                                                     11/03/2026 14:15:30 PAGE 6   

 299   2              else if (!((*p >= '0' && *p <= '9') || *p == '.' || *p == '-' || *p == '+' || *p == ' '))
 300   2                  return 0xFF;                /* unexpected character inside array */
 301   2              p++;
 302   2          }
 303   1          return items;
 304   1      }
 305          
 306          /* Returns 1 if the number after key (e.g. "\"V\"") looks valid. */
 307          static uint8 json_number_ok(char *s, const char *key)
 308          {
 309   1          char *p = strstr(s, key);
 310   1          if (p == NULL) return 0;
 311   1          p += strlen(key);
 312   1          while (*p == ' ') p++;
 313   1          if (*p != ':') return 0;
 314   1          p++;
 315   1          while (*p == ' ') p++;
 316   1          return (uint8)((*p >= '0' && *p <= '9') || *p == '-');
 317   1      }
