                              SPI_RI_CMD      = 0x0B;
                              SPI_RI_CONF     = SPI_S_CONF_DUMMY(SPI_S_CONF_DUMMY_08cycle);
                              SPI_S_RCMD      = 0x0B;
                              SPI_S_CONF      = SPI_S_CONF_DUMMY(SPI_S_CONF_DUMMY_08cycle);
