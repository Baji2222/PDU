  89   1          SPI_S_CONF    = SPI_S_CONF_DUMMY(SPI_S_CONF_DUMMY_00cycle);
  90   1          SPI_IO_CONF   = SPI_IO_CONF_IOMODE(SPI_IO_CONF_IO_SSS);
  91   1          SPI_S_ACCESS  = SPI_S_ACCESS_BYTE(1) | SPI_S_ACCESS_WRITE | SPI_S_ACCESS_SKIP_ADR;
