  19          #include <rtl8367c_asicdrv_specialCongest.h>
  20          /* Function Name:
  21           *      rtl8367c_setAsicSpecialCongestModeConfig
  22           * Description:
  23           *      Set ASIC special congest mode configuration
  24           * Input:
  25           *      port  - Physical port number (0~7)
  26           *      sustain - sustain timer (0-15)
  27           * Output:
  28           *      None
  29           * Return:
  30           *      RT_ERR_OK       - Success
  31           *      RT_ERR_SMI      - SMI access error
  32           *      RT_ERR_PORT_ID    - Invalid port number
  33           *      RT_ERR_OUT_OF_RANGE - Input parameter out of range
  34           * Note:
  35           *      None
  36           */
  37          ret_t rtl8367c_setAsicSpecialCongestModeConfig(uint32 port, uint32 sustain)
  38          {
  39   1        if(port >= RTL8367C_PORTNO)
  40   1          return RT_ERR_PORT_ID;
  41   1      
  42   1          if(sustain > RTL8367C_SPECIALCONGEST_SUSTAIN_TIMERMAX)
  43   1              return RT_ERR_OUT_OF_RANGE;
  44   1      
  45   1        return rtl8367c_setAsicRegBits(RTL8367C_PORT_MISC_CFG_REG(port), RTL8367C_SPECIALCONGEST_SUSTAIN_TIMER_MA
             -SK, sustain);
  46   1      }
  47          #if 0 //NOT used
              /* Function Name:
               *      rtl8367c_getAsicSpecialCongestModeConfig
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_SPECIALCONGEST                                   11/02/2026 17:57:25 PAGE 2   

               * Description:
               *      Get ASIC special congest mode configuration
               * Input:
               *      port  - Physical port number (0~7)
               *      pSustain - sustain timer (0-15)
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
               *      RT_ERR_PORT_ID    - Invalid port number
               * Note:
               *      None
               */
              ret_t rtl8367c_getAsicSpecialCongestModeConfig(uint32 port, uint32 *pSustain)
              {
                if(port >= RTL8367C_PORTNO)
                  return RT_ERR_PORT_ID;
              
                return rtl8367c_getAsicRegBits(RTL8367C_PORT_MISC_CFG_REG(port), RTL8367C_SPECIALCONGEST_SUSTAIN_TIMER_MA
             -SK, pSustain);
              }
              /* Function Name:
               *      rtl8367c_getAsicSpecialCongestModeTimer
               * Description:
               *      Get ASIC special congest mode timer
               * Input:
               *      port  - Physical port number (0~7)
               *      pTimer  - time (0-15)
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
               *      RT_ERR_PORT_ID    - Invalid port number
               * Note:
               *      None
               */
              ret_t rtl8367c_getAsicSpecialCongestModeTimer(uint32 port, uint32* pTimer)
              {
                  if(port > RTL8367C_PORTNO)
                      return RT_ERR_PORT_ID;
              
                  return rtl8367c_getAsicRegBits(RTL8367C_PORT_SPECIAL_CONGEST_MODE_TIMER_REG(port), RTL8367C_PKTGEN_POR
             -T0_TIMER_TIMER_MASK, pTimer);
              }
              #endif
