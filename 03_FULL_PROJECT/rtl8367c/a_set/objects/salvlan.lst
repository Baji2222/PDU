 684           *      pPortMask - Member port mask
 685           *      pTagMask  - tag mask
 686           * Output:
 687           *      No
 688           * Return:
 689           *      SAL_ERR_SUCCESS
 690           *      SAL_ERR_VLAN_FULL
 691           * Note:
 692           *      If an entry with the same vid exists, update the fields in the entry.
 693           *      Otherwise, a new static entry and one corresponding index entry 
 694           *      in the sorted-index-database are created. 
 695           */
 696          // Sal VLAN Static Entry Add: Adds or updates a static VLAN entry
 697          // Creates new VLAN or updates existing, writes to hardware and flash database
 698          int32 sal_vlan_sttcEntry_add(
 699              sal_vlan_t vlan_id, 
 700              int8       *pName, 
 701              sal_lPortmask_t *pPortMask, 
 702              sal_lPortmask_t *pTagMask
 703              ) 
 704          {
 705   1          int32   ret;
 706   1        sal_flash_vlanEntry_t entry; /* one static entrie                   */
 707   1        uint16  entry_index;          /* The entry index range from 0 ~ 31   */
 708   1        uint16  sorted_idx;           /* Index in the sorted database        */
 709   1          bool    found;
 710   1          if ( (!vlan_id) || (vlan_id > 4094)) {
 711   2          return SAL_ERR_VLAN_ID_INVALID;
 712   2        }
 713   1        
 714   1        found = sal_vlan_db_search(vlan_id, &sorted_idx, &entry_index);
 715   1        
 716   1        if (entry_index == SAL_MAX_STATIC_VLAN) {
 717   2          return SAL_ERR_VLAN_FULL;
 718   2        }
 719   1          /* Set the asic */
 720   1          if ((ret = sal_vlan_entry_insert(vlan_id, pPortMask, pTagMask)) != SAL_ERR_SUCCESS) {
 721   2          return ret;
 722   2          }
 723   1           /* update the entry in the 32 static VLAN entries no matter 
 724   1              the vlan id is exist previously */
 725   1        entry.vlan_id = vlan_id;
 726   1        strncpy(entry.name, pName, SAL_MAX_VLAN_NAME_LEN - 1);
 727   1        entry.name[SAL_MAX_VLAN_NAME_LEN-1] = '\0';
 728   1          entry.valid = 1;
 729   1          
 730   1          sal_trunk_logicMask_toPhysicMask(&entry.p_portMask, pPortMask);
 731   1          sal_trunk_logicMask_toPhysicMask(&entry.p_tagMask, pTagMask);
 732   1      
 733   1        sal_flash_vlan_sttcEntry_set(entry_index, &entry);
C51 COMPILER V9.60.0.0   SALVLAN                                                           11/02/2026 17:57:05 PAGE 13  

 734   1      
