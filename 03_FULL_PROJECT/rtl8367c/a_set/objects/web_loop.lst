 297          /*
C51 COMPILER V9.60.0.0   WEB_LOOP                                                          11/02/2026 17:57:34 PAGE 6   

 298           * Function: post_loop
 299           * -------------------
 300           * Processes Loop Prevention/Detection form submission.
 301           * Extracts interval time, recover time, and loop mode from POST data.
 302           * Validates and applies new loop mode setting via sal_loop_mode_set().
 303           * Returns to GET handler to refresh the page with updated state.
 304           */
 305          int32 post_loop(struct http_request_s *pReq)
 306          {
 307   1          int32           ret;
 308   1          uint8           *pValue;
 309   1          sal_loop_mode_t mode;
 310   1          uint16 int_time, rec_time;
 311   1          sal_loop_mode_t mode_old;
 312   1      
 313   1          WEB_VAR(pReq, "interval_time", &pValue);
 314   1          if (pValue) {
 315   2              int_time = atoi(pValue);
 316   2          }
 317   1          sal_loop_interval_time_set(int_time);
 318   1      
 319   1          WEB_VAR(pReq, "recover_time", &pValue);
 320   1          if (pValue) {
 321   2              rec_time = atoi(pValue);
 322   2          }
 323   1          sal_loop_recover_time_set(rec_time);
 324   1      
 325   1          WEB_VAR(pReq, "func_type", &pValue);
 326   1          if (pValue) {
 327   2              mode = atoi(pValue);
 328   2          }
 329   1          
 330   1          sal_loop_mode_get(&mode_old);
 331   1          if(mode_old == mode)
 332   1          {
 333   2              get_loop(pReq);
 334   2              return SAL_ERR_SUCCESS;
 335   2          }
 336   1              
 337   1          if ((ret = sal_loop_mode_set(mode)) != SAL_ERR_SUCCESS) 
 338   1          {
 339   2              printerr(pReq, ret);
 340   2              return SUCCESS;
 341   2          }
 342   1      
 343   1              get_loop(pReq);
 344   1      
 345   1          return SUCCESS;
 346   1      }
 347          
 348          /*
 349           * Function: post_loop_port
 350           * ------------------------
 351           * Processes port-level loop prevention configuration.
 352           * Extracts selected port IDs and enable/disable state from POST data.
 353           * Applies port enable setting to all selected ports via sal_loop_port_enable_set().
 354           * Returns to GET handler to refresh the page with updated port states.
 355           */
 356          int32 post_loop_port (http_request_t *pReq)
 357          {
 358   1          uint8  *pValue;
 359   1          uint16   ucPortId[MAX_LOGIC_COMBO_PORT];
C51 COMPILER V9.60.0.0   WEB_LOOP                                                          11/02/2026 17:57:34 PAGE 7   

 360   1          uint16   ucPortNum = 0, portEnable = 0, i;
 361   1          
 362   1          
 363   1          WEB_VAR(pReq, "portid", &pValue);
 364   1          if (pValue) {
 365   2              ucPortId[ucPortNum++] = atoi(pValue);
 366   2          }
 367   1      
 368   1          while(pValue != NULL)
 369   1          {
 370   2              WEB_VAR(pReq, NULL, &pValue);
 371   2              if (pValue) {
 372   3                  ucPortId[ucPortNum++] = atoi(pValue);
 373   3              }
 374   2          }
 375   1      
 376   1          WEB_VAR(pReq, "portEnable", &pValue);
 377   1          if (pValue) {
 378   2              portEnable = atoi(pValue);        
 379   2          }
 380   1      
 381   1          for (i = 0; i < ucPortNum; ++i) {
 382   2              sal_loop_port_enable_set(ucPortId[i], portEnable);
 383   2              
 384   2          }
 385   1      
 386   1          get_loop(pReq);
 387   1      
 388   1          return SUCCESS;
 389   1      }
