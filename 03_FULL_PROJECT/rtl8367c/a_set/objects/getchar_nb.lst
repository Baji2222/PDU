   5          // Get Character Non-Blocking: Reads a character from UART without waiting if no data available
   6          // Returns 0xFF if no character received, otherwise returns the received character
   7          char getchar_nb(void){
   8   1        char c; 
   9   1        while(!RI){
  10   2          return(0xFF);
  11   2        }
  12   1        RI=0; 
  13   1        c=SBUF0; 
  14   1        return c; 
  15   1      }
