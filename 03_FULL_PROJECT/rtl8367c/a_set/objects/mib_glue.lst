  22          /*
  23           * Function: mib_glue_portCounter_get
  24           * ----------------------------------
  25           * Retrieves MIB counter values for a specified port and places into byte array.
  26           * Handles both 32-bit and 64-bit counters (octets uses 64-bit, others use 32-bit).
  27           * Converts counter to big-endian byte order for SNMP response.
  28           * Returns SUCCESS on success, FAILED on error.
  29           */
  30          int32 mib_glue_portCounter_get(sal_stat_port_type_t mibIndex, u8_t interface, u8_t size, u8_t *ptr)
  31          {
  32   1          uint8  i;
  33   1          uint32 cntrH, cntrL;
  34   1      
  35   1          if(interface > SAL_MAX_PHY_PORT)
  36   1              return FAILED;
  37   1      
  38   1          for(i = 0; i < size;i++)
  39   1          ptr[i] = 0;
  40   1      
  41   1          if(SAL_ERR_SUCCESS == sal_mib_port_get(interface, mibIndex, &cntrH, &cntrL))
  42   1          {
  43   2              /* if counter is 64 bit */
  44   2               if(mibIndex == SAL_IF_IN_OCTETS_INDEX || 
  45   2                  mibIndex == SAL_IF_OUT_OCTETS_INDEX ||
  46   2                  mibIndex == SAL_ETHER_STATS_OCTETS_INDEX) 
  47   2                 {
  48   3                    CNTR_TO_ARR(cntrH, ptr);
  49   3                    CNTR_TO_ARR(cntrL, ptr + 4);
  50   3                 }
