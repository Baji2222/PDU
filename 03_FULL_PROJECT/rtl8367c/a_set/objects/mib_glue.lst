   6          #define CNTR_TO_ARR(counter, arr) do { \
   7                  *(arr + 0) = (counter >> 24) & 0xFF; \
   8                  *(arr + 1) = (counter >> 16) & 0xFF; \
   9                  *(arr + 2) = (counter >> 8)  & 0xFF; \
  10              *(arr + 3) =  counter        & 0xFF; \
  11              } while(0)
