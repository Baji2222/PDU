              rtk_api_ret_t rtk_trunk_trafficSeparate_get(rtk_trunk_group_t trk_gid, rtk_trunk_separateType_t *pSeparate
             -Type)
              {
                  rtk_api_ret_t retVal;
                  uint32 enabled;
              
                  /* Check initialization state */
                  RTK_CHK_INIT_STATE();
              
                  if (trk_gid != RTK_WHOLE_SYSTEM)
                      return RT_ERR_LA_TRUNK_ID;
              
                  if(NULL == pSeparateType)
