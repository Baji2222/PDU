 323          /*
 324           * Function: get_file
 325           * ------------------
 326           * Serves static web files (CSS, JavaScript) to HTTP clients.
 327           * Determines file type from file_idx and sends appropriate content.
 328           * Sets Content-Type and Content-Length headers for each file.
 329           */
 330          int8 get_file(struct http_request_s *pReq, int32 file_idx)
 331          {
 332   1          uint8 buf[32];
 333   1      
 334   1          if ((file_idx <= WEB_FILE_NONE) || (file_idx >= WEB_FILE_MAX))
 335   1              return FAILED;
 336   1      
 337   1          WEB_BEGIN(pReq);
 338   1      
 339   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
 340   1      
 341   1          switch (file_idx)
 342   1          {
 343   2          case WEB_FILE_STYLE_CSS:
 344   2              WEB_HEADER(pReq, "Content-Type: text/html");
 345   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(file_style_css));
 346   2              WEB_HEADER(pReq, buf);
 347   2              WEB_DATA(pReq, file_style_css, sizeof(file_style_css) - 1);
 348   2              break;
 349   2      
 350   2          case WEB_FILE_XP_PROGRESS_JS:
 351   2              WEB_HEADER(pReq, "Content-Type: text/html");
 352   2              sprintf(buf, "Content-Length: %u", (uint16)sizeof(file_xp_progress_js));
