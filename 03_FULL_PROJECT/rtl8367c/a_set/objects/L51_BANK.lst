                       8     ;************************ Configuration Section *******************************
  0020                 9     ?B_NBANKS       EQU  32   ; Define maximum Number of Banks                    *
                      10     ;                         ; following values are allowed: 2, 4, 8, 16, 32, 64 *
                      11     ;                         ; for BL51 the maximum value for ?B_BANKS is 32     *
                      12     ;                         ; for LX51 the maximum value for ?B_BANKS is 64     *
                      13     ;                         ; However, when ?B_MODE=4, please check if number of*
                      14     ;                         ; macro SWITCH is correct.                          *
                      15     ;                                                                             *
  0004                16     ?B_MODE         EQU  4    ; 0 for Bank-Switching via 8051 Port                *
  0001                17     ?B_SSTACK       EQU  1    ; 1 for using secondary stack                       *
                      18     ;                         ; 1 for Bank-Switching via XDATA Port               *
                      19     ;                         ; 4 for user-provided bank switch code              *
                      20     ;                                                                             *
  0000                21     ?B_RTX          EQU  0    ; 0 for applications without real-time OS           *
                      22     ;                         ; 1 for applications using the RTX-51 real-time OS  *
                      23     ;                                                                             *
  0001                24     ?B_VAR_BANKING  EQU  1    ; Variable Banking via L51_BANK (far memory support)*
                      25     ;                         ; 0 Variable Banking does not use L51_BANK.A51      *
                      26     ;                         ; 1 Variable Banking uses this L51_BANK.A51 module  *
                      27     ; Notes: ?B_VAR_BANKING uses the 'far' and 'far const' C51 memory types to    *
                      28     ;        extent the space for variables in RAM and/or ROM of classic 8051     *
                      29     ;        device.  The same hardware as for code banking is used.  Program     *
                      30     ;        code banking and variable banking share the same hardware I/O pins.  *
                      31     ;        The C51 Compiler must be used with the VARBANKING directive.         *
                      32     ;        Variable Banking is only supported with the LX51 linker/locater.     *
                      33     ;                                                                             *
  0000                34     ?B_RST_BANK     EQU  0x00 ; specifies the active code bank number after CPU   *
                      35     ;                         ; Reset.  Used to reduce the entries in the         *
                      36     ;                         ; INTERBANK CALL TABLE.  The value 0xFF disables    *
                      37     ;                         ; this LX51 linker/locater optimization.            *
                      38     ; Note:  Interbank Call Table optimization is only possible with LX51.        *
                      39     ;                                                                             *
                      40     ;-----------------------------------------------------------------------------*
                      41     ;                                                                             *
                      42     IF  ?B_MODE = 4;                                                              *
                      43     ;-----------------------------------------------------------------------------*
                      44     ; if ?BANK?MODE is 4 define the following switch macros                       *
                      45     ; For bank switching via user-provided bank switch code you must define for   *
                      46     ; each memory bank a own macro which contains the bank switch code.  The      *
                      47     ; following example shows how to use the I/O lines P1.4 and P1.7 for bank     *
                      48     ; switching.  Since you can select just 4 banks with two address lines, just  *
                      49     ; four macros are defined.  The number of macros must conform with the number *
                      50     ; ?B_NBANKS number, i.e. for an application with 16 memory banks you must     *
                      51     ; define 16 macros.                                                           *
                      52     ;                                                                             *
                      53     ; IMPORTANT NOTES:                                                            *
                      54     ; 1. The bank switch logic must be initialized before using it.  Therefore    *
                      55     ;    add the following lines of code at the end of the STARTUP.A51 file:      *
                      56     ;                :                                                            *
                      57     ;      EXTRN CODE (?B_SWITCH0)                                                *
A51 MACRO ASSEMBLER  L51_BANK                                                             11/03/2026 14:15:30 PAGE     2

                      58     ;               CALL    ?B_SWITCH0    ; init bank mechanism to code bank 0    *
                      59     ;               LJMP    ?C_START      ; line already exits at the end of file *
                      60     ;                :                                                            *
                      61     ;                                                                             *
                      62     ; 2. If the bank switch macros and the additional control code generate more  *
                      63     ;    than 256 bytes, you need to set the LONG_MACRO flag below.  The error    *
                      64     ;    message "BANK SWITCH CODE BIGGER THAN 256 BYTES, SET LONG_MACRO TO 1"    *
                      65     ;    is generated in case that this is required.                              *
                      66     ;                                                                             *
                      67     ; 3. The only registers that can be modified in this routines without prior   *
                      68     ;    saving are:  DPTR and ACC.                                               *
                      69     ;                                                                             *
                      70     ;                                                                             *
  0000                71     LONG_MACRO      EQU  0    ; 0 default, for normal macros and up to 8 banks    *
                      72     ;                         ; 1 big macro code or many banks                    *
                      73     ;                                                                             *
                      74     ;                                                                             *
  00A0                75     P2              DATA    0A0H      ; I/O Port Addresses                        *
                      76     ;                                                                             *
                      77     SWITCH0         MACRO            ; Switch to Memory Bank #0                   *
                      78                     CLR     P2.0     ; Clear Port 2 Bit 0                         *
                      79                     CLR     P2.1     ; Clear Port 2 Bit 1                         *
                      80                     ENDM             ;                                            *
                      81     ;                                                                             *
                      82     SWITCH1         MACRO            ; Switch to Memory Bank #1                   *
                      83                     SETB    P2.0     ; Set   Port 2 Bit 0                         *
                      84                     CLR     P2.1     ; Clear Port 2 Bit 1                         *
                      85                     ENDM             ;                                            *
                      86     ;                                                                             *
                      87     SWITCH2         MACRO            ; Switch to Memory Bank #2                   *
                      88                     CLR     P2.0     ; Clear Port 2 Bit 0                         *
                      89                     SETB    P2.1     ; Set   Port 2 Bit 1                         *
                      90                     ENDM             ;                                            *
                      91     ;                                                                             *
                      92     SWITCH3         MACRO            ; Switch to Memory Bank #3                   *
                      93                     SETB    P2.0     ; Set   Port 2 Bit 0                         *
                      94                     SETB    P2.1     ; Set   Port 2 Bit 1                         *
                      95                     ENDM             ;                                            *
                      96     ;                                                                             *
                      97     ;-----------------------------------------------------------------------------*
                      98     ENDIF;                                                                        *
                      99     ;                                                                             *
                     100     IF ?B_VAR_BANKING = 1;                                                        *            
                                                                          
                     101     ;                                                                             * 
  0000               102     XMEM EQU 0x02000000       ; LX51 xdata symbol offset: do not change!          *
                     103     ;                                                                             *
                     104     ;******* Configuration Section for uVision2 Memory Simulation Support *********
                     105     ;                                                                             *
                     106     ; The following settings allow you to map the physical xdata and code memory  *
                     107     ; banks into simulation memory of the uVision2 Simulator.                     *
                     108     ;                                                                             *
  4000               109     ?B?XSTART EQU 0x4000      ; Start of xdata bank area                          *
  FFFF               110     ?B?XEND   EQU 0xFFFF      ; Stop of xdata bank area                           *
  4000               111     ?B?XMEM   EQU XMEM+0x004000  ; First HDATA memory bank in xdata space         *
                     112     ;                                                                             *
                     113     ; The above setting redirects the symbols in the area X:0x20000 .. X:0x2FFFF  *
                     114     ; into the uVision2 simulation memory area for the EEPROM  V:0 .. V:0xFFFF    *
                     115     ;                                                                             *
                     116     ;-----------------------------------------------------------------------------*
                     117     ;                                                                             *
                     118                     PUBLIC ?B?XSTART, ?B?XEND, ?B?XMEM;                           *
                     119     ENDIF;                                                                        *
                     120     ;                                                                             *
                     121     ;******************************************************************************
                     122     ;                                                                             *
A51 MACRO ASSEMBLER  L51_BANK                                                             11/03/2026 14:15:30 PAGE     3

                     123     ; THEORY OF OPERATION                                                         *
                     124     ; -------------------                                                         *
                     125     ; The section below describes the code generated by BL51 or LX51 and the      *
                     126     ; operation of the L51_BANK.A51 module.  BL51/LX51 generates for each         *
                     127     ; function that is located in a code memory bank and called from the common   *
                     128     ; area or a different code bank and entry into the INTRABANK CALL TABLE.  The *
                     129     ; INTRABANK CALL TABLE is located in the SEGMENT ?BANK?SELECT and listed in   *
                     130     ; the Linker MAP file. The entries in that TABLE have the following format:   *
                     131     ;                                                                             *
                     132     ;   ?FCT?1:  MOV  DPTR,#FCT     ; Load Address of target FCT                  *
                     133     ;            JMP  ?B_BANKn      ; Switch to Bank and Jump to Target Code      *
                     134     ;                                                                             *
                     135     ; Instead of directly calling the function FCT, the Linker changes the entry  *
                     136     ; to ?FCT?1.  This entry selects the bank where the function FCT is located   *
                     137     ; and calls that function via the routines defined in this L51_BANK.A51 file. *
                     138     ; The L51_BANK.A51 file contains two sets of functions for each bank:         *
                     139     ;                                                                             *
                     140     ; ?B_BANKn    is a routine which saves the entry of the ?B_SWITCHn function   *
                     141     ;             for the current active bank on the STACK and switches to the    *
                     142     ;             bank 'n'.  Then it jumps to the address specified by the DPTR   *
                     143     ;             register.  It is allowed to modify the following registers in   *
                     144     ;             the ?B_BANKn routine:  A, B, R0, DPTR, PSW                      *
                     145     ;                                                                             *
                     146     ; ?B_SWITCHn  is a function which selects the bank 'n'.  This function is     *
                     147     ;             used at the end of a user function to return to the calling     *
                     148     ;             code bank.  Only the following registers may be altered in the  *
                     149     ;             ?B_SWITCHn function:  R0, DPTR                                  *
                     150     ;                                                                             *
                     151     ; The current active bank is stored in ?B_CURRENTBANK.  RTX-51 uses this      *
                     152     ; variable to restore the code bank after a task switch.  To get correct      *
                     153     ; results, ?B_CURRENTBANK must be set to the code bank before the hardware    *
                     154     ; switch is done, or the code banking sequences must be interrupt protected.  *
                     155     ;******************************************************************************
                     156     
                     157                     NAME    ?BANK?SWITCHING
                     158     
                     159                     PUBLIC  ?B_NBANKS, ?B_MODE, ?B_MASK
                     160                     PUBLIC  ?B_FACTOR, ?B_RST_BANK
                     161                     
                     162     
                     163     ; Standard SFR Symbols required in L51_BANK.A51
  00E0               164     ACC             DATA    0E0H
  00F0               165     B               DATA    0F0H
  0082               166     DPL             DATA    82H
  0083               167     DPH             DATA    83H
  00A8               168     IE              DATA    0A8H
  00AF               169     EA              BIT     IE.7
  0096               170     CODE_BANK       DATA    096H      ; I/O Port Address                          *
  00BB               171     SSIO            DATA    0BBH      ; secondary stack I/O port
                     172     
                     173     
                     174     ; generate Mask and Bank Number Information
                             ELSEIF  ?B_NBANKS <= 32
  001F               184       MASK          EQU     00011111B
                             ENDIF     
                     188     
  001F               189     ?B_MASK         EQU     MASK
  0000               190     ?B_FACTOR       EQU     0               ; Dummy Declarations
                     191     
                     192     
                     193     
                     194     
                     195     IF  ?B_MODE = 4 ;**************************************************************
                     196     
                     197         IF ?B_SSTACK = 1
                     198             ?BANK?SELECT    SEGMENT CODE
A51 MACRO ASSEMBLER  L51_BANK                                                             11/03/2026 14:15:30 PAGE     4

                     199             ?BANK?SWITCH    SEGMENT CODE PAGE
----                 200                             RSEG    ?BANK?SWITCH
                     201             
                     202             SWITCH          MACRO   N
                     203                             PUBLIC  ?B_BANK&N
                     204                             PUBLIC  ?B_SWITCH&N
                     205             ?B_BANK&N:
                     206                             MOV     SSIO, CODE_BANK
                     207                             MOV     CODE_BANK, #( N )
                     208                             ACALL   ?B_BANK_CALL
                     209             ?B_SWITCH&N:
                     210                             MOV     CODE_BANK, SSIO
                     211                             RET
                     212                             ENDM
                     213                             
