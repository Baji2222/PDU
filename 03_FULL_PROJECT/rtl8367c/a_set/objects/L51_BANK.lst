                     647     ;******************************************************************************
                     648     ;                                                                             *
                     649     ; THEORY OF OPERATION                                                         *
                     650     ; -------------------                                                         *
                     651     ; This section describes how the extended LX51 linker/locater manages the     *
                     652     ; extended address spaces that are addressed with the new C51 memory types    *
                     653     ; 'far' and 'far const'.  The C51 Compiler uses 3 byte pointer generic        *
                     654     ; pointer to access these memory areas.  'far' variables are placed in the    *
                     655     ; memory class HDATA and 'far const' variables get the memory class 'HCONST'. *
                     656     ; The LX51 linker/locater allows you to locate these memory classes in the    *
                     657     ; logical 16 MBYTE CODE or 16 MBYTE XDATA spaces.                             *
                     658     ;                                                                             *
                     659     ; The memory access itself is performed via eight different subroutines that  *
                     660     ; can be configured in this assembler module.  These routines are:            *
                     661     ;    ?C?CLDXPTR, ?C?CSTXPTR  ; load/store BYTE (char)  in extended memory     *
                     662     ;    ?C?ILDXPTR, ?C?ISTXPTR  ; load/store WORD (int)   in extended memory     *
                     663     ;    ?C?PLDXPTR, ?C?PSTXPTR  ; load/store 3-BYTE PTR   in extended memory     *
                     664     ;    ?C?LLDXPTR, ?C?LSTXPTR  ; load/store DWORD (long) in extended memory     *
                     665     ;                                                                             *
                     666     ; Each function gets as a parameter the memory address with 3 BYTE POINTER    *
                     667     ; representation in the CPU registers R1/R2/R3.  The register R3 holds the    *
                     668     ; memory type.  The C51 compiler uses the following memory types:             *
                     669     ;                                                                             *
                     670     ; R3 Value | Memory Type | Memory Class | Address Range                       *
                     671     ; -----------------------+--------------+--------------------------           *
                     672     ;    00    | data/idata  | DATA/IDATA   | I:0x00     .. I:0xFF                *
                     673     ;    01    | xdata       | XDATA        | X:0x0000   .. X:0xFFFF              *
                     674     ;  02..7F  | far         | HDATA        | X:0x010000 .. X:0x7E0000            *
                     675     ;  80..FD  | far const   | HCONST       | C:0x800000 .. C:0xFD0000 (see note) *
                     676     ;    FE    | pdata       | XDATA        | one 256-byte page in XDATA memory   *
                     677     ;    FF    | code        | CODE         | C:0x0000   .. C:0xFFFF              *
                     678     ;                                                                             *
                     679     ; Note: the far const memory area is mapped into the banked memory areas.     *
                     680     ;                                                                             *
                     681     ; The R3 values 00, 01, FE and FF are already handled within the C51 run-time *
                     682     ; library.  Only the values 02..FE are passed to the XPTR access functions    *
                     683     ; described below.  The AX51 macro assembler provides the MBYTE operator      *
                     684     ; that calculates the R3 value that needs to be passed to the XPTR access     *
                     685     ; function.   AX51 Assembler example for using XPTR access functions:         *
                     686     ;     MOV  R1,#LOW   (variable)   ; gives LSB address byte of variable        *
                     687     ;     MOV  R2,#HIGH  (variable)   ; gives MSB address byte of variable        *
                     688     ;     MOV  R3,#MBYTE (variable)   ; gives memory type byte of variable        *
                     689     ;     CALL ?C?CLDXPTR             ; load BYTE variable into A                 *
                     690     ;******************************************************************************
A51 MACRO ASSEMBLER  L51_BANK                                                             11/03/2026 14:15:30 PAGE     6

                     691     
                     692     PUBLIC ?C?CLDXPTR
                     693     PUBLIC ?C?CSTXPTR
                     694     PUBLIC ?C?ILDXPTR
                     695     PUBLIC ?C?ISTXPTR
                     696     PUBLIC ?C?PLDXPTR
                     697     PUBLIC ?C?PSTXPTR
                     698     PUBLIC ?C?LLDXPTR
                     699     PUBLIC ?C?LSTXPTR
                     700     
                     701     ?C?LIB_CODE     SEGMENT CODE
----                 702                     RSEG    ?C?LIB_CODE
                     703     
                             ENDIF ; IF ?B_SSTACK = 0
                     741     
                     742     
