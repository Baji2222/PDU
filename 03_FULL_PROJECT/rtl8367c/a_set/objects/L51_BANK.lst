                     432                             SWITCH  24
                     442                             SWITCH  25
                     452                             SWITCH  26
                     462                             SWITCH  27
                     472                             SWITCH  28
                     482                             SWITCH  29
                     492                             SWITCH  30
                     502                             SWITCH  31
                     512     
015C                 513             ?B_BANK_CALL:
015C E4              514                             CLR     A
015D 73              515                             JMP     @A+DPTR
015E 22              516                             RET
                     517                 
                                 ENDIF ; IF ?B_SSTACK = 1
