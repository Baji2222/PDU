001E 93              769                         MOVC    A, @A+DPTR
001F F5F0            770                         MOV     B, A
0021 7401            771                         MOV     A, #1
0023 93              772                         MOVC    A, @A+DPTR
0024 D096            773                         POP     CODE_BANK
0026 22              774                         RET
                     775     
