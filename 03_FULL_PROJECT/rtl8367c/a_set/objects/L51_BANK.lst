                     744         ; not support far-access for HDATA
                     745         ; CLDXPTR: Load   BYTE in A             via Address given in R1/R2/R3
0000                 746         ?C?CLDXPTR:
0000 C096            747                         PUSH    CODE_BANK
0002 EB              748                         MOV     A, R3
0003 14              749                         DEC     A
