  82          /*
  83           * Function: get_fwug
  84           * ------------------
  85           * Serves the firmware upgrade page (GET request).
  86           * Displays HTML with "Enter Loader Mode" button.
  87           * No parameters needed, simply returns the loader page.
  88           */
  89          int32 get_fwug(struct http_request_s *pReq)
  90          {
  91   1          WEB_BEGIN(pReq);
  92   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
  93   1          WEB_HEADER(pReq, "Content-Type: text/html");
  94   1          WEB_DATA(pReq, htm_loader, sizeof(htm_loader));
  95   1          WEB_END(pReq);
  96   1          return SUCCESS;
  97   1      }
  98          /*
  99           * Function: post_fwug
 100           * -------------------
 101           * Handles firmware upgrade form submission (POST request).
 102           * Shows "Entering Loader Mode" progress page.
 103           * Calls sal_sys_loaderMode_set() to switch to bootloader mode.
 104           * Device reboots and enters loader mode after this function.
 105           */
 106          int32 post_fwug(struct http_request_s *pReq)
 107          {
 108   1          WEB_BEGIN(pReq);
 109   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
 110   1          WEB_HEADER(pReq, "Content-Type: text/html");
 111   1          WEB_DATA(pReq, htm_enter_loader, sizeof(htm_enter_loader));
 112   1          WEB_END(pReq);
 113   1          sal_sys_loaderMode_set();
