                          break;
                      case 0x0652:
                      case 0x6368:
                          type = 2;
                          break;
                      case 0x0801:
                      case 0x6511:
                          type = 3;
                          break;
                      default:
                          return RT_ERR_FAILED;
                  }
              
              
