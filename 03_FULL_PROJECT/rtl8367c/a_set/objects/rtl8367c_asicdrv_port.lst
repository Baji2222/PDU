                          else if (((regData >> 8) & 0x1f) == 5)
                          {
                              *pMode = EXT_100FX;
                              return RT_ERR_OK;
                          }
                          else if (((regData >> 8) & 0x1f) == 7)
                          {
                              *pMode = EXT_1000X_100FX;
                              return RT_ERR_OK;
