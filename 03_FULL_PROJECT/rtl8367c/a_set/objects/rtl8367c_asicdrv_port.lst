                              *pMode = EXT_SGMII;
                              return RT_ERR_OK;
                          }
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_PORT                                             11/03/2026 14:15:48 PAGE 73  

              
                          else if (((regData >> 8) & 0x1f) == 4)
