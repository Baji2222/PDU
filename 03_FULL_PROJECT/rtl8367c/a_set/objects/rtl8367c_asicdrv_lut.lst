                  if(portmask > RTL8367C_PORTMASK)
                      return RT_ERR_PORT_MASK;
              
                  retVal = rtl8367c_setAsicRegBits(RTL8367C_REG_LUT_LRN_SYS_LMT_CTRL, RTL8367C_LUT_SYSTEM_LEARN_PMASK_MA
             -SK, portmask & 0xff);
                  if(retVal != RT_ERR_OK)
                      return retVal;
                  retVal = rtl8367c_setAsicRegBits(RTL8367C_REG_LUT_LRN_SYS_LMT_CTRL, RTL8367C_LUT_SYSTEM_LEARN_PMASK1_M
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_LUT                                              11/03/2026 14:15:45 PAGE 12  

             -ASK, (portmask>>8) & 0x7);
