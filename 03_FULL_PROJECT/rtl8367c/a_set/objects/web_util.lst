  69          /*
  70           * Function: printmsg
  71           * ------------------
  72           * Displays custom message page and redirects back.
  73           * Removes newline characters from message for safe display.
  74           * Shows message alert in popup window via JavaScript.
  75           * Redirects to /goback.cgi after showing message.
  76           */
  77          void
  78          printmsg (
  79              struct http_request_s *pReq,
  80              char *  msg
  81              )
  82          {
  83   1          int i;
  84   1          char msg_temp[128];
  85   1      
  86   1          WEB_BEGIN(pReq);
  87   1      
  88   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
  89   1          WEB_HEADER(pReq, "Content-Type: text/html");
  90   1          
  91   1          WEB_PRINTF(pReq, "<html>\n");
  92   1          WEB_PRINTF(pReq, "\n");
  93   1          WEB_PRINTF(pReq, "<head>\n");
  94   1          WEB_PRINTF(pReq, "<title>Message</title>\n");
  95   1          WEB_PRINTF(pReq, "</head>\n");
  96   1          WEB_PRINTF(pReq, "\n");
  97   1          WEB_PRINTF(pReq, "<body>\n");
  98   1          WEB_PRINTF(pReq, "<script type=\"text/javascript\">\n");
  99   1          i = 0;
 100   1          strncpy(msg_temp, msg, 128);
 101   1          while(msg_temp[i] != '\0')
 102   1          {
 103   2                  if(msg_temp[i] == '\n')
 104   2                  {
 105   3                  msg_temp[i] = ' ';
 106   3                  }
 107   2                  i ++;
 108   2          }
 109   1          WEB_PRINTF(pReq, "window.location.replace(\"/goback.cgi\");\n");
 110   1          WEB_PRINTF(pReq, "window.open(\'/alert.cgi?alertmsg=%s\',\'hidden_frame\',\'\');\n", msg_temp);
 111   1          WEB_PRINTF(pReq, "</script>\n");
 112   1          WEB_PRINTF(pReq, "</body>\n");
 113   1          WEB_PRINTF(pReq, "</html>\n");
