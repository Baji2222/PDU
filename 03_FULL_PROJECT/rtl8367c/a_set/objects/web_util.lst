 117          /*
 118           * Function: strnstr
 119           * -----------------
 120           * Finds first occurrence of substring needle in haystack.
 121           * Searches within first 'hlen' characters of haystack.
 122           * Returns pointer to beginning of match or NULL if not found.
 123           * Safe version of strstr with length limit.
 124           */
 125          char *
 126          strnstr (const char *haystack, const char *needle, uint16 hlen)
 127          {
 128   1          uint16 nlen;
 129   1                                                                                      
 130   1          if (!needle || !*needle)
 131   1              return (char *)haystack;
 132   1          else
 133   1              nlen = strlen (needle);
 134   1                                                                                      
 135   1          while (hlen >= nlen) {
 136   2              if (*needle == *haystack && !strncmp (haystack + 1, needle + 1,
 137   2                                                    nlen - 1))
 138   2                  return (char *) haystack;
 139   2              haystack++; hlen--;
 140   2          }
 141   1                                                                                      
 142   1          return NULL;
 143   1      }


