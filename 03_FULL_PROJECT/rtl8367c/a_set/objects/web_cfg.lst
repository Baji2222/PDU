 101          /*
 102           * Function: get_http_config
 103           * -------------------------
 104           * Handles HTTP requests for configuration backup/restore page.
 105           * 
 106           * How it works:
 107           * - If cmd=conf_backup parameter is present: Sends the entire configuration 
 108           *   file (switch_cfg.bin) as a downloadable attachment
C51 COMPILER V9.60.0.0   WEB_CFG                                                           11/03/2026 14:15:57 PAGE 3   

 109           * - If no command parameter: Displays the HTML page with Backup/Restore buttons
 110           * - If unknown command: Returns HTTP 404 Not Found
 111           * 
 112           * Key steps:
 113           * 1. Reads 'cmd' parameter from request
 114           * 2. For backup: Gets config size and address from flash, sets appropriate 
 115           *    HTTP headers (Content-Type, Content-Disposition, Content-Length), 
 116           *    streams config data
 117           * 3. For no command: Serves HTML page with backup/restore UI
 118           */
 119          int32 get_http_config(http_request_t *pReq)
 120          {
 121   1          uint8  buf[32];
 122   1          uint8  *pValue = NULL;
 123   1          uint8  *configPtr;
 124   1          uint16 configSize;    
 125   1      
 126   1          /* check command */
 127   1          WEB_VAR(pReq, "cmd", &pValue);
 128   1          if (pValue) {
 129   2              if (strcmp(pValue, "conf_backup") == 0) {
 130   3                  printf("back up\n");
 131   3                  WEB_BEGIN(pReq);
 132   3                  
 133   3                  WEB_STATUS(pReq, HTTP_STATUS_OK);
 134   3                  WEB_HEADER(pReq, "Pragma: no-cache");
 135   3                  
 136   3                  sal_flash_cfgSize_get(&configSize);
 137   3                  sprintf(buf, "Content-Length: %d", configSize);
 138   3              
 139   3                  WEB_HEADER(pReq, buf);
 140   3                  WEB_HEADER(pReq, "Content-Type: application/octet-stream; name=switch_cfg.bin");
 141   3                  WEB_HEADER(pReq, "Content-Disposition: attachment; filename=switch_cfg.bin");
 142   3                  WEB_HEADER(pReq, "Connection: close");
 143   3      
 144   3                  sal_flash_cfgAddr_get(&configPtr);
 145   3                  WEB_DATA(pReq, configPtr, configSize);
 146   3      
 147   3                  WEB_END(pReq);
 148   3              } else {
 149   3                  WEB_BEGIN(pReq);
 150   3                  
 151   3                  WEB_STATUS(pReq, HTTP_STATUS_NOT_FOUND);
 152   3                  
 153   3                  WEB_END(pReq);
 154   3              }
 155   2          }
 156   1          else
 157   1          {
 158   2              WEB_BEGIN(pReq);
 159   2              
 160   2              WEB_STATUS(pReq, HTTP_STATUS_OK);
 161   2              WEB_HEADER(pReq, "Content-Type: text/html");
 162   2              
 163   2              WEB_DATA(pReq, htm_config, sizeof(htm_config));
 164   2              
 165   2              WEB_END(pReq);
 166   2          }
 167   1      
 168   1          return SUCCESS;
 169   1      }
