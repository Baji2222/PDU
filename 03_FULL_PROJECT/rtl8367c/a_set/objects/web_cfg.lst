 171          /*
 172           * Function: post_http_restore
 173           * ---------------------------
 174           * Handles configuration restore from uploaded file.
 175           * 
 176           * How it works:
 177           * - Receives uploaded configuration file in chunks (multipart upload)
 178           * - Validates file signature (checks magic word at beginning)
 179           * - Writes data to config cache chunk by chunk
 180           * - After last chunk, saves config to flash
 181           * 
 182           * Key steps:
 183           * 1. First block (upload_offset == 0):
 184           *    - Validates the config signature using sal_flash_cfgValidity_get()
 185           *    - If valid: writes first chunk to cache
 186           *    - If invalid: sets error flag and shows failure page
 187           * 
 188           * 2. Subsequent blocks:
 189           *    - Checks if upload is still valid
 190           *    - Writes chunk to cache at correct offset
 191           *    - Detects last block (when offset + length >= config size)
 192           * 
 193           * 3. On last block:
 194           *    - Calls sal_flash_cfg_save() to write cache to flash
 195           *    - Shows success or failure page accordingly
 196           * 
 197           * 4. Error handling:
 198           *    - Wrong signature: http_upload_result = -1
 199           *    - Success: http_upload_result = 1
 200           *    - Displays appropriate HTML response (success/failure)
 201           */
 202          int32 post_http_restore(http_request_t *pReq)
 203          {
 204   1          uint16                      config_size;
 205   1          sal_flash_configValidity_t  isValid;
 206   1      
 207   1          /* write data into flash */
 208   1          if (0 == pReq->upload_offset)
 209   1          {
 210   2              /* first block */
 211   2              /* check the mark (do not consider breaking) */
 212   2              sal_flash_cfgValidity_get(pReq->upload_data,&isValid);
 213   2              if (SAL_FLASH_CONFIG_VALID == isValid)
 214   2              {
 215   3                  http_upload_result = 0;     /* init: Normal state */
 216   3      
 217   3                  sal_flash_cfg_set(0, pReq->upload_len, pReq->upload_data);
 218   3              }
 219   2              else
 220   2              {
 221   3                  /* error (signature word is wrong) */
 222   3                  http_upload_result = -1;   /* WRONG SIGNATURE */
 223   3      
 224   3                  /*show failed webpage*/
 225   3                  WEB_BEGIN(pReq);
 226   3                  WEB_STATUS(pReq, HTTP_STATUS_OK);
 227   3                  WEB_HEADER(pReq, "Content-Type: text/html");
 228   3                  WEB_DATA(pReq, htm_conf_restore_failed, sizeof(htm_conf_restore_failed));
 229   3                  WEB_END(pReq);
 230   3                  
 231   3                  return SUCCESS;
 232   3              }
C51 COMPILER V9.60.0.0   WEB_CFG                                                           11/03/2026 14:15:57 PAGE 5   

 233   2          }
 234   1          else
 235   1          {
 236   2              if(http_upload_result != -1)
 237   2              {
 238   3                  if (pReq->upload_offset < sizeof(ConfigCache) && (0 == http_upload_result))
 239   3                  {
 240   4                      if ((pReq->upload_offset + pReq->upload_len) >= sizeof(ConfigCache)) 
 241   4                      {
 242   5                          /* last block */
 243   5                          http_upload_result = 1;    /* OK */
 244   5      
 245   5                          sal_flash_cfgSize_get(&config_size);
 246   5                          sal_flash_cfg_set(pReq->upload_offset, config_size - pReq->upload_offset, pReq->upload
             -_data);
 247   5                          if(pReq->upload_len > (config_size - pReq->upload_offset))
 248   5                          {
 249   6                              http_upload_last_block = 1;
 250   6                          }
 251   5                      }
 252   4                      else
 253   4                      {
 254   5                          sal_flash_cfg_set(pReq->upload_offset, pReq->upload_len, pReq->upload_data);
 255   5                      }
 256   4                  }
 257   3                  else
 258   3                  {
 259   4                      http_upload_last_block = 1;
 260   4                  }
 261   3              }
 262   2          }
 263   1      
 264   1          /* show webpage at ending */
 265   1          if (http_upload_last_block)
 266   1          {
 267   2              http_upload_last_block = 0;
 268   2      
 269   2              WEB_BEGIN(pReq);
 270   2                      
 271   2              WEB_STATUS(pReq, HTTP_STATUS_OK);
 272   2              WEB_HEADER(pReq, "Content-Type: text/html");
 273   2      
 274   2              if (0 < http_upload_result)
 275   2              {
 276   3                  sal_flash_cfg_save();
 277   3                  WEB_DATA(pReq, htm_must_reboot, sizeof(htm_must_reboot));
 278   3              }
 279   2              else if (0 >= http_upload_result)
 280   2              {
 281   3                  WEB_DATA(pReq, htm_conf_restore_failed, sizeof(htm_conf_restore_failed));
 282   3              }
 283   2      
 284   2              WEB_END(pReq);
 285   2          }
 286   1      
 287   1          return SUCCESS;
 288   1      }
