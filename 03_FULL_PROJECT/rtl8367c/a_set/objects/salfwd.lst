 305          // Sal Rate Storm Control Get: Retrieves storm control rate for specific traffic type
 306          // Gets rate limit from hardware for specified storm type
 307          int32
 308          sal_rate_stormControl_get(
 309            sal_port_t  portId,
 310            sal_stormCtrl_type_t  type,
 311            uint32 *pRate)
 312          {
 313   1        int32       ret;
 314   1        sal_port_t  port;
 315   1        uint32      Ifg_include;
 316   1          uint32 rate;
 317   1      
 318   1          SAL_ERR_CHK_EXPR((type > SAL_STORM_TYPE_BCAST), SAL_ERR_STRM_CTRL_UNKNOWN_FILTER);
 319   1      
 320   1          sal_trunk_logicId_toPhysicId(&port, portId);
 321   1          
 322   1      #if defined(LWS_8G_2F)
                  if(port == EXT_PORT0)
                      port = 8;
                  else if(port == EXT_PORT1)
                      port = 9;
              #elif defined(LWS_5G_1F)
                  if(port == EXT_PORT0)
                      port = 5; //tmp use 5 instead of 6 to make meter in index 31
              #endif
 331   1      
 332   1          switch(type)
 333   1          {
 334   2          case SAL_STORM_TYPE_BCAST:
 335   2              if((ret = rtl8367c_getAsicShareMeter(BCAST_METER(port), &rate, &Ifg_include))!=0)
 336   2                  return ret;
 337   2              break;
 338   2          case SAL_STORM_TYPE_MCAST:
 339   2              if((ret = rtl8367c_getAsicShareMeter(MCAST_METER(port), &rate, &Ifg_include))!=0)
 340   2                  return ret;
 341   2              break;        
 342   2          case SAL_STORM_TYPE_UNKNOWN_MCAST:
 343   2              if((ret = rtl8367c_getAsicShareMeter(UNMC_METER(port), &rate, &Ifg_include))!=0)
 344   2                  return ret;
 345   2              break;        
 346   2          case SAL_STORM_TYPE_UNKNOWN_UCAST:
 347   2              if((ret = rtl8367c_getAsicShareMeter(UNDA_METER(port), &rate, &Ifg_include))!=0)
 348   2                  return ret;
 349   2              break;        
 350   2          }
 351   1          rate = rate * 8;
 352   1      
 353   1          SAL_ERR_CODE(ret, SAL_ERR_STRM_CTRL);
 354   1      
 355   1          *pRate = rate;
 356   1      
 357   1          return SAL_ERR_SUCCESS;
 358   1      }
