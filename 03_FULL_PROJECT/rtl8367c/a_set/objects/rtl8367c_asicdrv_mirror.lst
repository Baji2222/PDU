               * Return:
               *      RT_ERR_OK       - Success
               *      RT_ERR_SMI      - SMI access error
               * Note:
               *      None
               */
              ret_t rtl8367c_getAsicPortMirrorOverride(uint32 *pRxMirror, uint32 *pTxMirror, uint32 *pAclMirror)
              {
                  ret_t retVal;
              
                  if((retVal = rtl8367c_getAsicRegBit(RTL8367C_REG_MIRROR_CTRL3, RTL8367C_MIRROR_RX_OVERRIDE_EN_OFFSET, 
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_MIRROR                                           11/03/2026 14:15:46 PAGE 9   

             -pRxMirror)) != RT_ERR_OK)
                      return retVal;
              
                  if((retVal = rtl8367c_getAsicRegBit(RTL8367C_REG_MIRROR_CTRL3, RTL8367C_MIRROR_TX_OVERRIDE_EN_OFFSET, 
             -pTxMirror)) != RT_ERR_OK)
                      return retVal;
              
                  if((retVal = rtl8367c_getAsicRegBit(RTL8367C_REG_MIRROR_CTRL3, RTL8367C_MIRROR_ACL_OVERRIDE_EN_OFFSET,
