C51 COMPILER V9.60.0.0   VLAN                                                              11/02/2026 17:57:13 PAGE 2   

  52           * Note:
  53           *      VLAN is disabled by default. User has to call this API to enable VLAN before
  54           *      using it. And It will set a default VLAN(vid 1) including all ports and set
  55           *      all ports PVID to the default VLAN.
  56           */
  57          rtk_api_ret_t rtk_vlan_init(void)
  58          {
  59   1          rtk_api_ret_t retVal;
  60   1          uint32 i;
  61   1          rtl8367c_user_vlan4kentry vlan4K;
  62   1          rtl8367c_vlanconfiguser vlanMC;
  63   1      
  64   1          /* Check initialization state */
  65   1          RTK_CHK_INIT_STATE();
  66   1      
  67   1          /* Clean Database */
  68   1          memset(vlan_mbrCfgVid, 0x00, sizeof(rtk_vlan_t) * RTL8367C_CVIDXNO);
  69   1          memset(vlan_mbrCfgUsage, 0x00, sizeof(vlan_mbrCfgType_t) * RTL8367C_CVIDXNO);
  70   1      
  71   1          /* clean 32 VLAN member configuration */
  72   1          for (i = 0; i <= RTL8367C_CVIDXMAX; i++)
  73   1          {
  74   2              vlanMC.evid = 0;
  75   2              vlanMC.mbr = 0;
  76   2              vlanMC.fid_msti = 0;
  77   2              vlanMC.envlanpol = 0;
  78   2              vlanMC.meteridx = 0;
  79   2              vlanMC.vbpen = 0;
  80   2              vlanMC.vbpri = 0;
  81   2              if ((retVal = rtl8367c_setAsicVlanMemberConfig(i, &vlanMC)) != RT_ERR_OK)
  82   2                  return retVal;
  83   2          }
  84   1      
  85   1          /* Set a default VLAN with vid 1 to 4K table for all ports */
  86   1          memset(&vlan4K, 0, sizeof(rtl8367c_user_vlan4kentry));
  87   1          vlan4K.vid = 1;
  88   1          vlan4K.mbr = RTK_PHY_PORTMASK_ALL;
  89   1          vlan4K.untag = RTK_PHY_PORTMASK_ALL;
  90   1          vlan4K.fid_msti = 0;
  91   1          if ((retVal = rtl8367c_setAsicVlan4kEntry(&vlan4K)) != RT_ERR_OK)
  92   1              return retVal;
  93   1      
  94   1          /* Also set the default VLAN to 32 member configuration index 0 */
  95   1          memset(&vlanMC, 0, sizeof(rtl8367c_vlanconfiguser));
  96   1          vlanMC.evid = 1;
  97   1          vlanMC.mbr = RTK_PHY_PORTMASK_ALL;
  98   1          vlanMC.fid_msti = 0;
  99   1          if ((retVal = rtl8367c_setAsicVlanMemberConfig(0, &vlanMC)) != RT_ERR_OK)
 100   1                  return retVal;
 101   1      
 102   1          /* Set all ports PVID to default VLAN and tag-mode to original */
 103   1          RTK_SCAN_ALL_PHY_PORTMASK(i)
 104   1          {
 105   2              if ((retVal = rtl8367c_setAsicVlanPortBasedVID(i, 0, 0)) != RT_ERR_OK)
 106   2                  return retVal;
 107   2              if ((retVal = rtl8367c_setAsicVlanEgressTagMode(i, EG_TAG_MODE_ORI)) != RT_ERR_OK)
 108   2                  return retVal;
 109   2          }
 110   1      
 111   1          /* Updata Databse */
 112   1          vlan_mbrCfgUsage[0] = MBRCFG_USED_BY_VLAN;
 113   1          vlan_mbrCfgVid[0] = 1;
C51 COMPILER V9.60.0.0   VLAN                                                              11/02/2026 17:57:13 PAGE 3   

 114   1      
 115   1          /* Enable Ingress filter */
 116   1          RTK_SCAN_ALL_PHY_PORTMASK(i)
 117   1          {
 118   2              if ((retVal = rtl8367c_setAsicVlanIngressFilter(i, ENABLED)) != RT_ERR_OK)
 119   2                  return retVal;
 120   2          }
 121   1      
 122   1          /* enable VLAN */
 123   1          if ((retVal = rtl8367c_setAsicVlanFilter(ENABLED)) != RT_ERR_OK)
 124   1              return retVal;
 125   1      
 126   1          return RT_ERR_OK;
 127   1      }
