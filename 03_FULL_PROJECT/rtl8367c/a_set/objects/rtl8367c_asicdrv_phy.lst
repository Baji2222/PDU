 259          /* Function Name:
 260           *      rtl8367c_setAsicPHYReg
 261           * Description:
 262           *      Set PHY registers
 263           * Input:
 264           *      phyNo   - Physical port number (0~7)
 265           *      phyAddr - PHY address (0~31)
 266           *      phyData - Writing data
 267           * Output:
 268           *      None
 269           * Return:
 270           *      RT_ERR_OK               - Success
 271           *      RT_ERR_SMI              - SMI access error
 272           *      RT_ERR_PHY_REG_ID       - invalid PHY address
 273           *      RT_ERR_PHY_ID           - invalid PHY no
 274           *      RT_ERR_BUSYWAIT_TIMEOUT - PHY access busy
 275           * Note:
 276           *      None
 277           */
 278          ret_t rtl8367c_setAsicPHYReg( uint32 phyNo, uint32 phyAddr, uint32 phyData)
 279          {
 280   1          uint32 ocp_addr;
 281   1      
 282   1          if(phyAddr > RTL8367C_PHY_REGNOMAX)
 283   1              return RT_ERR_PHY_REG_ID;
 284   1      
 285   1          ocp_addr = 0xa400 + phyAddr*2;
 286   1      
 287   1          return rtl8367c_setAsicPHYOCPReg(phyNo, ocp_addr, phyData);
 288   1      }
