               * Output:
               *      None.
               * Return:
               *      RT_ERR_OK          - OK
               *      RT_ERR_FAILED      - Failed
               *      RT_ERR_SMI         - SMI access error
               *      RT_ERR_TBL_FULL    - Table Full
               * Note:
               *      Add an entry to IP Multicast Group table.
               */
              rtk_api_ret_t rtk_l2_ipMcastGroupEntry_add(ipaddr_t ip_addr, uint32 vid, rtk_portmask_t *pPortmask)
              {
                  uint32      empty_idx = 0xFFFF;
                  uint32       index;
                  ipaddr_t        group_addr;
                  uint32      group_vid;
                  uint32      pmask;
                  uint32      valid;
                  uint32      physicalPortmask;
                  rtk_api_ret_t   retVal;
              
                  /* Check initialization state */
                  RTK_CHK_INIT_STATE();
              
                  if (vid > RTL8367C_VIDMAX)
                      return RT_ERR_L2_VID;
              
