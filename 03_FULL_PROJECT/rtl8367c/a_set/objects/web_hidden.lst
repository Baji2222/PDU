  81          /*
  82           * Function: get_alert
  83           * -------------------
  84           * Generates HTML page with JavaScript alert dialog.
  85           * Displays custom message passed as parameter (pMsg).
  86           * After alert, redirects to /hidden.cgi page.
  87           */
  88          int8 get_alert(struct http_request_s *pReq, uint8 *pMsg)
  89          {
  90   1          DBG_LWPS_HTTP_PRINTF(("-------get_alert()-------\n"));
  91   1      
  92   1          WEB_BEGIN(pReq);
  93   1          
  94   1          WEB_STATUS(pReq, HTTP_STATUS_OK);
  95   1          WEB_HEADER(pReq, "Content-Type: text/html");
  96   1      
  97   1          WEB_PRINTF(pReq, "<html>\n");
  98   1          WEB_PRINTF(pReq, "\n");
  99   1          WEB_PRINTF(pReq, "<head>\n");
 100   1          WEB_PRINTF(pReq, "<title>Message</title>\n");
 101   1          WEB_PRINTF(pReq, "</head>\n");
 102   1          WEB_PRINTF(pReq, "\n");
 103   1          WEB_PRINTF(pReq, "<body>\n");
 104   1          WEB_PRINTF(pReq, "<script type=\"text/javascript\">");
 105   1          WEB_PRINTF(pReq, "alert(\"%s\");\n", pMsg);
 106   1          WEB_PRINTF(pReq, "window.location.replace(\'/hidden.cgi\')\n");
 107   1          WEB_PRINTF(pReq, "</script>");
 108   1          WEB_PRINTF(pReq, "</body>\n");
 109   1          WEB_PRINTF(pReq, "</html>\n");
 110   1          
 111   1          WEB_END(pReq);
 112   1      
 113   1          return SUCCESS;
