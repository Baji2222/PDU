 654   1          "      throw new Error('Invalid Alarm Data Received');"
 654   1          "    }"
 654   1      
 654   1          "    let diff = j.S - currS;"
 654   1          "    if (diff < -10) diff += 60;"
 654   1          "    if (diff < 0 || diff > 3) { currH = j.H; currM = j.M; currS = j.S; }"
 654   1          
 654   1          "    d.textContent=p2(j.D)+'/'+p2(j.MO)+'/'+j.Y;"
 654   1          
 654   1          "    alarms[0] = {h: j.A1H, m: j.A1M, o: j.O1, s: j.S1};"
