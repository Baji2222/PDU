 654   1          "    let a = alarms[i];"
 654   1          
 654   1          "    let nowTotalMins = (currH * 60) + currM;"
 654   1          "    let targetTotalMins = (a.h * 60) + a.m;"
 654   1          "    let diff = targetTotalMins - nowTotalMins;"
