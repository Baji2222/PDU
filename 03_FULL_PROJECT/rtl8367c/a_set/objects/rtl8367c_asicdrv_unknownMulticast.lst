               *      None
               */
              ret_t rtl8367c_getAsicUnknownL2MulticastBehavior(uint32 port, uint32 *pBehave)
              {
                  ret_t retVal;
              
                  if(port >  RTL8367C_PORTIDMAX)
                      return RT_ERR_PORT_ID;
              
                  if(port < 8)
                  {
                      retVal = rtl8367c_getAsicRegBits(RTL8367C_UNKNOWN_L2_MULTICAST_REG(port), RTL8367C_UNKNOWN_L2_MULT
             -ICAST_MASK(port), pBehave);
                      if (retVal != RT_ERR_OK)
