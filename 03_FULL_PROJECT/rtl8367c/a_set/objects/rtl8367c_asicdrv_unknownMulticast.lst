              /* Function Name:
               *      rtl8367c_setAsicUnknownMulticastTrapPriority
               * Description:
               *      Set trap priority of unknown multicast frame
               * Input:
               *      priority    - priority (0~7)
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK               - Success
               *      RT_ERR_SMI              - SMI access error
               *      RT_ERR_QOS_INT_PRIORITY - Invalid priority
               * Note:
               *      None
               */
              ret_t rtl8367c_setAsicUnknownMulticastTrapPriority(uint32 priority)
              {
                  if(priority > RTL8367C_PRIMAX)
                      return RT_ERR_QOS_INT_PRIORITY;
              
                  return rtl8367c_setAsicRegBits(RTL8367C_QOS_TRAP_PRIORITY_CTRL0_REG, RTL8367C_UNKNOWN_MC_PRIORTY_MASK,
             - priority);
              }
