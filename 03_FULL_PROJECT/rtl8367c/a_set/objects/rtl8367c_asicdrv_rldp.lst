              /* Function Name:
               *      rtl8367c_setAsicRldpMagicNum
               * Description:
               *      Set Random seed of RLDP
               * Input:
               *      seed    - MAC
               * Output:
               *      None
               * Return:
               *      RT_ERR_OK   - Success
               *      RT_ERR_SMI  - SMI access error
               * Note:
               *      None
               */
              ret_t rtl8367c_setAsicRldpMagicNum(ether_addr_t seed)
              {
                  ret_t retVal;
                  uint32 regData;
                  uint16 *accessPtr;
                  uint32 i;
              
                  accessPtr = (uint16*)&seed;
              
                  for (i = 0; i < 3; i++)
                  {
                      regData = *accessPtr;
                      retVal = rtl8367c_setAsicReg(RTL8367C_RLDP_MAGIC_NUM_REG_BASE + i, regData);
                      if(retVal != RT_ERR_OK)
                          return retVal;
              
                      accessPtr++;
                  }
              
                  return retVal;
