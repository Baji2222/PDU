              ret_t rtl8367c_getAsicRldpRandomNumber(ether_addr_t *pRandNumber)
              {
                  ret_t retVal;
                  uint32 regData;
                  int16 accessPtr[3];
                  uint32 i;
              
                  for(i = 0; i < 3; i++)
                  {
