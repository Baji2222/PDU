 179   2      
 180   2              free(field1);
 181   2      
 182   2              break;
 183   2          case SAL_LOOP_MODE_RLDP:
 184   2              rlpp_setState(FALSE);    
 185   2              rtl8367c_setAsicRldp(TRUE);
 186   2              
 187   2              /////////////////////////////
 188   2              /* enable rldp & change rldp to periodically mode */
 189   2              setReg(0x18e0, 0x4009);
 190   2      
 191   2              /* Configure the */
 192   2              sal_sys_mac_get(&mac);
 193   2              setReg(0x18e8, (mac.octet[4] << 8) | mac.octet[5]);
 194   2              setReg(0x18e9, (mac.octet[2] << 8) | mac.octet[3]);
 195   2              setReg(0x18ea, (mac.octet[0] << 8) | mac.octet[1]);
 196   2      
 197   2              /* set tx period */
