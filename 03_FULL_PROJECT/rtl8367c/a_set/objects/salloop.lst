 249          int32 sal_loop_portStatus_get(sal_port_t port, sal_loop_port_status_t *status)
 250          {
 251   1          rlpp_port_state_t rlpp_state;
 252   1          uint16            rldp_loop_pmsk;
 253   1          sal_port_macStatus_t    mac_status;
 254   1      
 255   1          if(SAL_LOOP_MODE_RLPP == currentMode)
 256   1          {
 257   2              rlpp_getPortState(port, &rlpp_state);
 258   2              sal_port_macStatus_get(port, &mac_status);
 259   2              if(RLPP_FORWARDING_STATE == rlpp_state)
 260   2                  *status = SAL_LOOP_STATUS_FREE;
 261   2              else
 262   2              {
 263   3                  if(mac_status.linkup == TRUE)
 264   3                  {
 265   4                  *status = SAL_LOOP_STATUS_RLPP;
 266   4                  }
 267   3                  else
 268   3                  {
 269   4                      *status = SAL_LOOP_STATUS_FREE;
 270   4                  }            
 271   3              }
 272   2      
 273   2              return SAL_ERR_SUCCESS;
 274   2          }
 275   1          else if(SAL_LOOP_MODE_RLDP == currentMode)
 276   1          {
 277   2              rldp_loop_pmsk = getReg(0x18f1);
 278   2              if(rldp_loop_pmsk & (1 << port))
 279   2                  *status = SAL_LOOP_STATUS_RLDP;
 280   2              else
 281   2                  *status = SAL_LOOP_STATUS_FREE;
 282   2          }
 283   1          else
 284   1              *status = SAL_LOOP_STATUS_FREE;
 285   1      
