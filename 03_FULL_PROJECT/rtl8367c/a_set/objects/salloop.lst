 199   2              rlpp_recover_time_get(&recover_time);
 200   2              tmp = recover_time/interval_time;
 201   2              if(tmp == 0)
 202   2                  tmp = 1;
 203   2              tmp = tmp | (tmp << 8);
 204   2              setReg(0x18e2, interval_time*1000);
 205   2              setReg(0x18e3, interval_time*1000);
 206   2              setReg(0x18e1, 0x0404);
 207   2              /////////////////////////////
 208   2      
 209   2            /* Remove ACL rule */
 210   2              sal_filter_igrAcl_cfg_del(61);
 211   2      
 212   2              break;    
 213   2          case SAL_LOOP_MODE_DISABLE:
 214   2              rlpp_setState(FALSE);    
 215   2              rtl8367c_setAsicRldp(FALSE);
 216   2              /* Clear looped port mask */
 217   2              tmp = getReg(0x18e0);
 218   2              tmp |= 0x0010;
 219   2              setReg(0x18e0, tmp);
 220   2              tmp &= ~0x0010;
