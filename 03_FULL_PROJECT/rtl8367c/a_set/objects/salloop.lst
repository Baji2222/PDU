 136   1          rtk_filter_number_t ruleNum;
 137   1      
 138   1          if( mode >= SAL_LOOP_MODE_END)
 139   1              return SAL_ERR_PARAMETER;
 140   1      
 141   1          currentMode = mode;
 142   1      
 143   1          switch(mode)
 144   1          {
 145   2          case SAL_LOOP_MODE_RLPP:
 146   2              rlpp_setState(TRUE);    
 147   2              rtl8367c_setAsicRldp(FALSE);
 148   2              /* Clear looped port mask */
 149   2              tmp = getReg(0x18e0);
 150   2              tmp |= 0x0010;
 151   2              setReg(0x18e0, tmp);
 152   2              tmp &= ~0x0010;
 153   2              setReg(0x18e0, tmp);
 154   2      
 155   2            /* Add ACL rule 61 to trap RTK pakcets to cpu port */
 156   2              /* Add ACL rule 1 ARP+(DA=switch MAC)->redirect to 8051 with priority 1+ policing(meter 1)*/
 157   2            memset(&cfg, 0x00, sizeof(rtk_filter_cfg_t));
 158   2              memset(&act, 0x00, sizeof(rtk_filter_action_t));
 159   2              field1= malloc(sizeof(rtk_filter_field_t));
 160   2              memset(field1, 0, sizeof(rtk_filter_field_t));
 161   2      
 162   2            field1->fieldType = FILTER_FIELD_ETHERTYPE;
 163   2              field1->filter_pattern_union.etherType.dataType = FILTER_FIELD_DATA_MASK;
 164   2            field1->filter_pattern_union.etherType.value       = 0x8899;
 165   2            field1->filter_pattern_union.etherType.mask        =0xffff;
 166   2            sal_filter_igrAcl_field_add(&cfg, field1);
 167   2              
 168   2              cfg.activeport.value.bits[0]    = aclAllPortMask;
 169   2              cfg.activeport.mask.bits[0]     = aclAllPortMask;
 170   2              cfg.invert = FALSE;
 171   2      
 172   2              /* Action :  */
 173   2              act.actEnable[FILTER_ENACT_TRAP_CPU] = TRUE;
