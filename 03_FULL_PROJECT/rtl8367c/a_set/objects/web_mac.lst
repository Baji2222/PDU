 945   1          uint8   port[SAL_MAX_LOGIC_COMBO_PORT];
 946   1          uint8   settingCnt;     // the total port numbers to set
 947   1          Tbool   enable;
 948   1          uint32  limits;
 949   1          settingCnt = 0;
 950   1          enable = DISABLE;
 951   1      
 952   1          WEB_VAR(pReq, "portid", &pValue);
 953   1          if (pValue) {
 954   2              port[settingCnt++] = atoi(pValue);
 955   2          }
 956   1      
 957   1          while(pValue != NULL)
 958   1          {
 959   2              WEB_VAR(pReq, NULL, &pValue);
 960   2              if (pValue) {
 961   3                  port[settingCnt++] = atoi(pValue);
 962   3              }
 963   2          }
 964   1      
 965   1          WEB_VAR(pReq, "state", &pValue);
 966   1          if (pValue) {
 967   2              enable = atoi(pValue);
 968   2          }
 969   1      
 970   1          if (enable != DISABLE)
 971   1          {
 972   2              WEB_VAR(pReq, "limit", &pValue);
C51 COMPILER V9.60.0.0   WEB_MAC                                                           11/03/2026 14:16:00 PAGE 17  

 973   2              if (pValue) {
 974   3                  limits = atol(pValue);
 975   3      
 976   3                  if (limits < 0 || limits > rtk_switch_maxLutAddrNumber_get())
 977   3                  {
 978   4                      printmsg(pReq, "Invalid Entry limits !!");
 979   4                      return SUCCESS;
 980   4                  }
 981   3              }
 982   2          }
 983   1      
 984   1          for (i = 0; i < settingCnt; ++i) {
 985   2      
 986   2              if (!(sal_trunk_logicId_exist(port[i]))) {
 987   3                  continue;
 988   3              }
 989   2              
 990   2              if (enable == DISABLE)
 991   2              {
 992   3                  limits = rtk_switch_maxLutAddrNumber_get();
 993   3              }
