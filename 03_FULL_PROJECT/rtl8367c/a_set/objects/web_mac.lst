 512   2              sal_flash_l2_sttcEntry_del(&mac, fid);
 513   2      #endif
 514   2          }        
 515   1                 
 516   1          while(pValue != NULL)
 517   1          {
 518   2              WEB_VAR(pReq, NULL, &pValue);
 519   2              if (pValue) {
 520   3                  strcpy(tmp, "");
 521   3                  sprintf(tmp, "%s", pValue);
 522   3                  strcpy(macStr, strtok (pValue, "_"));
 523   3                  fid = atoi(strstr(tmp, "_") + 1);
 524   3                  str_to_mac(mac.octet, macStr, 0);
 525   3                  if ((ret = sal_l2_entry_del(&mac, fid)) != SAL_ERR_SUCCESS)
 526   3                  {
 527   4                      printerr(pReq, ret);
 528   4                      return SUCCESS;
 529   4                  }
 530   3      #if SET_GET_FLASH
 531   3                  sal_flash_l2_sttcEntry_del(&mac, fid);
