 995   2              if ((ret = sal_l2_limitLearningCnt_set(port[i], limits)) != SAL_ERR_SUCCESS) 
 996   2              {
 997   3                  printerr(pReq, ret);
 998   3                  return SUCCESS;
 999   3              }
1000   2          }
1001   1      
1002   1              
1003   1          get_mac_constraint(pReq);
1004   1                  return SUCCESS;
1005   1              }
