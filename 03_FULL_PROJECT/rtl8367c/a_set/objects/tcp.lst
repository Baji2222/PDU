 865   1          DBG_LWPS_TCP_PRINTF(("%s():%d\n", __FILE__, (uint16)__LINE__));
 866   1      
 867   1          // This would typically be called from TCP input handler when RST is received
 868   1          // in ESTABLISHED state. For demonstration, we'll check current state transitions.
 869   1          for (i = 0; i < TCP_CONNECTION_MAX; i++)
 870   1          {
 871   2              if (tcp_pcb_entry[i].prev_state == TCP_STATE_ESTABLISHED &&
 872   2                  tcp_pcb_entry[i].state == TCP_STATE_CLOSED)
 873   2              {
 874   3                  count++;
 875   3                  DBG_LWPS_TCP_PRINTF(("%s():%d - Reset in former ESTABLISHED conn at PCB-ID %d\n", 
 876   3                      __FILE__, (uint16)__LINE__, (uint16)i));
 877   3              }
 878   2          }
 879   1      
 880   1          reset_counter += count;
 881   1          return reset_counter;
 882   1      }
 883          
 884          #endif /* end of LWPS_TCP */


