 190          
 191          void _counter_add(uint32 *pOrigH, uint32 *pOrigL, uint32 marginH, uint32 marginL)
 192          {        
 193   1          if (*pOrigL > (uint32)0xFFFFFFFF - marginL) // Overflow 
 194   1              *pOrigH += 1;
 195   1              
 196   1          *pOrigH += marginH;
 197   1          *pOrigL += marginL;
 198   1      }
 199          
 200          int32 _counter_sub(uint32 *pOrigH, uint32 *pOrigL, uint32 marginH, uint32 marginL)
 201          {
 202   1          if (*pOrigH < marginH || (*pOrigH == marginH && *pOrigL < marginL)) 
 203   1          {
 204   2              printf("Error in %s, %d\n", __FILE__, (uint16)__LINE__);
 205   2              return SAL_ERR_FAILED;
 206   2          }
 207   1      
 208   1          *pOrigH -= marginH;
 209   1          if (*pOrigL > marginL)
 210   1              *pOrigL  -= marginL;
 211   1          else
 212   1          {
 213   2              *pOrigH -= 1;
 214   2              *pOrigL = *pOrigL + ((uint32)0xffffffff - marginL + 1);
 215   2          }
 216   1      
 217   1          return SAL_ERR_SUCCESS;
 218   1      }
