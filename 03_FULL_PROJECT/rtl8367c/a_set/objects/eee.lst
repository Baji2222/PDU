  60          /* Function Name:
  61           *      rtk_eee_portEnable_set
  62           * Description:
  63           *      Set enable status of EEE function.
  64           * Input:
  65           *      port - port id.
  66           *      enable - enable EEE status.
  67           * Output:
  68           *      None
  69           * Return:
  70           *      RT_ERR_OK              - OK
  71           *      RT_ERR_FAILED          - Failed
  72           *      RT_ERR_SMI             - SMI access error
  73           *      RT_ERR_PORT_ID - Invalid port number.
  74           *      RT_ERR_ENABLE - Invalid enable input.
  75           * Note:
  76           *      This API can set EEE function to the specific port.
  77           *      The configuration of the port is as following:
  78           *      - DISABLE
  79           *      - ENABLE
  80           */
  81          rtk_api_ret_t rtk_eee_portEnable_set(rtk_port_t port, rtk_enable_t enable)
  82          {
  83   1          rtk_api_ret_t   retVal;
  84   1          uint32      regData;
  85   1          uint32    phy_port;
  86   1      
  87   1          /* Check initialization state */
  88   1          RTK_CHK_INIT_STATE();
  89   1      
  90   1          /* Check port is UTP port */
  91   1          RTK_CHK_PORT_IS_UTP(port);
  92   1      
  93   1          if (enable>=RTK_ENABLE_END)
  94   1              return RT_ERR_INPUT;
  95   1      
  96   1          phy_port = rtk_switch_port_L2P_get(port);
  97   1      
  98   1          if ((retVal = rtl8367c_setAsicEee100M(phy_port,enable))!=RT_ERR_OK)
  99   1              return retVal;
 100   1          if ((retVal = rtl8367c_setAsicEeeGiga(phy_port,enable))!=RT_ERR_OK)
 101   1              return retVal;
 102   1      
 103   1          if ((retVal = rtl8367c_setAsicPHYReg(phy_port, RTL8367C_PHY_PAGE_ADDRESS, 0))!=RT_ERR_OK)
 104   1              return retVal;
 105   1          if ((retVal = rtl8367c_getAsicPHYReg(phy_port, 0, &regData))!=RT_ERR_OK)
 106   1              return retVal;
 107   1          regData |= 0x0200;
 108   1          if ((retVal = rtl8367c_setAsicPHYReg(phy_port, 0, regData))!=RT_ERR_OK)
 109   1              return retVal;
 110   1      
 111   1          return RT_ERR_OK;
 112   1      }
