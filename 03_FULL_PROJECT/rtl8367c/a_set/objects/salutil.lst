 238          /* Convert MAC address from string to unsigned char array */
 239          unsigned long simple_strtoul(const char *cp,char **endp, unsigned int base)
 240          {
 241   1        unsigned long result = 0,value;
 242   1      
 243   1        if (*cp == '0') {
 244   2          cp++;
 245   2          if ((*cp == 'x') && isxdigit(cp[1])) {
 246   3            base = 16;
 247   3            cp++;
 248   3          }
 249   2          if (!base) {
 250   3            base = 8;
 251   3          }
 252   2        }
 253   1        if (!base) {
 254   2          base = 10;
 255   2        }
 256   1        while (isxdigit(*cp) && (value = isdigit(*cp) ? *cp-'0' : (islower(*cp)
 257   1            ? toupper(*cp) : *cp)-'A'+10) < base) {
 258   2          result = result*base + value;
 259   2          cp++;
 260   2        }
 261   1        if (endp)
 262   1          *endp = (char *)cp;
 263   1        return result;
 264   1      }
