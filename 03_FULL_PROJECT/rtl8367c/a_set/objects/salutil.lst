                  stkptr = 0;
              
                  lo = base;
                  hi = (int8 *) base + width * (num - 1);
              
                  recurse:
                  size = (hi - lo) / width + 1;
              
                  if (size <= CUTOFF)
                  {
                      shortsort(lo, hi, width, comp);
