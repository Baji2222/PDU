 203           * getnext -- get the next token
 204           *
 205           * Parameters:
 206           *   src: pointer to the start of the source string
 207           *   separater: the symbol used to separate the token
 208           *   dest: destination of the next token to be placed
 209           *
 210           * Returns:
 211           *   length of token (-1 when failed)
 212           */
 213          int
 214          getnext (
 215            char *  src,
 216            int separator,
 217            char *  dest
 218            )
 219          {
 220   1        char *  c;
 221   1        int len = 0;
 222   1      
 223   1        if ( (src == NULL) || (dest == NULL) ) {
 224   2          return -1;
 225   2        }
 226   1      
 227   1        c = strchr(src, separator);
 228   1        if (c == NULL) {
 229   2          strcpy(dest, src);
 230   2          return -1;
 231   2        }
 232   1        len = c - src;
 233   1        strncpy(dest, src, len);
 234   1        dest[len] = '\0';
 235   1        return len + 1;
 236   1      }
