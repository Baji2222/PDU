 108           */
 109          ret_t rtl8367c_getAsicCputagTrapPort(uint32 *pPort)
 110          {
 111   1          ret_t retVal;
C51 COMPILER V9.60.0.0   RTL8367C_ASICDRV_CPUTAG                                           11/03/2026 14:15:44 PAGE 3   

 112   1          uint32 tmpPort;
 113   1      
 114   1          retVal = rtl8367c_getAsicRegBits(RTL8367C_REG_CPU_CTRL, RTL8367C_CPU_TRAP_PORT_MASK, &tmpPort);
 115   1          if(retVal != RT_ERR_OK)
 116   1              return retVal;
 117   1          *pPort = tmpPort;
 118   1      
 119   1          retVal = rtl8367c_getAsicRegBits(RTL8367C_REG_CPU_CTRL, RTL8367C_CPU_TRAP_PORT_EXT_MASK, &tmpPort);
 120   1          if(retVal != RT_ERR_OK)
 121   1              return retVal;
 122   1          *pPort |= (tmpPort & 1) << 3;
 123   1      
 124   1          return RT_ERR_OK;
 125   1      }
