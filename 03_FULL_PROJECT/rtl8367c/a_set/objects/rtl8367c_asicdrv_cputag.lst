  63          /* Function Name:
  64           *      rtl8367c_setAsicCputagTrapPort
  65           * Description:
  66           *      Set cpu tag trap port
  67           * Input:
  68           *      port - port number
  69           * Output:
  70           *      None
  71           * Return:
  72           *      RT_ERR_OK       - Success
  73           *      RT_ERR_SMI      - SMI access error
  74           *      RT_ERR_PORT_ID  - Invalid port number
  75           * Note:
  76           *     API can set destination port of trapping frame
  77           */
  78          ret_t rtl8367c_setAsicCputagTrapPort(uint32 port)
  79          {
  80   1          ret_t retVal;
  81   1      
  82   1          if(port >= RTL8367C_PORTNO)
  83   1              return RT_ERR_PORT_ID;
  84   1      
  85   1          retVal = rtl8367c_setAsicRegBits(RTL8367C_REG_CPU_CTRL, RTL8367C_CPU_TRAP_PORT_MASK, port & 7);
  86   1          if(retVal != RT_ERR_OK)
  87   1              return retVal;
  88   1      
  89   1          retVal = rtl8367c_setAsicRegBits(RTL8367C_REG_CPU_CTRL, RTL8367C_CPU_TRAP_PORT_EXT_MASK, (port>>3) & 1
             -);
  90   1          if(retVal != RT_ERR_OK)
  91   1              return retVal;
  92   1      
  93   1          return RT_ERR_OK;
  94   1      }
  95          /* Function Name:
