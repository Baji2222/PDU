 180          /*
 181           * Function: calcDate
 182           * ------------------
 183           * Converts Unix timestamp to broken-down time structure.
 184           * Calculates seconds, minutes, hours, days, month, year, and day of week.
 185           * Handles leap years correctly for date calculations.
 186           */
 187          void calcDate(struct tm *tm, uint32 timestamp)
 188          {
 189   1        uint32 seconds, minutes, hours, days, year, month;
 190   1        uint32 dayOfWeek;
 191   1        static const uint8 daysInMonth[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
 192   1      
 193   1        seconds = timestamp - JAN_1970;
 194   1      //  seconds = 1549200462UL;
 195   1        /* calculate minutes */
 196   1        minutes  = seconds / 60;
 197   1        seconds -= minutes * 60;
 198   1        /* calculate hours */
 199   1        hours    = minutes / 60;
 200   1        minutes -= hours   * 60;
 201   1        /* calculate days */
 202   1        days     = hours   / 24;
 203   1        hours   -= days    * 24;
 204   1      
 205   1        /* Unix time starts in 1970 on a Thursday */
 206   1        year      = 1970;
 207   1        dayOfWeek = 4;
 208   1      
 209   1        while(1)
 210   1        {
 211   2          bool     leapYear   = (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0));
 212   2          uint16 daysInYear = leapYear ? 366 : 365;
 213   2          if (days >= daysInYear)
 214   2          {
 215   3            dayOfWeek += leapYear ? 2 : 1;
 216   3            days      -= daysInYear;
 217   3            if (dayOfWeek >= 7)
 218   3              dayOfWeek -= 7;
 219   3            ++year;
 220   3          }
 221   2          else
 222   2          {
 223   3            tm->tm_yday = days;
 224   3            dayOfWeek  += days;
 225   3            dayOfWeek  %= 7;
 226   3      
 227   3            /* calculate the month and day */
 228   3            for(month = 0; month < 12; ++month)
 229   3            {
 230   4              uint8 dim = daysInMonth[month];
 231   4      
 232   4              /* add a day to feburary if this is a leap year */
 233   4              if (month == 1 && leapYear)
 234   4                ++dim;
 235   4      
 236   4              if (days >= dim)
C51 COMPILER V9.60.0.0   SYSLOG                                                            11/03/2026 14:16:10 PAGE 5   

 237   4                days -= dim;
 238   4              else
 239   4                break;
 240   4            }
 241   3            break;
 242   3          }
 243   2        }
 244   1      
 245   1        tm->tm_sec  = seconds;
 246   1        tm->tm_min  = minutes;
 247   1        tm->tm_hour = hours;
 248   1        tm->tm_mday = days + 1;
 249   1        tm->tm_mon  = month;
 250   1        tm->tm_year = year;
 251   1        tm->tm_wday = dayOfWeek;
 252   1      
 253   1      }
