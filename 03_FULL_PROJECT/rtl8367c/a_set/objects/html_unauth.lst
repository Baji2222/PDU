  33          ";
  34          
  35          // Get Unauthorized: Sends HTTP 401 Unauthorized response to client
  36          // Displays authentication required page when user fails to provide valid credentials
  37          int8 get_unauth(struct http_request_s *pReq)
  38          {
  39   1      //  syslog_add_new_buf_entry(SYSLOG_MSG_LOGIN_FAILED, 0);
  40   1      
  41   1          WEB_BEGIN(pReq);
  42   1          WEB_STATUS(pReq, HTTP_STATUS_UNAUTHORIZED);
  43   1          WEB_HEADER(pReq, "WWW-Authenticate: Basic realm=\"Switch\"");
  44   1          WEB_DATA(pReq, htm_http_unauthorized, sizeof(htm_http_unauthorized) -1);
  45   1          WEB_END(pReq);
  46   1      
  47   1          return SUCCESS;
  48   1      }


