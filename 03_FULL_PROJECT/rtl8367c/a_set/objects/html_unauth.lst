  19          uint8 const far htm_http_unauthorized[] = "\
  20          <html><head>\n\
  21          <title>401 Authorization Required</title>\n\
  22          </head><body>\n\
  23          <h1>Authorization Required</h1>\n\
  24          <p>This server could not verify that you\n\
  25          are authorized to access the document\n\
  26          requested.  Either you supplied the wrong\n\
