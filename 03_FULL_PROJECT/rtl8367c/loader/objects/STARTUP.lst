                        190     
00000C 758100     F     191                     MOV     SP,#?STACK-1
                        192     
                        193     ; secondary stack initial position in 0x8000
00000F 75B900           194                     MOV     SSPL, #00H
000012 75BA80           195                     MOV     SSPH, #80H
                        196     
                        197     ; because the c_initseg is in bank 1
000015 759601           198                     MOV     CODE_BANK, #1   ;; should be consistent with image.lin
                        199     
000018 020000     E     200                     LJMP    ?C_START
                        201     
