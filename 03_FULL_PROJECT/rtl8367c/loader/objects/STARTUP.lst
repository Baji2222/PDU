------                  134                     RSEG    ?C_C51STARTUP
                        135     
000000                  136     STARTUP1:
                        137     
                        138     IF IDATALEN <> 0
000000 787F             139                     MOV     R0,#IDATALEN - 1
000002 E4               140                     CLR     A
000003 F6               141     IDATALOOP:      MOV     @R0,A
000004 D8FD             142                     DJNZ    R0,IDATALOOP
                        143     ENDIF
                        144     
                        145     IF XDATALEN <> 0
                                                MOV     DPTR,#XDATASTART
                                                MOV     R7,#LOW (XDATALEN)
                                  IF (LOW (XDATALEN)) <> 0
                                                MOV     R6,#(HIGH (XDATALEN)) +1
                                  ELSE
                                                MOV     R6,#HIGH (XDATALEN)
                                  ENDIF
                                                CLR     A
                                XDATALOOP:      MOVX    @DPTR,A
                                                INC     DPTR
                                                DJNZ    R7,XDATALOOP
                                                DJNZ    R6,XDATALOOP
                                ENDIF
                        159     
                        160     IF PPAGEENABLE <> 0
                                                MOV     PPAGE_SFR,#PPAGE
                                ENDIF
                        163     
                        164     IF PDATALEN <> 0
                                                MOV     R0,#LOW (PDATASTART)
                                                MOV     R7,#LOW (PDATALEN)
                                                CLR     A
                                PDATALOOP:      MOVX    @R0,A
                                                INC     R0
                                                DJNZ    R7,PDATALOOP
                                ENDIF
                        172     
                        173     IF IBPSTACK <> 0
                                EXTRN DATA (?C_IBP)
                                
                                                MOV     ?C_IBP,#LOW IBPSTACKTOP
                                ENDIF
                        178     
                        179     IF XBPSTACK <> 0
                        180     EXTRN DATA (?C_XBP)
                        181     
000006 750020     E     182                     MOV     ?C_XBP,#HIGH XBPSTACKTOP
000009 750000     E     183                     MOV     ?C_XBP+1,#LOW XBPSTACKTOP
                        184     ENDIF
                        185     
                        186     IF PBPSTACK <> 0
                                EXTRN DATA (?C_PBP)
                                                MOV     ?C_PBP,#LOW PBPSTACKTOP
                                ENDIF
