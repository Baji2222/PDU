                        124     
------                  125                     RSEG    ?STACK
000000                  126                     DS      1
                        127     
                        128                     EXTRN CODE (?C_START)
                        129                     PUBLIC  ?C_STARTUP
                        130     
000000                  131                     CSEG    AT      0
000000 020000     F     132     ?C_STARTUP:     LJMP    STARTUP1
