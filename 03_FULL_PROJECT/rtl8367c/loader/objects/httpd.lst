 543   2              return 0;   /* complete */
 544   2          }
 545   1          else if (iContentLength > ((pData + length) - (pBoundary + 4)))
 546   1          {
 547   2              DBG_LWPS_HTTP_PRINTF(("%s():%d - incomplete HTTP packet!\n", __FILE__, (uint16)__LINE__));
 548   2              return 1;   /* incomplete */
