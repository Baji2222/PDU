 482          /*  1: incomplete packet
 483           *  0: complete packet
 484           * -1: error packet
 485           */
 486          static int32 http_packet_check(httpd_client_t *pClient, uint8 *pData, uint32 length)
 487          {
 488   1          uint8 *pBoundary;
