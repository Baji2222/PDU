 501   2              return 1;   /* incomplete */
 502   2          }
 503   1      
 504   1          /* try to find `Content-Type` */
 505   1          if ((pContentType = strnstr(pData, "Content-Type: ", pBoundary - pData)) == NULL)
 506   1          {
 507   2              DBG_LWPS_HTTP_PRINTF(("%s():%d - complete HTTP packet (GOOD).\n", __FILE__, (uint16)__LINE__));
 508   2              return 0;   /* complete */
 509   2          }
 510   1          
 511   1          /* try to find `Content-Length` */
 512   1          if ((pContentLength = strnstr(pData, "Content-Length: ", pBoundary - pData)) == NULL)
 513   1          {
 514   2              DBG_LWPS_HTTP_PRINTF(("%s():%d - error packet!\n", __FILE__, (uint16)__LINE__));
 515   2              return -1;  /* error */
 516   2          }
 517   1      
 518   1          pContentLength += 16;   /* jump to digital position */
 519   1          iContentLength = 0;
 520   1          for (i=0; i<32; i++)
 521   1          {
 522   2              if (*(pContentLength + i) == '\r')
 523   2                  break;
 524   2      
 525   2              iContentLength *= 10;
 526   2              iContentLength += (*(pContentLength + i) - '0');
 527   2          }
 528   1          DBG_LWPS_HTTP_PRINTF(("%s():%d - pClient->ContentLength = %d\n", __FILE__, (uint16)__LINE__, iContentL
