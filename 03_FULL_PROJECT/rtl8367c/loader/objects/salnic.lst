  56           * Note:
  57           *      None
  58           */
  59          int32 sal_nic_rxPort_set(void *pBuf)
  60          {
  61   1          pktBuf_t *p;
  62   1      
  63   1          p = (pktBuf_t*)pBuf;
  64   1      
  65   1          if(p->pkt_cputag)
