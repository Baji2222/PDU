 335          void nic_rx_dsr(void){       
 336   1          uint16 xdata times = 0;
 337   1          int32  xdata ret;
 338   1          uint8  *u8_ptr;
 339   1                                   
 340   1          while( (times<CONFIG_MAX_RX_PER_INTR)            && \
 341   1                 (TRUE==hasRxPkt())                        && \
 342   1                 (SUCCESS==rxPkt(p_buffer, P_BUFFER_SIZE))    \
 343   1          )
 344   1          {
 345   2              u8_ptr            = p_buffer + TAG_SIZE;
 346   2              /* size is not include crc length */
 347   2              pktbuf.size       = (u8_ptr[6] << 8) | u8_ptr[7];
 348   2      //        pktbuf.size       =pktbuf.size;
 349   2              pktbuf.frame_info = u8_ptr;
 350   2              pktbuf.pkt_head   = pkt_head;
 351   2              pktbuf.l2         = pkt_head;
 352   2          
 353   2      
 354   2            if(eth_up(&pktbuf) == LWPS_ERR_L2_NDEF)
 355   2                handler_net_l2(&pktbuf);
 356   2              ret = lwps_event_handler();
 357   2              times++;
 358   2          }
 359   1          
 360   1      }
