              /*
               * printerr -- print an error message
               *
               * Parameters:
               *   errno: the error number
               */
              void
              printerr (
                  struct http_request_s *pReq,
                  unsigned short  errno
                  )
              {
                  WEB_BEGIN(pReq);
              
                  WEB_STATUS(pReq, HTTP_STATUS_OK);
                  WEB_HEADER(pReq, "Content-Type: text/html");
                  
                  WEB_PRINTF(pReq, "<html>\n");
