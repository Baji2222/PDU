               */
              int32 sal_sys_runtimeMode_set()
              {
                  rt_entry fp;
              
                  runtime_start_mode_set(START_MODE_WARM);
                  loader_start_mode_set(START_MODE_COLD);
                  loader_isr_set(FALSE);    
                  setReg(0x1336, 0x71);
                  fp = (rt_entry)(0);
                  fp();
              
