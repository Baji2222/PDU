 191          function CreateUniqueTagName( seed )\n\
 192          {\n\
 193              var tagName = seed;\n\
 194              var attempt = 0;\n\
 195              if( tagName == \"\" || tagName == null )\n\
 196                  tagName = \"x\";\n\
