                        380     ; THEORY OF OPERATION                                                         *
AX51 MACRO ASSEMBLER  L51_BANK                                                              08/20/25 22:07:53 PAGE     5

                        381     ; -------------------                                                         *
                        382     ; This section describes how the extended LX51 linker/locater manages the     *
                        383     ; extended address spaces that are addressed with the new C51 memory types    *
                        384     ; 'far' and 'far const'.  The C51 Compiler uses 3 byte pointer generic        *
                        385     ; pointer to access these memory areas.  'far' variables are placed in the    *
                        386     ; memory class HDATA and 'far const' variables get the memory class 'HCONST'. *
                        387     ; The LX51 linker/locater allows you to locate these memory classes in the    *
                        388     ; logical 16 MBYTE CODE or 16 MBYTE XDATA spaces.                             *
                        389     ;                                                                             *
                        390     ; The memory access itself is performed via eight different subroutines that  *
                        391     ; can be configured in this assembler module.  These routines are:            *
                        392     ;    ?C?CLDXPTR, ?C?CSTXPTR  ; load/store BYTE (char)  in extended memory     *
                        393     ;    ?C?ILDXPTR, ?C?ISTXPTR  ; load/store WORD (int)   in extended memory     *
                        394     ;    ?C?PLDXPTR, ?C?PSTXPTR  ; load/store 3-BYTE PTR   in extended memory     *
                        395     ;    ?C?LLDXPTR, ?C?LSTXPTR  ; load/store DWORD (long) in extended memory     *
                        396     ;                                                                             *
                        397     ; Each function gets as a parameter the memory address with 3 BYTE POINTER    *
                        398     ; representation in the CPU registers R1/R2/R3.  The register R3 holds the    *
                        399     ; memory type.  The C51 compiler uses the following memory types:             *
                        400     ;                                                                             *
                        401     ; R3 Value | Memory Type | Memory Class | Address Range                       *
                        402     ; -----------------------+--------------+--------------------------           *
                        403     ;    00    | data/idata  | DATA/IDATA   | I:0x00     .. I:0xFF                *
                        404     ;    01    | xdata       | XDATA        | X:0x0000   .. X:0xFFFF              *
                        405     ;  02..7F  | far         | HDATA        | X:0x010000 .. X:0x7E0000            *
                        406     ;  80..FD  | far const   | HCONST       | C:0x800000 .. C:0xFD0000 (see note) *
                        407     ;    FE    | pdata       | XDATA        | one 256-byte page in XDATA memory   *
                        408     ;    FF    | code        | CODE         | C:0x0000   .. C:0xFFFF              *
                        409     ;                                                                             *
                        410     ; Note: the far const memory area is mapped into the banked memory areas.     *
                        411     ;                                                                             *
                        412     ; The R3 values 00, 01, FE and FF are already handled within the C51 run-time *
                        413     ; library.  Only the values 02..FE are passed to the XPTR access functions    *
                        414     ; described below.  The AX51 macro assembler provides the MBYTE operator      *
                        415     ; that calculates the R3 value that needs to be passed to the XPTR access     *
                        416     ; function.   AX51 Assembler example for using XPTR access functions:         *
                        417     ;     MOV  R1,#LOW   (variable)   ; gives LSB address byte of variable        *
                        418     ;     MOV  R2,#HIGH  (variable)   ; gives MSB address byte of variable        *
                        419     ;     MOV  R3,#MBYTE (variable)   ; gives memory type byte of variable        *
                        420     ;     CALL ?C?CLDXPTR             ; load BYTE variable into A                 *
                        421     ;******************************************************************************
                        422     
                        423     PUBLIC ?C?CLDXPTR
                        424     PUBLIC ?C?CSTXPTR
                        425     PUBLIC ?C?ILDXPTR
                        426     PUBLIC ?C?ISTXPTR
                        427     PUBLIC ?C?PLDXPTR
                        428     PUBLIC ?C?PSTXPTR
                        429     PUBLIC ?C?LLDXPTR
                        430     PUBLIC ?C?LSTXPTR
                        431     
------                  432     ?C?LIB_CODE     SEGMENT CODE
------                  433                     RSEG    ?C?LIB_CODE
                        434     
                                ENDIF ; IF ?B_SSTACK = 0
                        472     
                        473     
                        474     IF ?B_SSTACK = 1
                        475         ; not support far-access for HDATA
                        476         ; CLDXPTR: Load   BYTE in A             via Address given in R1/R2/R3
000000                  477         ?C?CLDXPTR:
000000 C096             478                         PUSH    CODE_BANK
000002 EB               479                         MOV     A, R3
000003 14               480                         DEC     A
000004 543F             481                         ANL     A, #3FH
000006 F596             482                         MOV     CODE_BANK, A
