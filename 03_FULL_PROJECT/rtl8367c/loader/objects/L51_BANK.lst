00005B FF               548                         MOV     R7, A
AX51 MACRO ASSEMBLER  L51_BANK                                                              08/20/25 22:07:53 PAGE     7

00005C D096             549                         POP     CODE_BANK
00005E 22               550                         RET
                        551     
