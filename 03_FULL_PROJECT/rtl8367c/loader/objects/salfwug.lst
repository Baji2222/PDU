 183          int32 sal_fwug_image_write(uint8 *pBuf, uint16 length)
 184          {
 185   1          static uint8         write_enable, write_to_bank;
 186   1          uint16               truncateLength;
 187   1          static uint32        writeLen, writeStartAddr;
 188   1          runTimeImageHeader_t *hdrPtr;
 189   1      
 190   1          if(FALSE == header_get)
 191   1          {
 192   2              if(!check_header(pBuf))
 193   2              {
 194   3                  header_get = TRUE;
 195   3                  reboot_after_upload = TRUE;
 196   3                  fwug_status = SAL_FWUG_STATUS_TRANSMITTING;
 197   3              
 198   3                  /* image header correct */
 199   3                  write_enable = TRUE;
 200   3      
 201   3                  /* get image length */
 202   3                  hdrPtr = (runTimeImageHeader_t*)pBuf;
 203   3                  /* image length excluding header length */
 204   3                  image_length = hdrPtr->length - sizeof(runTimeImageHeader_t);
 205   3      
 206   3      
 207   3                  /* move pointer */ 
 208   3                  pBuf += sizeof(runTimeImageHeader_t);
 209   3                  length -= sizeof(runTimeImageHeader_t);
 210   3      
 211   3                  /* erase run time IROM section in flash */
 212   3                  FLASH_ERASE(RUN_TIME_IROM_START);
 213   3                  FLASH_ERASE(RUN_TIME_IROM_START + FLASH_BLOCK_SIZE);
 214   3                  FLASH_ERASE(RUN_TIME_IROM_START + FLASH_BLOCK_SIZE * 2);
 215   3      
 216   3                  /* initialize write address */
 217   3                  writeLen = 0;
 218   3      
 219   3                  write_to_bank = FALSE;
 220   3              }
 221   2              else
 222   2              {
 223   3                  /* image header error */
 224   3                  fwug_status = SAL_FWUG_STATUS_IMAGE_ERR;
 225   3                  reboot_after_upload = FALSE;
 226   3                  write_enable = FALSE;
 227   3                  return SAL_ERR_SUCCESS;            
 228   3              }
 229   2          }
 230   1      
 231   1          if(write_enable)
 232   1          {
 233   2              /* write buf to IROM section in flash */
 234   2              if(writeLen + length <= IMAGE_IROM_LEN)
 235   2              {
 236   3                  FLASH_WRITE(RUNTIME_IROM_IN_FLASH_ADDR + writeLen, pBuf, length);
 237   3                  writeLen += length;
C51 COMPILER V9.60.0.0   SALFWUG                                                           08/20/2025 22:07:56 PAGE 5   

 238   3              }
 239   2              else
 240   2              {
 241   3                  /* parts of buf need to be wirtten to IROM section,
 242   3                     and parts of buf need to be written to bank section */
 243   3                  if(write_to_bank == FALSE)
 244   3                  {
 245   4                      /* write front parts of buf to IROM section in flash */
 246   4                      truncateLength = IMAGE_IROM_LEN - writeLen;
 247   4                      FLASH_WRITE(RUNTIME_IROM_IN_FLASH_ADDR + writeLen, pBuf, truncateLength);
 248   4      
 249   4                      /* move pointer */
 250   4                      pBuf += truncateLength;
 251   4                      length -= truncateLength;
 252   4      
 253   4                      /* erase first block of run time bank area in flash */
 254   4                      FLASH_ERASE(RUN_TIME_BANK_START);
 255   4                      
 256   4                      /* write rear parts of buf to bank section */
 257   4                      FLASH_WRITE(RUNTIME_BANK_IN_FLASH_ADDR, pBuf, length);
 258   4                      writeLen  = IMAGE_IROM_LEN + length;
 259   4                      
 260   4                      write_to_bank = TRUE;
 261   4                  }
 262   3                  /* write all of buf to bank in flash */
 263   3                  else
 264   3                  {
 265   4                      writeStartAddr = writeLen + RUNTIME_BANK_IN_FLASH_ADDR - IMAGE_IROM_LEN;
 266   4      
 267   4                      /* if this block is not erased, erase current block */
 268   4                      if(FLASH_BLOCK_OFFSET(writeStartAddr) == 0)
 269   4                          FLASH_ERASE(writeStartAddr);
 270   4      
 271   4                      /* if data in buf cross block, erase next block */
 272   4                      /* erase should be block size aliged */                
 273   4                      if(FLASH_BLOCK_OFFSET(writeStartAddr) > FLASH_BLOCK_OFFSET(writeStartAddr + length))
 274   4                          FLASH_ERASE((writeStartAddr + length) & (~(FLASH_BLOCK_SIZE - 1)));
 275   4                  
 276   4                      FLASH_WRITE(writeLen + RUNTIME_BANK_IN_FLASH_ADDR - IMAGE_IROM_LEN, pBuf, length);
 277   4      
 278   4                      writeLen += length;
 279   4                 }
 280   3              }
 281   2          }
 282   1      
 283   1        return SAL_ERR_SUCCESS;
 284   1      }
