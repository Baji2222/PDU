              void speed_change_reset()
              {
                  uint16 tmp;
                  
                  //SDS page 0 reg 3 bit 6=1
                  setReg(0x6601,0x0003);
                  setReg(0x6600,0x0080);
                  tmp =getReg(0x6602);
                  tmp |= 1 << 6;    
                  setReg(0x6602,tmp);
                  setReg(0x6601,0x0003);
                  setReg(0x6600,0x00c0);
                  
                  //SDS page 0 reg 3 bit 6=0
                  setReg(0x6601,0x0003);
                  setReg(0x6600,0x0080);
                  tmp =getReg(0x6602);
                  tmp &= ~(1 << 6);    
                  setReg(0x6602,tmp);
                  setReg(0x6601,0x0003);
                  setReg(0x6600,0x00c0);
