 316   1          switch(tmp)
 317   1          {
 318   2          case DW8051_RDY_200MHz:
 319   2              system_clock = (200000UL * 1000);
 320   2              break;
 321   2          case DW8051_RDY_125MHz:
 322   2              system_clock = (125000UL * 1000);
