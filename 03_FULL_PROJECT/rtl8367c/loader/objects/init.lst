 638          void timer_init(void)
 639          {
 640   1          uint16 xdata tmp;
 641   1      
 642   1          current_time = JAN_1970;
 643   1          timeCount = 0;
 644   1      
 645   1          TMOD = 0x01;                /* enable timer 0 */
 646   1          tmp  = (uint16) (system_clock/(12*CONFIG_TIMER_DIVISOR));
 647   1          tmp  = 0xFFFF - tmp + 1;
 648   1          _th0 = (tmp>> 8)&0xFF;
 649   1          _tl0 = (tmp>> 0)&0xFF;
 650   1          TH0  = _th0;
 651   1          TL0  = _tl0;
 652   1      
 653   1          tmp += (0x0DU); /* magic number, for Software reload */
 654   1          _th0 = (tmp>> 8)&0xFF;
 655   1          _tl0 = (tmp>> 0)&0xFF;
 656   1      
 657   1          //OSAL_PRINTF("Divisor=0x%04x\n", tmp);
 658   1      
 659   1          TCON  = 0x10;                //enable timer0 and timer 1
 660   1          CKCON = CKCON & 0xC7;       //timer clock is system clock/12
 661   1      
 662   1          ET0   = 1;                    // enable timer0 interrupt
 663   1      }
