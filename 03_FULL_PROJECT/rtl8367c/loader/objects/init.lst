                tmp = this_mac[1] | (tmp << 8);
                  setReg(0x120B, tmp);
              
                  /* When queue number = 4, map priority 6 and priority 7 to queue 3 */
                  setReg(0x90b, 0x3322);
              
                  /* LED setting */
                  /* Parallel mode, group 0:speed1000/ACT, group 1:speed100(10)/ACT, group 2:off */
                  setReg(0x1b26, 3);
                  setReg(0x1B00, 0x14F4);
                setReg(0x1B03, 0x0096);
              }
              #endif
